Cell["GetADAS13dayCount", "Subsubsection",ExpressionUUID->"4f11a83f-0e15-4eb2-8168-138e7d3a5cc3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "GetADAS13dayCount", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"GetADAS13dayCount", "[", 
    RowBox[{
    "RID_", ",", "baseDate_", ",", "thresh_", ",", "selection_", ",", 
     RowBox[{"intervalP_", ":", "False"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "\t", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "\t", 
      RowBox[{
      "baseDateObj", ",", "cogTraj", ",", "cogFun", ",", "qualTraj", ",", 
       "days", ",", "interval", ",", "\[IndentingNewLine]", "\t", 
       RowBox[{"delta", "=", "0.1"}]}], "\[IndentingNewLine]", "\t", "}"}], 
     ",", "\[IndentingNewLine]", "\t", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"baseDateObj", "=", 
        RowBox[{"DateObject", "[", 
         RowBox[{"Map", "[", 
          RowBox[{"ToExpression", ",", 
           RowBox[{"StringSplit", "[", 
            RowBox[{"baseDate", ",", "\"\<-\>\""}], "]"}]}], "]"}], "]"}]}], 
       ";"}], "*)"}], "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{"baseDateObj", "=", 
       RowBox[{"MakeDateObj", "[", "baseDate", "]"}]}], ";", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"cogTraj", "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\"\<EXAMDATE\>\"", ",", "\"\<ADAS13\>\""}], "}"}], "/.", 
          RowBox[{
           RowBox[{"Normal", "[", 
            RowBox[{"cohorts", "[", "\"\<ADNImerge\>\"", "]"}], "]"}], "[", 
           "RID", "]"}]}], ",", 
         RowBox[{
          RowBox[{"NumberQ", "[", 
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}], "&"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"cogTraj", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", "\t\t\t", 
          RowBox[{
           RowBox[{"DayCount", "[", 
            RowBox[{"baseDateObj", ",", 
             RowBox[{"MakeDateObj", "[", 
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}], ",", 
           "\[IndentingNewLine]", "\t\t\t", 
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "\[IndentingNewLine]", "\t\t\t",
           "}"}], "&"}], "/@", "cogTraj"}]}], ";", "\[IndentingNewLine]", 
      "\t", 
      RowBox[{"cogFun", "=", 
       RowBox[{"Interpolation", "[", 
        RowBox[{"cogTraj", ",", 
         RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"cogTraj", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"#", ",", 
           RowBox[{"1.", 
            RowBox[{"cogFun", "[", "#", "]"}]}]}], "}"}], "&"}], "/@", 
        RowBox[{"Range", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"First", "[", "cogTraj", "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"Last", "[", "cogTraj", "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"qualTraj", "=", 
       RowBox[{"Select", "[", 
        RowBox[{"cogTraj", ",", 
         RowBox[{
          RowBox[{"Between", "[", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"thresh", "-", "delta"}], ",", 
              RowBox[{"thresh", "+", "delta"}]}], "}"}]}], "]"}], "&"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", "\t", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "qualTraj", "]"}], ">", "0"}], ",", 
        "\[IndentingNewLine]", "\t\t", 
        RowBox[{
         RowBox[{"days", "=", 
          RowBox[{"selection", "[", 
           RowBox[{
            RowBox[{"Transpose", "[", "qualTraj", "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", "\t\t", 
         RowBox[{"interval", "=", "days"}]}], ",", "\[IndentingNewLine]", 
        "\t\t", 
        RowBox[{
         RowBox[{"days", "=", 
          RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", "\t\t", 
         RowBox[{"interval", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"Last", "[", "cogTraj", "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}], "-", 
           RowBox[{
            RowBox[{"First", "[", "cogTraj", "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}]}]}]}]}], "\[IndentingNewLine]", 
       "\t\t", "]"}], ";", "\[IndentingNewLine]", "\t", 
      RowBox[{"If", "[", 
       RowBox[{"intervalP", ",", "\[IndentingNewLine]", "\t\t", 
        RowBox[{"{", 
         RowBox[{"interval", ",", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"NumberQ", "[", "days", "]"}], ",", "1", ",", "0"}], 
           "]"}]}], "}"}], ",", "\[IndentingNewLine]", "\t\t", "days"}], 
       "\[IndentingNewLine]", "\t\t", "]"}]}]}], "\[IndentingNewLine]", "\t", 
    "]"}]}], ";"}]}], "Input",
 CellLabel->"In[45]:=",ExpressionUUID->"8b61e6a7-30c9-49fd-b511-28bf7323e849"]
}, Closed]],

