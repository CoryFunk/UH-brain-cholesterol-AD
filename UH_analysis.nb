Cell["CCPraw", "Subsubsection",ExpressionUUID->"eb44ce48-2bf9-4709-80ab-03b061fe7c11"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CCPraw", "[", "scatterData_", "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "\t", 
    RowBox[{
     RowBox[{
     "{", "\[IndentingNewLine]", "\t", "matrixData", "\[IndentingNewLine]", 
      "\t", "}"}], ",", "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{"matrixData", "=", 
       RowBox[{"Drop", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
          "SpearmanRankTest", "[", "\[IndentingNewLine]", 
           "\t\t\t\t\t\t\t\t\t", 
           RowBox[{
            RowBox[{
             RowBox[{"Transpose", "[", "scatterData", "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", "\[IndentingNewLine]", 
            "\t\t\t\t\t\t\t\t\t", 
            RowBox[{
             RowBox[{"Transpose", "[", "scatterData", "]"}], "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", "\[IndentingNewLine]", 
            "\t\t\t\t\t\t\t\t\t", "\"\<TestDataTable\>\""}], 
           "\[IndentingNewLine]", "\t\t\t\t\t\t\t\t\t", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}], ",", "1"}], 
        "]"}]}], ";", "\[IndentingNewLine]", "\t", 
      RowBox[{"<|", "\[IndentingNewLine]", "\t", 
       RowBox[{
        RowBox[{"\"\<cc\>\"", "->", 
         RowBox[{"matrixData", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ",", "\[IndentingNewLine]", "\t", 
        
        RowBox[{"\"\<pval\>\"", "->", 
         RowBox[{"matrixData", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ",", "\[IndentingNewLine]", "\t", 
        
        RowBox[{"\"\<str\>\"", "->", 
         RowBox[{"\"\<cc \>\"", "<>", 
          RowBox[{"ToString", "[", 
           RowBox[{"matrixData", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], "<>", "\"\<   |   \>\"", "<>", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"matrixData", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "<", "0.001"}], ",", 
            RowBox[{"\"\<Log10[pval] \>\"", "<>", 
             RowBox[{"ToString", "[", 
              RowBox[{"Log10", "[", 
               RowBox[{"matrixData", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}]}], ",", 
            RowBox[{"\"\<pval \>\"", "<>", 
             RowBox[{"ToString", "[", 
              RowBox[{"matrixData", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "]"}]}]}], "]"}]}]}]}], 
       "\[IndentingNewLine]", "\t", "|>"}]}]}], "\[IndentingNewLine]", "\t", 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[44]:=",ExpressionUUID->"dc30de8a-acd9-4aa7-95ca-e93e2b2f46e3"]
}, Closed]],

