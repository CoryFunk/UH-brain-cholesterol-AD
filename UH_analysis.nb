Cell[CellGroupData[{

Cell["\<\
Derive SNP -> gene/protein lookup table used for labeling in some SNP - \
related functions\
\>", "Subsection",ExpressionUUID->"afb0fefd-1da7-4372-a6dc-70244c4a0114"],

Cell[BoxData[
 RowBox[{"SNPgene", "=", 
  RowBox[{"Association", "[", 
   RowBox[{"Flatten", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "->", "set"}], "&"}], "/@", 
        RowBox[{"SNPsets", "[", "set", "]"}]}], ")"}], ",", 
      RowBox[{"{", 
       RowBox[{"set", ",", 
        RowBox[{"Keys", "[", "SNPsets", "]"}]}], "}"}]}], "]"}], "]"}], 
   "]"}]}]], "Input",
 CellLabel->"In[81]:=",ExpressionUUID->"e863cd91-cca5-4136-b7d1-78e9d05b9069"]
}, Closed]],

