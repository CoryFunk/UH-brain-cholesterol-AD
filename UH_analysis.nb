Cell[CellGroupData[{

Cell["Post-load fixes: Sex query and SNP labels", "Subsection",ExpressionUUID->"e25e222a-f388-4986-89aa-4cfc53ce848d"],

Cell["\<\
(* Post-load fixes. Must run after querySpecs (Data structures) and after \
SNPgene is rebuilt from SNPsets (Load coreData),
   both of which overwrite the versions set in the SNPsig cell. PTGENDER \
holds the Symbols Male / Female, so the
   Sex query compares ToString of it; without this the F and M strata are \
empty (Supp Fig 4, Fig 5A). *)
querySpecs[\"Sex\"] = <|
  \"ALL\" -> (# &),
  \"F\"   -> (Select[#, ToString[#[\"PTGENDER\"]] == \"Female\" &] &),
  \"M\"   -> (Select[#, ToString[#[\"PTGENDER\"]] == \"Male\" &] &)|>;
SNPgene[\"rs3756963\"] = \"ELOVL2\"; SNPgene[\"rs2154481\"] = \"APP\";
Print[\"Sex query check (Q2 lipids): ALL/F/M = \",
  Length /@ (GetQuery[{\"Cog\" -> \"Q2\", \"Omics\" -> \"L\", \"Sex\" -> #}, \
coreData] & /@ {\"ALL\", \"F\", \"M\"})];\
\>", "Input",ExpressionUUID->"95397fbb-064c-4c83-89d8-1fa8c6e31c33"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

