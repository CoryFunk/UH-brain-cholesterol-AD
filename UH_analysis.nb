           RowBox[{"xTicks", ",", "None", ",", "None", ",", "yTicks"}], 
           "}"}]}], ",", "\[IndentingNewLine]", "\t\t\t", 
         RowBox[{"ImageSize", "\[Rule]", "800"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"ccArrayNoTicks", "=", 
       RowBox[{"ArrayPlot", "[", 
        RowBox[{"thisMtrx", ",", "\[IndentingNewLine]", "\t\t\t", 
         RowBox[{"ColorFunction", "\[Rule]", "colorFunction"}], ",", 
         "\[IndentingNewLine]", "\t\t\t", 
         RowBox[{"ColorFunctionScaling", "->", "False"}], ",", 
         "\[IndentingNewLine]", "\t\t\t", 
         RowBox[{"FrameTicks", "->", "None"}], ",", "\[IndentingNewLine]", 
         "\t\t\t", 
         RowBox[{"ImageSize", "\[Rule]", "800"}], ",", 
         RowBox[{"PlotRangePadding", "->", "None"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"<|", "\[IndentingNewLine]", "\t", 
       RowBox[{
        RowBox[{"\"\<mtrxFiltered\>\"", "->", "thisMtrx"}], ",", 
        "\[IndentingNewLine]", "\t", 
        RowBox[{"\"\<ccHist\>\"", "->", "ccHist"}], ",", 
        "\[IndentingNewLine]", "\t", 
        RowBox[{"\"\<ccArray\>\"", "->", "ccArray"}], ",", 
        "\[IndentingNewLine]", "\t", 
        RowBox[{"\"\<ccArrayNoTicks\>\"", "->", "ccArrayNoTicks"}]}], 
       "\[IndentingNewLine]", "\t", "|>"}]}]}], "\[IndentingNewLine]", "\t", 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[62]:=",ExpressionUUID->"86fd13a7-9633-4823-b4b0-f5467eccdde6"],

