Cell[BoxData[
 RowBox[{
  RowBox[{"GetClosestRecord", "[", 
   RowBox[{"date_", ",", "key_", ",", "records_", ",", "countKey_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", "\t", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{"targDate", "=", 
       RowBox[{"MakeDateObj", "[", "date", "]"}]}], ",", 
      "\[IndentingNewLine]", "\t", "recordsCopy"}], "\[IndentingNewLine]", 
     "\t", "}"}], ",", "\[IndentingNewLine]", "\t", 
    RowBox[{
     RowBox[{"recordsCopy", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Join", "[", 
         RowBox[{"#", ",", 
          RowBox[{"<|", 
           RowBox[{"countKey", "->", 
            RowBox[{"DayCount", "[", 
             RowBox[{"targDate", ",", 
              RowBox[{"MakeDateObj", "[", 
               RowBox[{"#", "[", "key", "]"}], "]"}]}], "]"}]}], "|>"}]}], 
         "]"}], "&"}], "/@", "records"}]}], ";", "\[IndentingNewLine]", "\t", 
     
     RowBox[{
      RowBox[{"SortBy", "[", 
       RowBox[{"recordsCopy", ",", 
        RowBox[{
         RowBox[{"#", "[", "countKey", "]"}], "&"}]}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}]}]}], "\[IndentingNewLine]", "\t", 
   "]"}]}]], "Input",
 CellLabel->"In[48]:=",ExpressionUUID->"a1b713c3-087f-4a07-8d36-64b006ba44a2"]
}, Closed]],

