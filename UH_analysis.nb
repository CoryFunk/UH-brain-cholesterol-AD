   RowBox[{"Module", "[", "\[IndentingNewLine]", "\t", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "\t", 
      RowBox[{
      "allData", ",", "legendData", ",", "plotStyle", ",", "barLegend", ",", 
       "frameLabel", ",", "plot", ",", "pairData", ",", "axisStats", ",", 
       "inset", ",", "estPlotRange", ",", "data1", ",", "data2", ",", "fit", 
       ",", "line", ",", "pval", ",", "gridLines", ",", "pvalStr", ",", 
       "\[IndentingNewLine]", "\t", "plot2"}], "\[IndentingNewLine]", "\t", 
      "}"}], ",", "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{"allData", "=", 
       RowBox[{"Select", "[", 
