Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "CohortComp", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"CohortComp", "[", 
    RowBox[{
    "cohorts_", ",", "data_", ",", "spec_", ",", "cols_", ",", "kspThresh_", 
     ",", "rotateQ_", ",", "labelRules_", ",", 
     RowBox[{"range_", ":", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "2"}], ",", "2"}], "}"}]}], ",", 
     RowBox[{"chartQ_", ":", "True"}], ",", 
     RowBox[{"sortQ_", ":", "True"}], ",", 
     RowBox[{"negs_", ":", 
      RowBox[{"{", "}"}]}], ",", 
     RowBox[{"normMeds_", ":", 
      RowBox[{"<|", "|>"}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "\t", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "\t", 
      RowBox[{
      "cohortKeys", ",", "cohortColors", ",", "colDataRaw", ",", 
       "cohortRankData", ",", "cohortKspData", ",", "rank", ",", "ksp", ",", 
       "cohortChartData", ",", "cohortData", ",", "normMed", ",", "normSD", 
       ",", "colKey", ",", "colData", ",", "normData", ",", 
       "\[IndentingNewLine]", "\t", "cohortChartDataExport", ",", 
       "cohortRankDataExport", ",", "cohortKspDataExport", ",", 
       "cohortNExport", ",", "kspStr", ",", "kspPrefix", ",", "rcData1", ",", 
       "rcData2", ",", "cohortChart", ",", "volcano", ",", "theseNormMeds"}], 
      "\[IndentingNewLine]", "\t", "}"}], ",", "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{"cohortKeys", "=", 
       RowBox[{"Keys", "[", "cohorts", "]"}]}], ";", "\[IndentingNewLine]", 
      "\t", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", 
          RowBox[{"Intersection", "[", 
           RowBox[{
            RowBox[{"Keys", "[", "quadColorExp", "]"}], ",", "cohortKeys"}], 
           "]"}], "]"}], ">", "0"}], ",", "\[IndentingNewLine]", "\t\t", 
        RowBox[{
         RowBox[{"cohortColors", "=", "cohorts"}], ";", "\[IndentingNewLine]",
          "\t\t", 
         RowBox[{"cohortData", "=", 
          RowBox[{"Association", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"#", "->", 
               RowBox[{"GetQuery", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"\"\<Dice\>\"", "->", "#"}], "}"}], ",", "data"}], 
                "]"}]}], ")"}], "&"}], "/@", "cohortKeys"}], "]"}]}]}], ",", 
        "\[IndentingNewLine]", "\t\t", 
        RowBox[{
         RowBox[{"cohortColors", "=", 
          RowBox[{"Association", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"#", "->", 
               RowBox[{"cohorts", "[", 
                RowBox[{"#", ",", "\"\<color\>\""}], "]"}]}], ")"}], "&"}], "/@",
             "cohortKeys"}], "]"}]}], ";", "\[IndentingNewLine]", "\t\t", 
         RowBox[{"cohortData", "=", 
          RowBox[{"Association", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"#", "->", 
               RowBox[{"GetQuery", "[", 
                RowBox[{
                 RowBox[{"cohorts", "[", 
                  RowBox[{"#", ",", "\"\<query\>\""}], "]"}], ",", "data"}], 
                "]"}]}], ")"}], "&"}], "/@", "cohortKeys"}], "]"}]}]}]}], 
       "\[IndentingNewLine]", "\t\t", "]"}], ";", "\[IndentingNewLine]", "\t", 
      RowBox[{"cohortRankData", "=", 
       RowBox[{"<|", "|>"}]}], ";", "\[IndentingNewLine]", "\t", 
      RowBox[{"cohortKspData", "=", 
       RowBox[{"<|", "|>"}]}], ";", "\[IndentingNewLine]", "\t", 
      RowBox[{"cohortKspDataExport", "=", 
       RowBox[{"<|", "|>"}]}], ";", "\[IndentingNewLine]", "\t", 
      RowBox[{"cohortRankDataExport", "=", 
       RowBox[{"<|", "|>"}]}], ";", "\[IndentingNewLine]", "\t", 
      RowBox[{"cohortChartDataExport", "=", 
       RowBox[{"<|", "|>"}]}], ";", "\[IndentingNewLine]", "\t", 
      RowBox[{"cohortNExport", "=", 
       RowBox[{"<|", "|>"}]}], ";", "\[IndentingNewLine]", "\t", 
      RowBox[{"volcano", "=", 
       RowBox[{"<|", "|>"}]}], ";", "\[IndentingNewLine]", "\t", 
      RowBox[{"theseNormMeds", "=", 
       RowBox[{"<|", "|>"}]}], ";", "\[IndentingNewLine]", "\t", 
      RowBox[{"cohortChartData", "=", 
       RowBox[{"Association", "[", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", "\t\t\t\t\t", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"Print", "[", "col", "]"}], ";"}], "*)"}], 
         "\[IndentingNewLine]", "\t\t\t\t\t", 
         RowBox[{
          RowBox[{
           RowBox[{"colDataRaw", "=", 
            RowBox[{"Association", "[", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"key", "->", 
                RowBox[{"Select", "[", 
                 RowBox[{
                  RowBox[{"Map", "[", 
                   RowBox[{"ToExpression", ",", 
                    RowBox[{"col", "/.", 
                    RowBox[{"cohortData", "[", "key", "]"}]}]}], "]"}], ",", 
                  RowBox[{
                   RowBox[{"NumberQ", "[", "#", "]"}], "&"}]}], "]"}]}], ",", 
               
               RowBox[{"{", 
                RowBox[{"key", ",", "cohortKeys"}], "}"}]}], "]"}], "]"}]}], 
           ";", "\[IndentingNewLine]", "\t\t\t\t\t", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{"Print", "[", "colDataRaw", "]"}], ";"}], "*)"}], 
           "\[IndentingNewLine]", "\t\t\t\t\t", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"MemberQ", "[", 
              RowBox[{"negs", ",", "col"}], "]"}], ",", "\[IndentingNewLine]",
              "\t\t\t\t\t\t", 
             RowBox[{"colDataRaw", "=", 
              RowBox[{"-", "colDataRaw"}]}]}], "\[IndentingNewLine]", 
            "\t\t\t\t\t\t", "]"}], ";", "\[IndentingNewLine]", "\t\t\t\t\t", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "[", 
               RowBox[{"Keys", "[", "normMeds", "]"}], "]"}], "==", "0"}], 
             ",", "\[IndentingNewLine]", "\t\t\t\t\t\t", 
             RowBox[{"normMed", "=", 
              RowBox[{"Median", "[", 
               RowBox[{"colDataRaw", "[", 
                RowBox[{"spec", "[", "\"\<norm\>\"", "]"}], "]"}], "]"}]}], 
             ",", "\[IndentingNewLine]", "\t\t\t\t\t\t", 
             RowBox[{"normMed", "=", 
              RowBox[{"normMeds", "[", "col", "]"}]}]}], 
            "\[IndentingNewLine]", "\t\t\t\t\t\t", "]"}], ";", 
           "\[IndentingNewLine]", "\t\t\t\t\t", 
           RowBox[{"AssociateTo", "[", 
            RowBox[{"theseNormMeds", ",", 
             RowBox[{"col", "->", "normMed"}]}], "]"}], ";", 
           "\[IndentingNewLine]", "\t\t\t\t\t", 
           RowBox[{"normData", "=", 
            RowBox[{"Association", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"#", "->", 
                RowBox[{"1.0", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"colDataRaw", "[", "#", "]"}], ")"}], "/", 
                  "normMed"}]}]}], "&"}], "/@", "cohortKeys"}], "]"}]}], ";", 
           "\[IndentingNewLine]", "\t\t\t\t\t", 
           RowBox[{"colData", "=", "normData"}], ";", "\[IndentingNewLine]", 
           "\t\t\t\t\t", 
           RowBox[{"rcData1", "=", 
            RowBox[{"Select", "[", 
             RowBox[{
              RowBox[{"normData", "[", 
               RowBox[{"spec", "[", "\"\<ref\>\"", "]"}], "]"}], ",", 
              RowBox[{
               RowBox[{"NumberQ", "[", "#", "]"}], "&"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", "\t\t\t\t\t", 
           RowBox[{"rcData2", "=", 
            RowBox[{"Select", "[", 
             RowBox[{
              RowBox[{"normData", "[", 
               RowBox[{"spec", "[", "\"\<comp\>\"", "]"}], "]"}], ",", 
              RowBox[{
               RowBox[{"NumberQ", "[", "#", "]"}], "&"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", "\t\t\t\t\t", 
           RowBox[{"rank", "=", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Median", "[", "rcData2", "]"}], "-", 
               RowBox[{"Median", "[", "rcData1", "]"}]}], ")"}], "/", 
             RowBox[{"(", 
              RowBox[{"0.5", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"StandardDeviation", "[", "rcData2", "]"}], "+", 
                 RowBox[{"StandardDeviation", "[", "rcData1", "]"}]}], 
                ")"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", "\t\t\t\t\t", 
           
           RowBox[{"rank", "=", 
            RowBox[{"Abs", "[", "rank", "]"}]}], ";", "\[IndentingNewLine]", 
           "\t\t\t\t\t", 
           RowBox[{"ksp", "=", 
            RowBox[{"KolmogorovSmirnovTest", "[", 
             RowBox[{"rcData1", ",", "rcData2"}], "]"}]}], ";", 
           "\[IndentingNewLine]", "\t\t\t\t\t", 
           RowBox[{"AssociateTo", "[", 
            RowBox[{"volcano", ",", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"col", "/.", "labelRules"}], ")"}], "->", 
              RowBox[{
              "{", "\[IndentingNewLine]", "\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t", 
               RowBox[{
                RowBox[{"Log2", "[", 
                 RowBox[{
                  RowBox[{"Mean", "[", 
                   RowBox[{"colDataRaw", "[", 
                    RowBox[{"spec", "[", "\"\<comp\>\"", "]"}], "]"}], "]"}], 
                  "/", 
                  RowBox[{"Mean", "[", 
                   RowBox[{"colDataRaw", "[", 
                    RowBox[{"spec", "[", "\"\<ref\>\"", "]"}], "]"}], "]"}]}],
                  "]"}], ",", "\[IndentingNewLine]", 
                "\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t", 
                RowBox[{"-", 
                 RowBox[{"Log10", "[", "ksp", "]"}]}]}], 
               "\[IndentingNewLine]", "\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t", 
               "}"}]}]}], "]"}], ";", "\[IndentingNewLine]", "\t\t\t\t\t", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"ksp", "<", "0.0001"}], ",", "\[IndentingNewLine]", 
             "\t\t\t\t\t\t", 
             RowBox[{
              RowBox[{"kspStr", "=", 
               RowBox[{"ToString", "[", 
                RowBox[{"Round", "[", 
                 RowBox[{
                  RowBox[{"Log10", "[", "ksp", "]"}], ",", "0.1"}], "]"}], 
                "]"}]}], ";", "\[IndentingNewLine]", "\t\t\t\t\t\t", 
              RowBox[{"kspPrefix", "=", "\"\<pval 1.E^\>\""}]}], ",", 
             "\[IndentingNewLine]", "\t\t\t\t\t\t", 
             RowBox[{
              RowBox[{"kspStr", "=", 
               RowBox[{"ToString", "[", 
                RowBox[{"Round", "[", 
                 RowBox[{"ksp", ",", "0.0001"}], "]"}], "]"}]}], ";", 
              "\[IndentingNewLine]", "\t\t\t\t\t\t", 
              RowBox[{"kspPrefix", "=", "\"\<pval \>\""}]}]}], 
            "\[IndentingNewLine]", "\t\t\t\t\t\t", "]"}], ";", 
           "\[IndentingNewLine]", "\t\t\t\t\t", 
           RowBox[{"If", "[", 
            RowBox[{"showKspQ", ",", "\[IndentingNewLine]", "\t\t\t\t\t\t", 
             RowBox[{"colKey", "=", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"col", "/.", "labelRules"}], ")"}], "<>", 
               "\"\<\\n\>\"", "<>", "kspPrefix", "<>", "kspStr"}]}], ",", 
             "\[IndentingNewLine]", "\t\t\t\t\t\t", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{"\"\<n={\>\"", "<>", 
                RowBox[{"ToString", "[", 
                 RowBox[{"Length", "[", "rcData1", "]"}], "]"}], "<>", 
                "\"\<,\>\"", "<>", 
                RowBox[{"ToString", "[", 
                 RowBox[{"Length", "[", "rcData2", "]"}], "]"}], "<>", 
                "\"\<}\>\""}], "]"}], ";", "\[IndentingNewLine]", 
              "\t\t\t\t\t\t", 
              RowBox[{"Print", "[", 
               RowBox[{"\"\<pval={\>\"", "<>", 
                RowBox[{"ToString", "[", "ksp", "]"}], "<>", "\"\<}\>\""}], 
               "]"}], ";", "\[IndentingNewLine]", "\t\t\t\t\t\t", 
              RowBox[{"colKey", "=", 
               RowBox[{"(", 
                RowBox[{"col", "/.", "labelRules"}], ")"}]}]}]}], 
            "\[IndentingNewLine]", "\t\t\t\t\t", "]"}], ";", 
           "\[IndentingNewLine]", "\t\t\t\t\t", 
           RowBox[{"colKey", "=", 
            RowBox[{"If", "[", 
             RowBox[{"rotateQ", ",", 
              RowBox[{"Rotate", "[", 
               RowBox[{"colKey", ",", 
                RowBox[{
                 RowBox[{"-", "Pi"}], "/", "2"}]}], "]"}], ",", "colKey"}], 
             "]"}]}], ";", "\[IndentingNewLine]", "\t\t\t\t\t", 
           RowBox[{"AssociateTo", "[", 
            RowBox[{"cohortRankData", ",", 
             RowBox[{"colKey", "->", "rank"}]}], "]"}], ";", 
           "\[IndentingNewLine]", "\t\t\t\t\t", 
           RowBox[{"AssociateTo", "[", 
            RowBox[{"cohortKspData", ",", 
             RowBox[{"colKey", "->", "ksp"}]}], "]"}], ";", 
           "\[IndentingNewLine]", "\t\t\t\t\t", 
           RowBox[{"AssociateTo", "[", 
            RowBox[{"cohortChartDataExport", ",", 
             RowBox[{"col", "->", "colData"}]}], "]"}], ";", 
           "\[IndentingNewLine]", "\t\t\t\t\t", 
           RowBox[{"AssociateTo", "[", 
            RowBox[{"cohortRankDataExport", ",", 
             RowBox[{"col", "->", "rank"}]}], "]"}], ";", 
           "\[IndentingNewLine]", "\t\t\t\t\t", 
           RowBox[{"AssociateTo", "[", 
            RowBox[{"cohortKspDataExport", ",", 
             RowBox[{"col", "->", "ksp"}]}], "]"}], ";", 
           "\[IndentingNewLine]", "\t\t\t\t\t", 
           RowBox[{"AssociateTo", "[", 
            RowBox[{"cohortNExport", ",", 
             RowBox[{"col", "->", 
              RowBox[{"Association", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"#", "->", 
                  RowBox[{"Length", "[", 
                   RowBox[{"cohortData", "[", "#", "]"}], "]"}]}], "&"}], "/@",
                 "cohortKeys"}], "]"}]}]}], "]"}], ";", "\[IndentingNewLine]",
            "\t\t\t\t\t", 
           RowBox[{"colKey", "->", 
            RowBox[{"KeyMap", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{
                 RowBox[{"If", "[", 
                  RowBox[{"rotateQ", ",", 
                   RowBox[{"Rotate", "[", 
                    RowBox[{"#", ",", 
                    RowBox[{
                    RowBox[{"-", "Pi"}], "/", "2"}]}], "]"}], ",", "#"}], 
                  "]"}], ",", "LightGray"}], "]"}], "&"}], ",", "colData"}], 
             "]"}]}]}], ",", "\[IndentingNewLine]", "\t\t\t\t\t", 
          RowBox[{"{", 
           RowBox[{"col", ",", 
            RowBox[{"Take", "[", 
             RowBox[{"cols", ",", "All"}], "]"}]}], "}"}]}], 
         "\[IndentingNewLine]", "\t\t\t\t\t", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"cohortChartData", "=", 
       RowBox[{"Association", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "->", 
           RowBox[{"cohortChartData", "[", "#", "]"}]}], "&"}], "/@", 
         RowBox[{"Keys", "[", 
          RowBox[{"If", "[", 
           RowBox[{
           "sortQ", ",", "\[IndentingNewLine]", 
            "\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t", 
            RowBox[{"Sort", "[", 
             RowBox[{"Select", "[", 
              RowBox[{"cohortKspData", ",", 
               RowBox[{
                RowBox[{"#", "<", "kspThresh"}], "&"}]}], "]"}], "]"}], ",", 
            "\[IndentingNewLine]", "\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t", 
            RowBox[{"Select", "[", 
             RowBox[{"cohortKspData", ",", 
              RowBox[{
               RowBox[{"#", "<", "kspThresh"}], "&"}]}], "]"}]}], 
           "\[IndentingNewLine]", "\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t", "]"}], 
          "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", "\t", 
      RowBox[{"cohortChartData", "=", 
       RowBox[{"KeyMap", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"#", ",", "Bold"}], "]"}], "&"}], ",", "cohortChartData"}],
         "]"}]}], ";", "\[IndentingNewLine]", "\t", 
      RowBox[{"cohortChart", "=", 
       RowBox[{"If", "[", 
        RowBox[{"chartQ", ",", 
         RowBox[{"BoxWhiskerChart", "[", 
          RowBox[{"cohortChartData", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"\"\<Whiskers\>\"", ",", "LightGray"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"\"\<Fences\>\"", ",", "0.5", ",", "LightGray"}], 
              "}"}]}], "}"}], ",", "\[IndentingNewLine]", "\t\t\t\t\t\t\t", 
           RowBox[{"ChartLabels", "->", "Automatic"}], ",", 
           RowBox[{"ImageSize", "->", 
            RowBox[{"{", 
             RowBox[{"Automatic", ",", "350"}], "}"}]}], ",", 
           RowBox[{"AspectRatio", "->", "Automatic"}], ",", 
           RowBox[{"PlotRangePadding", "->", "0"}], ",", 
           "\[IndentingNewLine]", "\t\t\t\t\t\t\t", 
           RowBox[{"GridLines", "->", 
            RowBox[{"{", 
             RowBox[{"None", ",", 
              RowBox[{"{", "1.0", "}"}]}], "}"}]}], ",", 
           RowBox[{"GridLinesStyle", "->", 
            RowBox[{"Directive", "[", 
             RowBox[{"Dashed", ",", "Gray"}], "]"}]}], ",", 
           "\[IndentingNewLine]", "\t\t\t\t\t\t\t", 
           RowBox[{"BarSpacing", "->", 
            RowBox[{"{", 
             RowBox[{"0.1", ",", "0.75"}], "}"}]}], ",", 
           RowBox[{"PlotRange", "->", "range"}], ",", 
           RowBox[{"ChartStyle", "->", 
            RowBox[{"(", 
             RowBox[{"cohortKeys", "/.", "cohortColors"}], ")"}]}], ",", 
           "\[IndentingNewLine]", "\t\t\t\t\t\t\t", 
           RowBox[{"Ticks", "->", 
            RowBox[{"{", 
             RowBox[{"None", ",", 
              RowBox[{"Range", "[", 
               RowBox[{
                RowBox[{"range", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
                RowBox[{"range", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], ",", "1"}], "]"}]}], "}"}]}],
            ",", "\[IndentingNewLine]", "\t\t\t\t\t\t\t", 
           RowBox[{"ChartLegends", "->", 
            RowBox[{"Placed", "[", 
             RowBox[{"cohortKeys", ",", "Right"}], "]"}]}], ",", 
           "\[IndentingNewLine]", "\t\t\t\t\t\t\t", 
           RowBox[{"FrameLabel", "->", 
            RowBox[{"{", 
             RowBox[{"None", ",", 
              RowBox[{"\"\<Data Normalized to Median[\>\"", "<>", 
               RowBox[{"spec", "[", "\"\<ref\>\"", "]"}], "<>", 
               "\"\<]\>\""}]}], "}"}]}], ",", "\[IndentingNewLine]", 
           "\t\t\t\t\t\t\t", 
           RowBox[{"PlotLabel", "->", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"spec", "[", "\"\<prefix\>\"", "]"}], ",", 
              RowBox[{"FontSize", "->", "14"}], ",", "Bold"}], "]"}]}]}], 
          "\[IndentingNewLine]", "\t\t\t\t\t\t\t", "]"}], ",", 
         RowBox[{"{", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", "\t", 
      RowBox[{"<|", "\[IndentingNewLine]", "\t\t", 
       RowBox[{
        RowBox[{"\"\<chart\>\"", "->", "cohortChart"}], ",", 
        "\[IndentingNewLine]", "\t\t", 
        RowBox[{"\"\<data\>\"", "->", "cohortChartDataExport"}], ",", 
        "\[IndentingNewLine]", "\t\t", 
        RowBox[{"\"\<rank\>\"", "->", "cohortRankDataExport"}], ",", 
        "\[IndentingNewLine]", "\t\t", 
        RowBox[{"\"\<ksp\>\"", "->", "cohortKspDataExport"}], ",", 
        "\[IndentingNewLine]", "\t\t", 
        RowBox[{"\"\<n\>\"", "->", "cohortNExport"}], ",", 
        "\[IndentingNewLine]", "\t\t", 
        RowBox[{"\"\<volcano\>\"", "->", "volcano"}], ",", 
        "\[IndentingNewLine]", "\t\t", 
        RowBox[{"\"\<normMeds\>\"", "->", "theseNormMeds"}]}], 
       "\[IndentingNewLine]", "\t\t", "|>"}]}]}], "\[IndentingNewLine]", "\t",
     "]"}]}], ";"}]}], "Input",
 CellLabel->"In[49]:=",ExpressionUUID->"b223a009-af82-49d1-af74-59a4ef8ef46c"]
}, Closed]],

Cell[CellGroupData[{

Cell["GetQuery", "Subsubsection",ExpressionUUID->"82e008c8-0d5a-44e7-9a5d-a76b524bad3b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"GetQuery", "[", 
   RowBox[{"query_", ",", "data_"}], "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Length", "[", "query", "]"}], "==", "1"}], ",", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"querySpecs", "@@", 
       RowBox[{"First", "[", "query", "]"}]}], ")"}], "[", "data", "]"}], ",", 
    RowBox[{"GetQuery", "[", 
     RowBox[{
      RowBox[{"Drop", "[", 
       RowBox[{"query", ",", "1"}], "]"}], ",", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"querySpecs", "@@", 
         RowBox[{"First", "[", "query", "]"}]}], ")"}], "[", "data", "]"}]}], 
     "]"}]}], "]"}]}]], "Input",
 CellLabel->"In[51]:=",ExpressionUUID->"87fd5c08-36a6-461e-a812-94e561939dc3"]
}, Closed]],

Cell[CellGroupData[{

Cell["DiceConfig", "Subsubsection",ExpressionUUID->"8e108f4b-ec0c-478b-b1a2-192a93cc1cfe"],

Cell["\<\
Threshold behaviour, both branches. DiceConfig takes either a 3-element axes \
spec (e.g. {\"Q3\",\"4\",\"7\"}), which builds the FPC column names Q3P4L7_P \
and Q3P4L7_L, or a 2-element spec naming two columns directly (e.g. \
{\"LDHB\",\"CER.D19.1.18.0.\"}). The two branches threshold differently, and \
the difference is easy to miss because the Median assignment sits in the else \
arm of If[Length[axes]==3, gridLines=None, ...].\
\>", "Item",ExpressionUUID->"655f2620-85da-4af2-beb1-8df6548b9858"],

Cell["\<\
3-element (FPC) branch -- used by Figures 2b/2d/2e and 3a/3b/3c/3d/3f: \
thresholds stay at 0. FPC scores are centred, so 0 is the natural split, but \
it is NOT the median, and the four quadrants are deliberately unequal (Q3 \
P4xL7 gives TL 48, TR 15, BL 49, BR 44). Verified: at threshold 0, BR vs TL \
on the Q3 astrogliosis scheme reproduces the published Figure 3b values -- \
TAU median +55% and hippocampal atrophy rate +89% (paper: +55%, +92%). At \
median thresholds the same quantities give +79% and +112%, matching nothing \
in the paper.\
\>", "Item",ExpressionUUID->"0c040012-9d55-40ac-b854-151207f493a3"],

Cell[CellGroupData[{

Cell["\<\
2-element (named-column) branch -- used by the Figure 4 LDHB/CER.D19 \
quadrants: thresholds ARE medians, from diceCoords. Note the order \
dependence: diceData is built from diceSpec[\"query\"] BEFORE diceSpec is \
reassigned, so the medians come from whichever cohort the PREVIOUS DiceConfig \
call configured. A Q2 configuration run straight after a Q3 one splits Q2 on \
Q3's medians (CER.D19 4.37 instead of the true Q2 median 3.809). Because cell \
order is therefore semantically significant in this notebook, functions added \
below call DiceConfig themselves rather than relying on ambient state.\
\>", "Item",ExpressionUUID->"0422604f-98e3-4ed3-8329-f23bb8a0f59c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"DiceConfig", "[", 
    RowBox[{"query_", ",", "axes_"}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "\t", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "\t", 
      RowBox[{
      "xCol", ",", "yCol", ",", "xClusterLabel", ",", "yClusterLabel", ",", 
       "plotLabel", ",", "diceData", ",", "diceCoords", ",", "plotData", ",", 
       "gridLines"}], "\[IndentingNewLine]", "\t", "}"}], ",", 
     "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{"diceData", "=", 
       RowBox[{"GetQuery", "[", 
        RowBox[{
         RowBox[{"diceSpec", "[", "\"\<query\>\"", "]"}], ",", "coreData"}], 
        "]"}]}], ";", "\[IndentingNewLine]", "\t", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "axes", "]"}], "==", "3"}], ",", 
        "\[IndentingNewLine]", "\t\t", 
        RowBox[{
         RowBox[{"xCol", "=", 
          RowBox[{
           RowBox[{"axes", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "<>", "\"\<P\>\"", "<>", 
           RowBox[{"ToString", "[", 
            RowBox[{"axes", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "]"}], "<>", "\"\<L\>\"", "<>", 
           RowBox[{"ToString", "[", 
            RowBox[{"axes", "[", 
             RowBox[{"[", "3", "]"}], "]"}], "]"}], "<>", "\"\<_P\>\""}]}], 
         ";", "\[IndentingNewLine]", "\t\t", 
         RowBox[{"yCol", "=", 
          RowBox[{
           RowBox[{"axes", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "<>", "\"\<P\>\"", "<>", 
           RowBox[{"ToString", "[", 
            RowBox[{"axes", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "]"}], "<>", "\"\<L\>\"", "<>", 
           RowBox[{"ToString", "[", 
            RowBox[{"axes", "[", 
             RowBox[{"[", "3", "]"}], "]"}], "]"}], "<>", "\"\<_L\>\""}]}], 
         ";", "\[IndentingNewLine]", "\t\t", 
         RowBox[{"Print", "[", "xCol", "]"}], ";", "\[IndentingNewLine]", 
         "\t\t", 
         RowBox[{"Print", "[", "yCol", "]"}], ";", "\[IndentingNewLine]", 
         "\t\t", 
         RowBox[{"xClusterLabel", "=", 
          RowBox[{
           RowBox[{"proteinClusterLabels", "[", 
            RowBox[{"[", 
             RowBox[{"ToExpression", "[", 
              RowBox[{"axes", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}], "]"}], "<>", 
           "\"\< FPC\>\""}]}], ";", "\[IndentingNewLine]", "\t\t", 
         RowBox[{"yClusterLabel", "=", 
          RowBox[{
           RowBox[{"lipidClusterLabels", "[", 
            RowBox[{"[", 
             RowBox[{"ToExpression", "[", 
              RowBox[{"axes", "[", 
               RowBox[{"[", "3", "]"}], "]"}], "]"}], "]"}], "]"}], "<>", 
           "\"\< FPC\>\""}]}], ";", "\[IndentingNewLine]", "\t\t", 
         RowBox[{"plotLabel", "=", 
          RowBox[{"\"\<ADNI ADAS13 \>\"", "<>", 
           RowBox[{"axes", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "<>", "\"\< (\>\"", "<>", 
           RowBox[{"ToString", "[", 
            RowBox[{"Length", "[", "diceData", "]"}], "]"}], "<>", 
           "\"\< Subjects)\>\""}]}], ";", "\[IndentingNewLine]", "\t\t", 
         RowBox[{"diceSpec", "=", 
          RowBox[{"<|", "\[IndentingNewLine]", "\t\t", 
           RowBox[{
            RowBox[{"\"\<query\>\"", "->", "query"}], ",", 
            "\[IndentingNewLine]", "\t\t", 
            RowBox[{"\"\<plotRange\>\"", "->", 
             RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", "\t\t", 
            RowBox[{"\"\<X\>\"", "->", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<col\>\"", "->", "xCol"}], ",", 
               RowBox[{"\"\<thresh\>\"", "->", "0"}]}], "|>"}]}], ",", 
            "\[IndentingNewLine]", "\t\t", 
            RowBox[{"\"\<Y\>\"", "->", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<col\>\"", "->", "yCol"}], ",", 
               RowBox[{"\"\<thresh\>\"", "->", "0"}]}], "|>"}]}]}], 
           "\[IndentingNewLine]", "\t\t", "|>"}]}]}], ",", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", "\t\t", 
        RowBox[{
         RowBox[{"xCol", "=", 
          RowBox[{"axes", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         "\t\t", 
         RowBox[{"yCol", "=", 
          RowBox[{"axes", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         "\t\t", 
         RowBox[{"xClusterLabel", "=", "xCol"}], ";", "\[IndentingNewLine]", 
         "\t\t", 
         RowBox[{"yClusterLabel", "=", "yCol"}], ";", "\[IndentingNewLine]", 
         "\t\t", 
         RowBox[{"plotLabel", "=", 
          RowBox[{"\"\<ADNI ADAS13 Q2 (\>\"", "<>", 
           RowBox[{"ToString", "[", 
            RowBox[{"Length", "[", "diceData", "]"}], "]"}], "<>", 
           "\"\< Subjects)\>\""}]}], ";", "\[IndentingNewLine]", "\t\t", 
         RowBox[{"diceSpec", "=", 
          RowBox[{"<|", "\[IndentingNewLine]", "\t\t", 
           RowBox[{
            RowBox[{"\"\<query\>\"", "->", "query"}], ",", 
            "\[IndentingNewLine]", "\t\t", 
            RowBox[{"\"\<plotRange\>\"", "->", 
             RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", "\t\t", 
            RowBox[{"\"\<X\>\"", "->", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<col\>\"", "->", "xCol"}], ",", 
               RowBox[{"\"\<thresh\>\"", "->", 
                RowBox[{"Median", "[", 
                 RowBox[{"Select", "[", 
                  RowBox[{
                   RowBox[{"xCol", "/.", "diceData"}], ",", "NumberQ"}], 
                  "]"}], "]"}]}]}], "|>"}]}], ",", "\[IndentingNewLine]", 
            "\t\t", 
            RowBox[{"\"\<Y\>\"", "->", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<col\>\"", "->", "yCol"}], ",", 
               RowBox[{"\"\<thresh\>\"", "->", 
                RowBox[{"Median", "[", 
                 RowBox[{"Select", "[", 
                  RowBox[{
                   RowBox[{"yCol", "/.", "diceData"}], ",", "NumberQ"}], 
                  "]"}], "]"}]}]}], "|>"}]}]}], "\[IndentingNewLine]", "\t\t",
            "|>"}]}]}]}], "\[IndentingNewLine]", "\t\t", "]"}], ";", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"diceCoords", "=", 
       RowBox[{"Transpose", "[", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"diceSpec", "[", 
              RowBox[{"\"\<X\>\"", ",", "\"\<col\>\""}], "]"}], ",", 
             RowBox[{"diceSpec", "[", 
              RowBox[{"\"\<Y\>\"", ",", "\"\<col\>\""}], "]"}]}], "}"}], "/.",
            "diceData"}], ",", 
          RowBox[{
           RowBox[{"And", "@@", 
            RowBox[{"Map", "[", 
             RowBox[{"NumberQ", ",", "#"}], "]"}]}], "&"}]}], "]"}], "]"}]}], 
      ";", "\[IndentingNewLine]", "\t", 
      RowBox[{
       RowBox[{"diceSpec", "[", "\"\<plotRange\>\"", "]"}], "=", 
       RowBox[{"Map", "[", 
        RowBox[{"MinMax", ",", "diceCoords"}], "]"}]}], ";", 
