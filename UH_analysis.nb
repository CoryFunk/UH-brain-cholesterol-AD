Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"DCogKMprep", "[", 
    RowBox[{"RIDs_", ",", "dCog_", ",", "group_"}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
      "baseDate", ",", "lastDate", ",", "obs", ",", "baseCog", ",", "y"}], 
      "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"yrs", "=", 
       RowBox[{"Table", "[", "\[IndentingNewLine]", "\t\t", 
        RowBox[{
         RowBox[{
          RowBox[{"baseDate", "=", 
           RowBox[{"First", "[", 
            RowBox[{"\"\<EXAMDATE\>\"", "/.", 
             RowBox[{
              RowBox[{"Normal", "[", 
               RowBox[{"cohorts", "[", "\"\<ADNImerge\>\"", "]"}], "]"}], "[",
               "rid", "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", "\t\t", 
          RowBox[{"lastDate", "=", 
           RowBox[{"Last", "[", 
            RowBox[{"\"\<EXAMDATE\>\"", "/.", 
             RowBox[{
              RowBox[{"Normal", "[", 
               RowBox[{"cohorts", "[", "\"\<ADNImerge\>\"", "]"}], "]"}], "[",
               "rid", "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", "\t\t", 
          RowBox[{"obs", "=", 
           RowBox[{
            RowBox[{"DayCount", "[", 
             RowBox[{"baseDate", ",", "lastDate"}], "]"}], "/", "365."}]}], 
          ";", "\[IndentingNewLine]", "\t\t", 
          RowBox[{"baseCog", "=", 
           RowBox[{"First", "[", 
            RowBox[{"\"\<ADAS13\>\"", "/.", 
             RowBox[{
              RowBox[{"Normal", "[", 
               RowBox[{"cohorts", "[", "\"\<ADNImerge\>\"", "]"}], "]"}], "[",
               "rid", "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", "\t\t", 
          RowBox[{"y", "=", 
           RowBox[{
            RowBox[{"GetADAS13dayCount", "[", 
             RowBox[{"rid", ",", "baseDate", ",", 
              RowBox[{"baseCog", "+", "dCog"}], ",", "Median"}], "]"}], "/", 
            "365."}]}], ";", "\[IndentingNewLine]", "\t\t", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"NumberQ", "[", "y", "]"}], ",", "\[IndentingNewLine]", 
            "\t\t", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<time\>\"", "->", "y"}], ",", 
              RowBox[{"\"\<status\>\"", "->", "1"}], ",", 
              RowBox[{"\"\<group\>\"", "->", "group"}], ",", 
              RowBox[{"\"\<RID\>\"", "->", "rid"}]}], "|>"}], ",", 
            "\[IndentingNewLine]", "\t\t", 
