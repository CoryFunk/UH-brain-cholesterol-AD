Cell[CellGroupData[{

Cell["QuartileHeatmap", "Subsubsection",ExpressionUUID->"902d1fdd-e953-499d-bfe7-2acff72413a8"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "QuartileHeatmap", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"QuartileHeatmap", "[", 
    RowBox[{"marker_", ",", "rows_", ",", "scale_", ",", 
     RowBox[{"rowDesc_", ":", 
      RowBox[{"{", "}"}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "\t", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "\t", 
      RowBox[{
      "pvals", ",", "maxPval", ",", "arrayColorFun", ",", "arrayLegend", ",", 
       "\[IndentingNewLine]", "\t", "xTicks", ",", "yTicks", ",", "xTicks2", 
       ",", "frameTicks"}], "\[IndentingNewLine]", "\t", "}"}], ",", 
     "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{"pvals", "=", 
       RowBox[{"Association", "[", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", "\t\t\t\t\t", 
         RowBox[{
          RowBox[{"q", "->", 
           RowBox[{"Table", "[", "\[IndentingNewLine]", "\t\t\t\t\t\t", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"marker", "==", "row"}], ",", "\[IndentingNewLine]", 
               "\t\t\t\t\t\t\t", "20", ",", "\[IndentingNewLine]", 
               "\t\t\t\t\t\t\t", 
               RowBox[{
                RowBox[{"ccp", "=", 
                 RowBox[{"Quiet", "[", 
                  RowBox[{"CCPraw", "[", 
                   RowBox[{"Select", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"marker", ",", "row"}], "}"}], "/.", 
                    RowBox[{"GetQuery", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"\"\<Cog\>\"", "->", "q"}], "}"}], ",", 
                    "coreData"}], "]"}]}], ",", 
                    RowBox[{
                    RowBox[{"And", "@@", 
                    RowBox[{"Map", "[", 
                    RowBox[{"NumberQ", ",", "#"}], "]"}]}], "&"}]}], "]"}], 
                   "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
                "\t\t\t\t\t\t\t", 
                RowBox[{"-", 
                 RowBox[{"Log10", "[", 
                  RowBox[{"ccp", "[", "\"\<pval\>\"", "]"}], "]"}]}]}]}], 
              "\[IndentingNewLine]", "\t\t\t\t\t\t\t", "]"}], ",", 
             "\[IndentingNewLine]", "\t\t\t\t\t\t", 
             RowBox[{"{", 
              RowBox[{"row", ",", "rows"}], "}"}]}], "\[IndentingNewLine]", 
            "\t\t\t\t\t\t", "]"}]}], ",", "\[IndentingNewLine]", "\t\t\t\t\t", 
          RowBox[{"{", 
           RowBox[{"q", ",", 
            RowBox[{"{", 
             RowBox[{
             "\"\<Q1\>\"", ",", "\"\<Q2\>\"", ",", "\"\<Q3\>\"", ",", 
              "\"\<Q4\>\""}], "}"}]}], "}"}]}], "\[IndentingNewLine]", 
         "\t\t\t\t\t", "]"}], "]"}]}], ";", "\[IndentingNewLine]", "\t", 
      RowBox[{"maxPval", "=", 
       RowBox[{"IntegerPart", "[", 
        RowBox[{"Max", "[", 
         RowBox[{"Flatten", "[", 
          RowBox[{"Values", "[", "pvals", "]"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"arrayColorFun", "=", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Blend", "[", 
          RowBox[{
           RowBox[{"{", "\[IndentingNewLine]", "\t\t\t\t", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", 
               RowBox[{"Darker", "[", 
                RowBox[{"Purple", ",", "1"}], "]"}]}], "}"}], ",", 
             "\[IndentingNewLine]", "\t\t\t\t", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"scale", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", 
               RowBox[{"Lighter", "[", "Purple", "]"}]}], "}"}], ",", 
             "\[IndentingNewLine]", "\t\t\t\t", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"scale", "[", 
                RowBox[{"[", "2", "]"}], "]"}], ",", 
               RowBox[{"Blend", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"Lighter", "[", "Purple", "]"}], ",", 
                   RowBox[{"Darker", "[", 
                    RowBox[{"Yellow", ",", "0.1"}], "]"}]}], "}"}], ",", 
                 "0.5"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
             "\t\t\t\t", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"scale", "[", 
                RowBox[{"[", "3", "]"}], "]"}], ",", 
               RowBox[{"Darker", "[", 
                RowBox[{"Yellow", ",", "0.1"}], "]"}]}], "}"}]}], 
            "\[IndentingNewLine]", "\t\t\t\t", "}"}], ",", "#"}], "]"}], 
         "&"}], ")"}]}], ";", "\[IndentingNewLine]", "\t", 
      RowBox[{"arrayLegend", "=", 
       RowBox[{"BarLegend", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"arrayColorFun", ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{"scale", "[", 
              RowBox[{"[", "3", "]"}], "]"}]}], "}"}]}], "}"}], ",", 
         RowBox[{
          RowBox[{"scale", "[", 
           RowBox[{"[", "3", "]"}], "]"}], "-", "1"}], ",", 
         RowBox[{"LegendLabel", "->", 
          RowBox[{"Style", "[", 
           RowBox[{"\"\<-Log10[pval]\>\"", ",", 
            RowBox[{"FontSize", "->", "12"}]}], "]"}]}], ",", 
         RowBox[{"LegendMarkerSize", "->", 
          RowBox[{"20", " ", 
           RowBox[{"Length", "[", "rows", "]"}]}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"xTicks", "=", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Range", "@", 
           RowBox[{"Length", "[", "rows", "]"}]}], ",", 
          RowBox[{
           RowBox[{"rows", "/.", "SomascanLookup"}], "/.", 
           "genesToProteins"}]}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\t", 
      RowBox[{"xTicks2", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"rowDesc", "==", 
          RowBox[{"{", "}"}]}], ",", "None", ",", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Range", "@", 
             RowBox[{"Length", "[", "rowDesc", "]"}]}], ",", "rowDesc"}], 
           "}"}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", "\t", 
      RowBox[{"yTicks", "=", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Range", "@", 
           RowBox[{"Length", "[", 
            RowBox[{"Keys", "[", "pvals", "]"}], "]"}]}], ",", 
          RowBox[{"Keys", "[", "pvals", "]"}]}], "}"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"frameTicks", "=", 
       RowBox[{"{", 
        RowBox[{"xTicks", ",", "None", ",", "xTicks2", ",", "yTicks"}], 
        "}"}]}], ";", "\[IndentingNewLine]", "\t", 
      RowBox[{"ArrayPlot", "[", "\[IndentingNewLine]", "\t\t\t\t", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"Values", "[", "pvals", "]"}], "]"}], ",", 
        "\[IndentingNewLine]", "\t\t\t\t", 
        RowBox[{"ColorFunction", "\[Rule]", "arrayColorFun"}], ",", 
        "\[IndentingNewLine]", "\t\t\t\t", 
        RowBox[{"ColorFunctionScaling", "->", "False"}], ",", 
        "\[IndentingNewLine]", "\t\t\t\t", 
        RowBox[{"Frame", "->", "True"}], ",", 
        RowBox[{"ImageSize", "->", 
         RowBox[{"{", 
          RowBox[{"Automatic", ",", 
           RowBox[{
            RowBox[{"20", " ", 
             RowBox[{"Length", "[", "rows", "]"}]}], "+", "36"}]}], "}"}]}], 
        ",", "\[IndentingNewLine]", "\t\t\t\t", 
        RowBox[{"FrameLabel", "->", 
         RowBox[{"{", 
          RowBox[{"None", ",", "None", ",", "None", ",", 
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"marker", "/.", "SomascanLookup"}], ",", 
             RowBox[{"FontSize", "->", "14"}]}], "]"}]}], "}"}]}], ",", 
        "\[IndentingNewLine]", "\t\t\t\t", 
        RowBox[{"FrameTicks", "->", "frameTicks"}], ",", 
        "\[IndentingNewLine]", "\t\t\t\t", 
        RowBox[{"PlotLegends", "->", 
         RowBox[{"Placed", "[", 
          RowBox[{"arrayLegend", ",", "Right"}], "]"}]}]}], 
       "\[IndentingNewLine]", "\t\t\t\t", "]"}]}]}], "\[IndentingNewLine]", 
    "\t", "]"}]}], ";"}]}], "Input",
 CellLabel->"In[57]:=",ExpressionUUID->"1794206f-5362-435b-8db6-809c66d41302"]
}, Closed]],

Cell[CellGroupData[{

Cell["SNPsig", "Subsubsection",ExpressionUUID->"0cb7cab2-ffaf-48e4-8902-f2961223446b"],

Cell["\<\
(* Patched SNPsig (15-16 Sep 2026; supersedes the original definition).
   Four fixes: -1 no-call filter; genotype groups indexed through an \
allele-copy lookup
   rather than position; general A/B orientation; SNPgene guard. Plus \
$SNPsigChart to
   skip plotting during the screen, and nGroups / alleleCopies in the output.
   Also the Sex query fix: PTGENDER holds the Symbols Male / Female. *)
$SNPsigChart = True;
Clear[SNPsig];
SNPsig[SNP_, key_, data_, labelRules_, label_:\"\"] := Module[
  {rows, grouped, keyVals, alleleCopies, pos, nG, ksPairs, pvals, n,
   pvalTable, pvalTable2, mpvRow, mpvA, mpvB, chart, geneLab,
   sortedPvals, sortedColors, sortedFaces, sortedNs, maxY, minY, dY,
   pValThresh = 0.05},

  rows = Select[{SNP, key} /. data, And @@ Map[NumberQ, #] && \
NonNegative[#[[1]]] &];
  If[Length[rows] < 2, Return[<|\"table\" -> {<|\"pval A|B\" -> 1.|>}, \
\"nGroups\" -> 0,
                                \"mpv\" -> 1., \"keyValN\" -> {}|>]];

  grouped      = SortBy[GatherBy[rows, #[[1]] &], #[[1, 1]] &];
  keyVals      = Transpose[#][[2]] & /@ grouped;
  alleleCopies = #[[1, 1]] & /@ grouped;
  nG           = Length[alleleCopies];
  pos          = AssociationThread[alleleCopies -> Range[nG]];
  If[nG < 2, Return[<|\"table\" -> {<|\"pval A|B\" -> 1.|>}, \"nGroups\" -> nG,
                      \"mpv\" -> 1., \"keyValN\" -> Map[Length, keyVals]|>]];

  ksPairs = Subsets[alleleCopies, {2}];
  pvals   = KolmogorovSmirnovTest[keyVals[[pos[#[[1]]]]], \
keyVals[[pos[#[[2]]]]]] & /@ ksPairs;
  n       = {Length[keyVals[[pos[#[[1]]]]]], Length[keyVals[[pos[#[[2]]]]]]} \
& /@ ksPairs;

  pvalTable = <|\"alleles A\" -> #[[1, 1]], \"alleles B\" -> #[[1, 2]],
                \"pval A|B\" -> #[[2]], \"n\" -> #[[3]]|> & /@ \
Transpose[{ksPairs, pvals, n}];
  pvalTable = SortBy[pvalTable, #[\"alleles A\"] + #[\"alleles B\"] &];
  pvalTable2 = If[#[\"alleles A\"] > #[\"alleles B\"],
      <|\"alleles A\" -> #[\"alleles B\"], \"alleles B\" -> #[\"alleles A\"],
        \"pval A|B\" -> #[\"pval A|B\"], \"n\" -> Reverse[#[\"n\"]]|>, #] & \
/@ pvalTable;

  chart = Null;
  If[TrueQ[$SNPsigChart],
    minY = Min[Flatten[keyVals]]; maxY = Max[Flatten[keyVals]]; dY = 0.1 \
(maxY - minY);
    geneLab = Lookup[SNPgene, SNP, \"?\"];
    chart = If[nG == 3,
      sortedPvals  = SetPrecision[\"pval A|B\" /. #, 2] & /@ {pvalTable[[1]], \
pvalTable[[3]], pvalTable[[2]]};
      sortedFaces  = If[# <= pValThresh, Bold, Plain] & /@ sortedPvals;
      sortedColors = If[# <= pValThresh, Black, LightGray] & /@ sortedPvals;
      sortedNs     = {pvalTable[[1]][\"n\"][[1]], pvalTable[[1]][\"n\"][[2]], \
pvalTable[[2]][\"n\"][[2]]};
      BoxWhiskerChart[keyVals, Frame -> True,
        ChartLabels -> Evaluate[Style[ToString[# - 1] <> If[# == 2, \" \
copy\\nn=\", \" copies\\nn=\"] <>
                                ToString[sortedNs[[#]]], FontSize -> 14] & /@ \
Range[3]],
        FrameLabel -> {Style[SNP <> \" Alleles\", FontSize -> 14], Style[(key \
//. labelRules), FontSize -> 14]},
        ChartStyle -> RGBColor[\"#942193\"],
        PlotLabel -> Style[(key //. labelRules) <> \" vs. \" <> SNP <> \" (\" \
<> geneLab <> \") \" <> label, Bold, FontSize -> 14],
        PlotRange -> {{0.5, 3.5}, {minY - 0.5 dY, maxY + 3.5 dY}},
        ImageSize -> 350, AspectRatio -> 1,
        Epilog -> Evaluate[Table[{
          {sortedColors[[i]], Line[{{Mod[i, 4], maxY + i dY}, {Max[1, Mod[i + \
1, 4]], maxY + i dY}}]},
          Text[Style[\"pval: \" <> ToString[sortedPvals[[i]]], FontSize -> \
12, sortedFaces[[i]],
                     sortedColors[[i]], Italic, Background -> White],
               {(Mod[i, 4] + Max[1, Mod[i + 1, 4]])/2, maxY + i dY}]}, {i, \
3}]]],
      BoxWhiskerChart[keyVals, Frame -> True,
        ChartLabels -> Evaluate[Style[ToString[#] <> \" copies\\nn=\" <> \
ToString[Length[keyVals[[pos[#]]]]],
                                FontSize -> 14] & /@ alleleCopies],
        FrameLabel -> {Style[SNP <> \" Alleles\", FontSize -> 14], Style[(key \
//. labelRules), FontSize -> 14]},
        ChartStyle -> RGBColor[\"#942193\"],
        PlotLabel -> Style[(key //. labelRules) <> \" vs. \" <> SNP <> \" (\" \
<> geneLab <> \") \" <> label, Bold, FontSize -> 14],
        ImageSize -> 350, AspectRatio -> 1]]];

  mpvRow = MinimalBy[pvalTable2, #[\"pval A|B\"] &][[1]];
  mpvA = mpvRow[\"alleles A\"]; mpvB = mpvRow[\"alleles B\"];
  <|\"row\" -> If[chart === Null, Null, Grid[{{chart, \
Dataset[pvalTable2]}}]],
    \"chart\" -> chart, \"table\" -> pvalTable2,
    \"keyValN\" -> Map[Length, keyVals], \"alleleCopies\" -> alleleCopies, \
\"nGroups\" -> nG,
    \"mpv\" -> mpvRow[\"pval A|B\"], \"mpvN\" -> mpvRow[\"n\"],
    \"mpvRatio\" -> \
Median[keyVals[[pos[mpvB]]]]/Median[keyVals[[pos[mpvA]]]],
    \"ksPairs\" -> ksPairs,
    \"ksPairVals\" -> ({keyVals[[pos[#[[1]]]]], keyVals[[pos[#[[2]]]]]} & /@ \
ksPairs)|>];

(* ---- Sex query fix ---- *)
querySpecs[\"Sex\"] = <|
  \"ALL\" -> (# &),
  \"F\"   -> (Select[#, ToString[#[\"PTGENDER\"]] == \"Female\" &] &),
  \"M\"   -> (Select[#, ToString[#[\"PTGENDER\"]] == \"Male\" &] &)|>;
Print[\"Sex query check: ALL/F/M = \",
  Length /@ (GetQuery[{\"Cog\" -> \"Q2\", \"Omics\" -> \"L\", \"Sex\" -> #}, \
coreData] & /@ {\"ALL\", \"F\", \"M\"})];
SNPgene[\"rs3756963\"] = \"ELOVL2\"; SNPgene[\"rs2154481\"] = \"APP\";\
\>", "Input",ExpressionUUID->"1052625a-9575-428c-9bac-36472f68f98d"]
}, Closed]],

Cell[CellGroupData[{

Cell["MakeMatrix2", "Subsubsection",ExpressionUUID->"82024d54-d1f8-4acd-8799-1a518120164b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeMatrix2", "[", 
    RowBox[{"data_", ",", "keys_", ",", 
     RowBox[{"filter_", ":", 
      RowBox[{"{", "}"}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "\t", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "\t", 
      RowBox[{
       RowBox[{"thisMtrx", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", "}"}], ",", 
          RowBox[{"Length", "[", 
           RowBox[{"keys", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
          RowBox[{"Length", "[", 
           RowBox[{"keys", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", "\t", "rowCriteria"}], "\[IndentingNewLine]", 
      "\t", "}"}], ",", "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{"rowCriteria", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"AssociationQ", "[", "filter", "]"}], ",", 
         "\[IndentingNewLine]", "\t\t\t\t\t\t", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"filter", "[", "\"\<sign\>\"", "]"}], "==", "\"\<>\>\""}],
            ",", "\[IndentingNewLine]", "\t\t\t\t\t\t\t", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"filter", "[", "\"\<col\>\"", "]"}], "]"}], ">", 
             RowBox[{"filter", "[", "\"\<thresh\>\"", "]"}]}], "&"}], ",", 
           "\[IndentingNewLine]", "\t\t\t\t\t\t\t", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"filter", "[", "\"\<col\>\"", "]"}], "]"}], "<=", 
             RowBox[{"filter", "[", "\"\<thresh\>\"", "]"}]}], "&"}]}], 
          "\[IndentingNewLine]", "\t\t\t\t\t\t\t", "]"}], ",", 
         "\[IndentingNewLine]", "\t\t\t\t\t\t", "All"}], 
        "\[IndentingNewLine]", "\t\t\t\t\t\t", "]"}]}], ";", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"Print", "[", "rowCriteria", "]"}], ";", "\[IndentingNewLine]", 
      "\t", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", "\t\t", 
       RowBox[{
        RowBox[{"Do", "[", "\[IndentingNewLine]", "\t\t\t", 
         RowBox[{
          RowBox[{
           RowBox[{"thisMtrx", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
           RowBox[{"Append", "[", 
            RowBox[{
             RowBox[{"Drop", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                "SpearmanRankTest", "[", "\[IndentingNewLine]", 
                 "\t\t\t\t\t\t\t\t\t\t", 
                 RowBox[{
                  RowBox[{"Normal", "[", 
                   RowBox[{"data", "[", 
                    RowBox[{"rowCriteria", ",", 
                    RowBox[{"keys", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "i"}], "]"}], "]"}]}], "]"}], "]"}], 
                  ",", "\[IndentingNewLine]", "\t\t\t\t\t\t\t\t\t\t", 
                  RowBox[{"Normal", "[", 
                   RowBox[{"data", "[", 
                    RowBox[{"rowCriteria", ",", 
                    RowBox[{"keys", "[", 
                    RowBox[{"[", 
                    RowBox[{"2", ",", "j"}], "]"}], "]"}]}], "]"}], "]"}], 
                  ",", "\[IndentingNewLine]", "\t\t\t\t\t\t\t\t\t\t", 
                  "\"\<TestDataTable\>\""}], "\[IndentingNewLine]", 
                 "\t\t\t\t\t\t\t\t\t\t", "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}], ",", "1"}], 
              "]"}], ",", 
             RowBox[{
              RowBox[{"keys", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "i"}], "]"}], "]"}], 
              StyleBox["\[UndirectedEdge]", "OperatorCharacter"], 
              RowBox[{"keys", "[", 
               RowBox[{"[", 
                RowBox[{"2", ",", "j"}], "]"}], "]"}]}]}], "]"}]}], ",", 
          "\[IndentingNewLine]", "\t\t\t", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", 
             RowBox[{"keys", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "}"}]}], 
         "\[IndentingNewLine]", "\t\t\t", "]"}], ",", "\[IndentingNewLine]", 
        "\t\t", 
        RowBox[{"{", 
         RowBox[{"j", ",", 
          RowBox[{"Length", "[", 
           RowBox[{"keys", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}]}], 
       "\[IndentingNewLine]", "\t\t", "]"}], ";", "\[IndentingNewLine]", "\t",
       "thisMtrx"}]}], "\[IndentingNewLine]", "\t", "]"}]}], ";"}]], "Input",
 CellLabel->"In[61]:=",ExpressionUUID->"6c274fdf-4f2d-4fc2-a2f1-ac56a6f5e966"]
}, Closed]],

Cell[CellGroupData[{

Cell["ShowMatrix2", "Subsubsection",ExpressionUUID->"673f9487-95d0-4bfd-8729-af0330091287"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ShowMatrix2", "[", 
    RowBox[{
    "mtrx_", ",", "maxPval_", ",", "minCC_", ",", "keys_", ",", "blend_"}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "\t", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "\t", 
      RowBox[{
      "xTicks", ",", "yTicks", ",", "thisMtrx", ",", "ccs", ",", "ccMinMax", 
       ",", "ccHist", ",", "ccArray", ",", "ccArrayNoTicks", ",", 
       "colorFunction", ",", "heatmapPlot"}], "\[IndentingNewLine]", "\t", 
      "}"}], ",", "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{"xTicks", "=", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Range", "@", 
           RowBox[{"Length", "[", 
            RowBox[{"keys", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ",", 
          RowBox[{"keys", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "}"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"yTicks", "=", 
       RowBox[{"MapAt", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Rotate", "[", 
           RowBox[{"#", ",", 
            RowBox[{"Pi", "/", "2"}]}], "]"}], "&"}], ",", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Range", "@", 
             RowBox[{"Length", "[", 
              RowBox[{"keys", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ",", 
            RowBox[{"keys", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"All", ",", 
           RowBox[{"-", "1"}]}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]",
       "\t", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"maxPval", "!=", "0"}], ",", "\[IndentingNewLine]", "\t\t", 
        RowBox[{"thisMtrx", "=", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "<=", "maxPval"}], ",", 
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", "0"}], "]"}], "&"}], ",", 
           "mtrx", ",", 
           RowBox[{"{", "2", "}"}]}], "]"}]}]}], "\[IndentingNewLine]", 
       "\t\t", "]"}], ";", "\[IndentingNewLine]", "\t", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"minCC", "!=", "0"}], ",", "\[IndentingNewLine]", "\t\t", 
        RowBox[{"thisMtrx", "=", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "]"}], ">=", "minCC"}], ",", 
              
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", "0"}], "]"}], "&"}], ",", 
           "mtrx", ",", 
           RowBox[{"{", "2", "}"}]}], "]"}]}]}], "\[IndentingNewLine]", 
       "\t\t", "]"}], ";", "\[IndentingNewLine]", "\t", 
      RowBox[{"ccs", "=", 
       RowBox[{"{", "\[IndentingNewLine]", "\t\t", 
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{"Transpose", "[", 
            RowBox[{"mtrx", ",", 
             RowBox[{"{", 
              RowBox[{"2", ",", "3", ",", "1"}], "}"}]}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", "\[IndentingNewLine]", 
         "\t\t", 
         RowBox[{"Flatten", "[", "thisMtrx", "]"}]}], "\[IndentingNewLine]", 
        "\t\t", "}"}]}], ";", "\[IndentingNewLine]", "\t", 
      RowBox[{"ccMinMax", "=", 
       RowBox[{"MinMax", "[", 
        RowBox[{"ccs", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\t", 
      RowBox[{"ccHist", "=", 
       RowBox[{"Histogram", "[", 
        RowBox[{"ccs", ",", "100", ",", "\[IndentingNewLine]", "\t\t\t\t", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<Correlation Coefficient\>\"", ",", "\"\<Number\>\""}],
            "}"}]}], ",", "\[IndentingNewLine]", "\t\t\t\t", 
         RowBox[{"ChartLegends", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<Unfiltered\>\"", ",", "\"\<Filtered by P-Value\>\""}],
            "}"}]}], ",", "\[IndentingNewLine]", "\t\t\t\t", 
         RowBox[{"ImageSize", "->", "400"}]}], "\[IndentingNewLine]", 
        "\t\t\t\t", "]"}]}], ";", "\[IndentingNewLine]", "\t", 
      RowBox[{"colorFunction", "=", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Blend", "[", 
          RowBox[{"blend", ",", "#"}], "]"}], "&"}], ")"}]}], ";", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"colorFunction", "=", 
         RowBox[{"ColorData", "[", "\"\<TemperatureMap\>\"", "]"}]}], ";"}], 
       "*)"}], "\[IndentingNewLine]", "\t", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"colorFunction", "=", "Automatic"}], ";"}], "*)"}], 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"ccArray", "=", 
       RowBox[{"ArrayPlot", "[", 
        RowBox[{"thisMtrx", ",", "\[IndentingNewLine]", "\t\t\t", 
         RowBox[{"ColorFunction", "\[Rule]", "colorFunction"}], ",", 
         "\[IndentingNewLine]", "\t\t\t", 
