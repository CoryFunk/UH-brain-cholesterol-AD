Cell["\<\
(* Fig. 6a with n and events on the legend. LDHB/CER.D19 is the 2-element
   DiceConfig branch, which thresholds on the PREVIOUS call's cohort medians, \
so
   the Q2 call is issued twice before use -- the same guard the cell above \
uses.
   Check afterwards: diceSpec[\"X\",\"thresh\"] should be the true Q2 LDHB \
median
   (0.005) and [\"Y\",\"thresh\"] the true CER.D19 median (3.8089). *)
DiceConfig[{\"Cog\" -> \"Q2\", \"Omics\" -> \"PL\"}, {\"LDHB\", \
\"CER.D19.1.18.0.\"}];
DiceConfig[{\"Cog\" -> \"Q2\", \"Omics\" -> \"PL\"}, {\"LDHB\", \
\"CER.D19.1.18.0.\"}];
RCKMmultiN[\"Q2\",
  Association[# -> (\"RID\" /. GetQuery[{\"Cog\" -> \"Q2\", \"Dice\" -> #}, \
coreData]) & /@
    {\"TL\", \"TR\", \"BL\", \"BR\"}],
  8, \"Absence of 8 pt increase in ADAS13\",
  quadColor[#] & /@ {\"TL\", \"TR\", \"BL\", \"BR\"}, {{0, 8}, {0.5, 1}}]\
\>", "Input",ExpressionUUID->"39a19c7f-b6de-4d8a-93a5-c7adc987a2b3"]
