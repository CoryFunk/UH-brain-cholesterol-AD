Cell[CellGroupData[{

Cell["\<\
Supplementary Figure 1C - CSF Analytes vs WMH Burden (Q1, Q2)\
\>", "Subsection",ExpressionUUID->"21ac3b14-c014-4f76-9dcf-fc58eeee6800"],

Cell[CellGroupData[{

Cell["\<\
Supplementary Figure 7. No cell in Tom's notebook generated this panel. Every \
one of the 7,007 reagents is correlated with TOTAL_WMH within the quartile, \
with CSF albumin residualised out of BOTH the analyte and WMH, so what is \
plotted is the association that is not explained by blood-to-CSF transfer. \
Top 16 by |rho| in Q1, with Q2 shown alongside for the same reagents; bars \
are 95% Fisher-z intervals. The two dotted verticals at rho = +/-0.38 are the \
Bonferroni threshold at n = 146 across 7,007 reagents. The signature is \
vascular smooth muscle and extracellular matrix: CNN1 0.52, CSRP2 0.47, INHBA \
0.41-0.45 across five reagents, THBS1 0.45, POSTN 0.44, PDE3A 0.43. It \
replicates in Q2 and there gains neurofilament (NEFH 0.46, NEFL 0.40) and \
matrix proteolysis (TIMP1 0.44, SERPINE1 0.41, MMP12 0.39), i.e. vessel wall \
and matrix change first, axonal damage after. WMH itself shows independent \
additive contributions from both quadrant axes and no interaction (P:L p = \
0.43 adjusting for age), which is why the TL-to-BR diagonal is the largest \
contrast.\
\>", "Item",ExpressionUUID->"9516baa5-eb4f-4b71-be36-66bcf403e198"],

Cell["\<\
wmhResid[y_, x_] := Module[{b = Covariance[x, y]/Variance[x]},
   y - ((Mean[y] - b Mean[x]) + b x)];

wmhAll[cog_] := Module[{d, rows, alb, wmh},
  d = GetQuery[{\"Cog\" -> cog, \"Omics\" -> \"PL\"}, coreData];
  rows = Select[d, NumberQ[#[\"ALBU\"]] && NumberQ[#[\"TOTAL_WMH\"]] &];
  alb = N[#[\"ALBU\"] & /@ rows]; wmh = N[#[\"TOTAL_WMH\"] & /@ rows];
  Association@Table[
    Module[{x, kp},
     x = #[s] & /@ rows;
     kp = Flatten@Position[x, _?NumberQ];
     If[Length[kp] < 30 || Variance[N@x[[kp]]] == 0, Nothing,
      s -> {s /. SomascanLookup,
            SpearmanRho[wmhResid[N@x[[kp]], alb[[kp]]],
                        wmhResid[wmh[[kp]], alb[[kp]]]],
            Length[kp]}]],
    {s, Keys[SomascanLookup]}]];

q1w = wmhAll[\"Q1\"]; q2w = wmhAll[\"Q2\"];
top = Take[SortBy[Keys[q1w], -Abs[q1w[#][[2]]] &], 16];
loC = RGBColor[0.11, 0.36, 0.62]; hiC = RGBColor[0.85, 0.44, 0.13];
ciF[r_, n_] := Tanh[ArcTanh[r] + {-1, 1} 1.96/Sqrt[n - 3]];
ptsF[assoc_, off_, col_] := Table[
   Module[{k = Reverse[top][[i]], r, n, b},
    If[! KeyExistsQ[assoc, k], Nothing,
     {r, n} = {assoc[k][[2]], assoc[k][[3]]}; b = ciF[r, n];
     {col, AbsoluteThickness[2], Line[{{b[[1]], i + off}, {b[[2]], i + \
off}}],
      PointSize[0.013], Point[{r, i + off}]}]], {i, Length[top]}];
lbls = Reverse[ToString[q1w[#][[1]]] & /@ top];

Legended[
 Graphics[{
   {GrayLevel[0.6], Dashed, Line[{{0, 0.3}, {0, Length[top] + 0.7}}]},
   {Gray, Dotted, Line[{{#, 0.3}, {#, Length[top] + 0.7}}] & /@ {-0.38, 0.38}},
   ptsF[q1w, 0.16, loC], ptsF[q2w, -0.16, hiC]},
  Frame -> {{True, False}, {True, False}},
  FrameTicks -> {{Table[{i, Style[lbls[[i]], 13]}, {i, Length[top]}], None},
                 {Table[{v, Style[v, 13]}, {v, -0.6, 0.8, 0.2}], None}},
  FrameLabel -> {Style[\"partial Spearman rho with WMH (CSF albumin \
removed)\", 14],
                 None},
  PlotLabel -> Style[\"CSF analytes associated with WMH burden\", 15, Bold],
  PlotRange -> {{-0.68, 0.88}, {0.3, Length[top] + 0.7}},
  GridLines -> {None, Range[Length[top]]},
  GridLinesStyle -> Directive[GrayLevel[0.93]],
  ImageSize -> 640, AspectRatio -> 1.05],
 SwatchLegend[{loC, hiC}, {\"Q1\", \"Q2\"}, LegendMarkerSize -> 14]]\
\>", "Input",ExpressionUUID->"92d2e443-6ee5-44d3-bba0-0a20e40d16c5"]
}, Open  ]]
}, Open  ]]
}, Closed]],

