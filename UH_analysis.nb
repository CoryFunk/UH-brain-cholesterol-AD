Cell[CellGroupData[{

Cell["\<\
eventTimes, riskSetCount, eventsAt, KMStepData, KaplanMeier, LogRankTest2\
\>", "Subsubsection",ExpressionUUID->"9b886285-6c06-4eeb-97d9-f44234f20bfe"],

Cell[CellGroupData[{

Cell["\<\
Six KM primitives that were previously bundled into one unlabelled cell \
sitting under the RCKM heading, so none of them was documented and the RCKM \
heading described code that was not RCKM. eventTimes / riskSetCount / \
eventsAt build the risk sets; KMStepData and KaplanMeier produce the survival \
curve; LogRankTest2 is the two-group log-rank test, returning an Association \
including \"pValueTwoSided\". Used by RCKM, RCKMmulti, and the \
APOE4-stratified curves.\
\>", "Item",ExpressionUUID->"fce77bce-b42c-4da4-bc79-6fe8dcbeede2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Helpers", " ", "that", " ", "work", " ", "directly", " ", "on", " ", 
    "Association", " ", "rows"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"eventTimes", "[", "d_List", "]"}], ":=", 
     RowBox[{"Union", "@", 
      RowBox[{"Cases", "[", 
       RowBox[{"d", ",", 
        RowBox[{
         RowBox[{"a_", "/;", 
          RowBox[{
           RowBox[{"a", "[", "\"\<status\>\"", "]"}], "==", "1"}]}], ":>", 
         RowBox[{"a", "[", "\"\<time\>\"", "]"}]}]}], "]"}]}]}], ";"}], "\n", 
   
   RowBox[{
    RowBox[{
     RowBox[{"riskSetCount", "[", 
      RowBox[{"d_List", ",", "t_"}], "]"}], ":=", 
     RowBox[{"Count", "[", 
      RowBox[{"d", ",", 
       RowBox[{"a_", "/;", 
        RowBox[{
         RowBox[{"a", "[", "\"\<time\>\"", "]"}], ">=", "t"}]}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"eventsAt", "[", 
      RowBox[{"d_List", ",", "t_"}], "]"}], ":=", 
     RowBox[{"Count", "[", 
      RowBox[{"d", ",", 
       RowBox[{"a_", "/;", 
        RowBox[{
         RowBox[{
          RowBox[{"a", "[", "\"\<time\>\"", "]"}], "==", "t"}], "&&", 
         RowBox[{
          RowBox[{"a", "[", "\"\<status\>\"", "]"}], "==", "1"}]}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"KaplanMeier", "[", "data_List", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"d", "=", 
          RowBox[{"SortBy", "[", 
           RowBox[{"data", ",", 
            RowBox[{"#time", "&"}]}], "]"}]}], ",", "times", ",", 
         RowBox[{"S", "=", "1."}], ",", 
         RowBox[{"out", "=", 
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{"0.", ",", "1."}], "}"}], "}"}]}]}], 
        "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"times", "=", 
         RowBox[{"eventTimes", "[", "d", "]"}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"(*", 
         RowBox[{"distinct", " ", "event", " ", "times"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"n", "=", 
               RowBox[{"riskSetCount", "[", 
                RowBox[{"d", ",", "t"}], "]"}]}], ",", 
              RowBox[{"dAt", "=", 
               RowBox[{"eventsAt", "[", 
                RowBox[{"d", ",", "t"}], "]"}]}]}], "}"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"n", ">", "0"}], "&&", 
                RowBox[{"dAt", ">", "0"}]}], ",", 
               RowBox[{
                RowBox[{"S", "*=", 
                 RowBox[{"(", 
                  RowBox[{"1", "-", 
                   RowBox[{"dAt", "/", "n"}]}], ")"}]}], ";", 
                RowBox[{"AppendTo", "[", 
                 RowBox[{"out", ",", 
                  RowBox[{"{", 
                   RowBox[{"t", ",", "S"}], "}"}]}], "]"}]}]}], "]"}], 
             ";"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "times"}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", "out"}]}], "\[IndentingNewLine]", "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Clear", "[", "LogRankTest2", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"LogRankTest2", "[", "data_List", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"g", "=", 
          RowBox[{"GatherBy", "[", 
           RowBox[{"data", ",", 
            RowBox[{"#group", "&"}]}], "]"}]}], ",", "g1", ",", "g2", ",", 
         "times", ",", 
         RowBox[{"O1", "=", "0."}], ",", 
         RowBox[{"E1", "=", "0."}], ",", 
         RowBox[{"V", "=", "0."}]}], "}"}], ",", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "g", "]"}], "!=", "2"}], ",", 
          RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"g1", ",", "g2"}], "}"}], "=", "g"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"times", "=", 
         RowBox[{"Union", "@", 
          RowBox[{"Cases", "[", 
           RowBox[{"data", ",", 
            RowBox[{
             RowBox[{"a_", "/;", 
              RowBox[{
               RowBox[{"a", "[", "\"\<status\>\"", "]"}], "==", "1"}]}], ":>", 
             RowBox[{"a", "[", "\"\<time\>\"", "]"}]}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"n1", "=", 
               RowBox[{"Count", "[", 
                RowBox[{"g1", ",", 
                 RowBox[{"a_", "/;", 
                  RowBox[{
                   RowBox[{"a", "[", "\"\<time\>\"", "]"}], ">=", "t"}]}]}], 
                "]"}]}], ",", 
              RowBox[{"n2", "=", 
               RowBox[{"Count", "[", 
                RowBox[{"g2", ",", 
                 RowBox[{"a_", "/;", 
                  RowBox[{
                   RowBox[{"a", "[", "\"\<time\>\"", "]"}], ">=", "t"}]}]}], 
                "]"}]}], ",", 
              RowBox[{"d1", "=", 
               RowBox[{"Count", "[", 
                RowBox[{"g1", ",", 
                 RowBox[{"a_", "/;", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"a", "[", "\"\<time\>\"", "]"}], "==", "t"}], "&&", 
                   RowBox[{
                    RowBox[{"a", "[", "\"\<status\>\"", "]"}], "==", 
                    "1"}]}]}]}], "]"}]}], ",", 
              RowBox[{"d2", "=", 
               RowBox[{"Count", "[", 
                RowBox[{"g2", ",", 
                 RowBox[{"a_", "/;", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"a", "[", "\"\<time\>\"", "]"}], "==", "t"}], "&&", 
                   RowBox[{
                    RowBox[{"a", "[", "\"\<status\>\"", "]"}], "==", 
                    "1"}]}]}]}], "]"}]}]}], "}"}], ",", 
            RowBox[{"Module", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"n", "=", 
                 RowBox[{"n1", "+", "n2"}]}], ",", 
                RowBox[{"d", "=", 
                 RowBox[{"d1", "+", "d2"}]}]}], "}"}], ",", 
              RowBox[{
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"n", ">", "1"}], "&&", 
                  RowBox[{"d", ">", "0"}]}], ",", 
                 RowBox[{
                  RowBox[{"O1", "+=", "d1"}], ";", "\[IndentingNewLine]", 
                  RowBox[{"E1", "+=", 
                   RowBox[{"d", " ", 
                    RowBox[{"(", 
                    RowBox[{"n1", "/", "n"}], ")"}]}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"V", "+=", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"n1", " ", "n2", " ", "d", " ", 
                    RowBox[{"(", 
                    RowBox[{"n", "-", "d"}], ")"}]}], ")"}], "/", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"n", "^", "2"}], " ", 
                    RowBox[{"(", 
                    RowBox[{"n", "-", "1."}], ")"}]}], ")"}]}]}], ";"}]}], 
                "]"}], ";"}]}], "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "times"}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Z", "=", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"O1", "-", "E1"}], ")"}], "/", 
              RowBox[{"Sqrt", "[", "V", "]"}]}]}], ",", "p"}], "}"}], ",", 
          RowBox[{
           RowBox[{"p", "=", 
            RowBox[{"2", " ", 
             RowBox[{"(", 
              RowBox[{"1", "-", 
               RowBox[{"CDF", "[", 
                RowBox[{
                 RowBox[{"NormalDistribution", "[", "]"}], ",", 
                 RowBox[{"Abs", "[", "Z", "]"}]}], "]"}]}], ")"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<Z\>\"", "->", "Z"}], ",", 
             RowBox[{"\"\<pValueTwoSided\>\"", "->", "p"}], ",", 
             RowBox[{"\"\<O1\>\"", "->", "O1"}], ",", 
             RowBox[{"\"\<E1\>\"", "->", "E1"}], ",", 
             RowBox[{"\"\<Var\>\"", "->", "V"}]}], "|>"}]}]}], "]"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"KMStepData", "[", "data_List", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"km", "=", 
          RowBox[{"KaplanMeier", "[", "data", "]"}]}], ",", "tmax"}], "}"}], 
       ",", 
       RowBox[{
        RowBox[{"tmax", "=", 
         RowBox[{"Max", "[", 
          RowBox[{"data", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "\"\<time\>\""}], "]"}], "]"}], "]"}]}], ";", 
        
        RowBox[{"Join", "[", 
         RowBox[{"km", ",", 
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{"tmax", ",", 
             RowBox[{
              RowBox[{"Last", "[", "km", "]"}], "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "}"}]}], "]"}]}]}], 
      "]"}]}], ";"}]}]}]], "Input",
 CellLabel->
  "In[366]:=",ExpressionUUID->"55ee73f0-d45c-449a-a119-f70baee54aec"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["RCKM (Right-Censoring Kaplan Meier)", "Subsubsection",ExpressionUUID->"8b216c93-e084-4c96-81b1-7d65bb49ea4c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"RCKM", "[", 
    RowBox[{
    "rids_", ",", "cog_", ",", "dCogQ_", ",", "yLabel_", ",", "colors_"}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
      "keyA", ",", "keyB", ",", "dataA", ",", "dataB", ",", "data", ",", 
       "kmA", ",", "kmB", ",", "\[IndentingNewLine]", "tmax", ",", 
       "tickTimes", ",", "plt", ",", "\[IndentingNewLine]", "riskTimes", ",", 
       "narA", ",", "narB", ",", "riskTable", ",", "lrt"}], 
      "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"keyA", "=", 
       RowBox[{
        RowBox[{"Keys", "[", "rids", "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"keyB", "=", 
       RowBox[{
        RowBox[{"Keys", "[", "rids", "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{"dCogQ", ",", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"delta", " ", "cog"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"dataA", "=", 
          RowBox[{"DCogKMprep", "[", 
           RowBox[{
            RowBox[{"rids", "[", "keyA", "]"}], ",", "cog", ",", "keyA"}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"dataB", "=", 
          RowBox[{"DCogKMprep", "[", 
           RowBox[{
            RowBox[{"rids", "[", "keyB", "]"}], ",", "cog", ",", "keyB"}], 
           "]"}]}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"abs", " ", "cog"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"dataA", "=", 
          RowBox[{"CogKMprep", "[", 
           RowBox[{
            RowBox[{"rids", "[", "keyA", "]"}], ",", "cog", ",", "keyA"}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"dataB", "=", 
          RowBox[{"CogKMprep", "[", 
           RowBox[{
            RowBox[{"rids", "[", "keyB", "]"}], ",", "cog", ",", "keyB"}], 
           "]"}]}]}]}], "\[IndentingNewLine]", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"data", "=", 
       RowBox[{"Join", "[", 
        RowBox[{"dataA", ",", "dataB"}], "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"kmA", "=", 
       RowBox[{"KMStepData", "[", "dataA", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"kmB", "=", 
       RowBox[{"KMStepData", "[", "dataB", "]"}]}], ";", "\n", 
      "\[IndentingNewLine]", 
      RowBox[{"tmax", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"data", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "\"\<time\>\""}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"tickTimes", "=", 
       RowBox[{"Round", "/@", 
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", "tmax", ",", 
          RowBox[{"tmax", "/", "6."}]}], "]"}]}]}], ";", "\n", 
      "\[IndentingNewLine]", 
      RowBox[{"plt", "=", 
       RowBox[{"ListStepPlot", "[", "\[IndentingNewLine]", "\t", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Legended", "[", 
            RowBox[{"kmA", ",", "keyA"}], "]"}], ",", 
           RowBox[{"Legended", "[", 
            RowBox[{"kmB", ",", "keyB"}], "]"}]}], "}"}], ",", 
         "\[IndentingNewLine]", "\t", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "tmax"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ",", 
         RowBox[{"PlotLegends", "->", "None"}], ",", 
         RowBox[{"PlotLabel", "->", "None"}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", "\[IndentingNewLine]", "\t", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<Years\>\"", ",", "yLabel"}], "}"}]}], ",", 
         "\[IndentingNewLine]", "\t", 
         RowBox[{"ImageSize", "->", "500"}], ",", 
         RowBox[{"PlotStyle", "->", "colors"}]}], "\[IndentingNewLine]", "\t",
         "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"riskTimes", "=", 
       RowBox[{"Round", "/@", 
        RowBox[{"Union", "@", 
         RowBox[{"Flatten", "@", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "tmax"}], "}"}], ",", "tickTimes"}], 
           "}"}]}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"narA", "=", 
       RowBox[{"NumberAtRisk", "[", 
        RowBox[{"dataA", ",", "riskTimes"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"narB", "=", 
       RowBox[{"NumberAtRisk", "[", 
        RowBox[{"dataB", ",", "riskTimes"}], "]"}]}], ";", "\n", 
      "\[IndentingNewLine]", 
      RowBox[{"riskTable", "=", 
       RowBox[{"TableForm", "[", 
        RowBox[{
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"{", 
             RowBox[{"\"\<Time\>\"", ",", 
              RowBox[{"\"\<At risk: \>\"", "<>", "keyA"}], ",", 
              RowBox[{"\"\<At risk: \>\"", "<>", "keyB"}]}], "}"}], "}"}], 
           ",", 
           RowBox[{"MapThread", "[", 
            RowBox[{"List", ",", 
             RowBox[{"{", 
              RowBox[{"riskTimes", ",", "narA", ",", "narB"}], "}"}]}], 
            "]"}]}], "]"}], ",", 
         RowBox[{"TableHeadings", "->", "None"}]}], "]"}]}], ";", "\n", 
      "\[IndentingNewLine]", 
      RowBox[{"lrt", "=", 
       RowBox[{"LogRankTest2", "[", "data", "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", "\t\t", 
         RowBox[{"plt", ",", 
          RowBox[{"Spacer", "[", "10", "]"}], ",", "\[IndentingNewLine]", 
          "\t\t", 
          RowBox[{"Style", "[", 
           RowBox[{
           "\"\<Number at risk (selected times)\>\"", ",", "12", ",", 
            "Bold"}], "]"}], ",", "\[IndentingNewLine]", "\t\t", "riskTable", 
          ",", 
          RowBox[{"Spacer", "[", "10", "]"}], ",", 
          RowBox[{"Style", "[", 
           RowBox[{
           "\"\<Log-rank test (two-sided)\>\"", ",", "12", ",", "Bold"}], 
           "]"}], ",", "\[IndentingNewLine]", "\t\t", 
          RowBox[{"Grid", "[", 
           RowBox[{
            RowBox[{"{", "\[IndentingNewLine]", "\t\t", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"\"\<Z statistic\>\"", ",", 
                RowBox[{"NumberForm", "[", 
                 RowBox[{
                  RowBox[{"lrt", "[", "\"\<Z\>\"", "]"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"6", ",", "3"}], "}"}]}], "]"}]}], "}"}], ",", 
              "\[IndentingNewLine]", "\t\t", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Row", "[", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"Subscript", "[", 
                    RowBox[{"\"\<O\>\"", ",", "1"}], "]"}], ",", 
                   "\"\< (observed events in A)\>\""}], "}"}], "]"}], ",", 
                RowBox[{"lrt", "[", "\"\<O1\>\"", "]"}]}], "}"}], ",", 
              "\[IndentingNewLine]", "\t\t", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Row", "[", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"Subscript", "[", 
                    RowBox[{"\"\<E\>\"", ",", "1"}], "]"}], ",", 
                   "\"\< (expected events in A)\>\""}], "}"}], "]"}], ",", 
                RowBox[{"NumberForm", "[", 
                 RowBox[{
                  RowBox[{"lrt", "[", "\"\<E1\>\"", "]"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"6", ",", "2"}], "}"}]}], "]"}]}], "}"}], ",", 
              "\[IndentingNewLine]", "\t\t", 
              RowBox[{"{", 
               RowBox[{"\"\<p-value (two-sided)\>\"", ",", 
                RowBox[{"NumberForm", "[", 
                 RowBox[{
                  RowBox[{"lrt", "[", "\"\<pValueTwoSided\>\"", "]"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"6", ",", "4"}], "}"}]}], "]"}]}], "}"}]}], 
             "\[IndentingNewLine]", "\t\t", "}"}], ",", 
            RowBox[{"Alignment", "->", 
             RowBox[{"{", 
              RowBox[{"{", 
               RowBox[{"Left", ",", "Right"}], "}"}], "}"}]}], ",", 
            RowBox[{"Spacings", "->", 
             RowBox[{"{", 
              RowBox[{"2", ",", "1"}], "}"}]}]}], "]"}]}], "}"}], ",", 
        RowBox[{"Spacings", "->", "1.2"}]}], "]"}]}]}], "\[IndentingNewLine]",
     "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[373]:=",ExpressionUUID->"44c8db49-356a-4f78-9893-bdf69c511e1a"]
}, Closed]],

Cell[CellGroupData[{

Cell["RCKMmulti", "Subsubsection",ExpressionUUID->"0e40ec7e-a135-4eac-9b1c-67d7291aa12e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"RCKMmulti", "[", 
    RowBox[{
    "q_", ",", "rids_", ",", "cog_", ",", "dCogQ_", ",", "yLabel_", ",", 
     "colors_"}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
      "keys", ",", "data", ",", "dataMerge", ",", "km", ",", 
       "\[IndentingNewLine]", "tmax", ",", "tickTimes", ",", "plt", ",", 
       "\[IndentingNewLine]", "riskTimes", ",", "narA", ",", "narB", ",", 
       "riskTable", ",", "lrt"}], "\[IndentingNewLine]", "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"keys", "=", 
       RowBox[{"Keys", "[", "rids", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{"dCogQ", ",", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"delta", " ", "cog"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"data", "=", 
         RowBox[{"Association", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "->", 
             RowBox[{"DCogKMprep", "[", 
              RowBox[{
               RowBox[{"rids", "[", "#", "]"}], ",", "cog", ",", "#"}], 
              "]"}]}], "&"}], "/@", "keys"}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"abs", " ", "cog"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"data", "=", 
         RowBox[{"Association", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "->", 
             RowBox[{"CogKMprep", "[", 
              RowBox[{
               RowBox[{"rids", "[", "#", "]"}], ",", "cog", ",", "#"}], 
              "]"}]}], "&"}], "/@", "keys"}], "]"}]}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"dataMerge", "=", 
       RowBox[{"Join", "@@", 
        RowBox[{"Values", "[", "data", "]"}]}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"km", "=", 
       RowBox[{"Association", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "->", 
           RowBox[{"KMStepData", "[", 
            RowBox[{"data", "[", "#", "]"}], "]"}]}], "&"}], "/@", "keys"}], 
        "]"}]}], ";", "\n", "\[IndentingNewLine]", 
      RowBox[{"tmax", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"dataMerge", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "\"\<time\>\""}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"tmax", "=", "8"}], ";", "\[IndentingNewLine]", 
      RowBox[{"tickTimes", "=", 
       RowBox[{"Round", "/@", 
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", "tmax", ",", 
          RowBox[{"tmax", "/", "6."}]}], "]"}]}]}], ";", "\n", 
      "\[IndentingNewLine]", 
      RowBox[{"plt", "=", 
       RowBox[{"ListStepPlot", "[", "\[IndentingNewLine]", "\t", 
        RowBox[{"km", ",", "\[IndentingNewLine]", "\t", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "tmax"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"0.5", ",", "1"}], "}"}]}], "}"}]}], ",", 
         RowBox[{"PlotLegends", "->", "Automatic"}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", "\[IndentingNewLine]", "\t", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<Years\>\"", ",", "yLabel"}], "}"}]}], ",", 
         "\[IndentingNewLine]", "\t", 
         RowBox[{"PlotLabel", "->", 
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{
            "q", "<>", " ", "\"\< Progression of Cognitive Decline\>\""}], 
            ",", 
            RowBox[{"{", 
             RowBox[{"Bold", ",", 
              RowBox[{"FontSize", "->", "14"}]}], "}"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", "\t", 
         RowBox[{"ImageSize", "->", "500"}], ",", 
         RowBox[{"PlotStyle", "->", "colors"}]}], "\[IndentingNewLine]", "\t",
         "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      "plt"}]}], "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[374]:=",ExpressionUUID->"cc4f44cf-437b-4cbe-a179-3592a3b7dd9d"]
}, Closed]],

Cell[CellGroupData[{

Cell["RCKMmultiN, apoeKMn (n and events on the curve)", "Subsubsection",ExpressionUUID->"f9d5c946-5ff8-4a75-acd3-68e8e50ceb1d"],

Cell[CellGroupData[{

Cell["\<\
Fig. 6 and Supp Fig. 6 legends state that sample sizes and observed \
progression events are reported for each quadrant; RCKMmulti and apoeKM \
compute neither. RCKMmultiN draws the same curves with the same plain \
quadrant key as RCKMmulti, and prints the N and event counts beneath the plot \
so they can be transcribed into the figure legend rather than crowding the \
panel. apoeKMn does the same for the APOE4 strata and adds the log-rank p to \
the panel. Counts are Length and Count[status == 1] over the DCogKMprep \
output, i.e. the same records the curves are built from.\
\>", "Item",ExpressionUUID->"e4511b31-03cd-4158-a079-60c48246b3e9"],

Cell["\<\
(* Same curves and same legend as RCKMmulti. The N and event counts are printed
   below the plot, not drawn on it: they belong in the figure legend text. \
The
   second printed line is ready to paste into the caption. *)
RCKMmultiN[q_, rids_, cog_, yLabel_, colors_, prange_] :=
 Module[{keys, data, km, n, ev},
  keys = Keys[rids];
  data = Association[(# -> DCogKMprep[rids[#], cog, #]) & /@ keys];
  km   = Association[(# -> KMStepData[data[#]]) & /@ keys];
  n    = Association[(# -> Length[data[#]]) & /@ keys];
  ev   = Association[(# -> Count[data[#], a_ /; a[\"status\"] == 1]) & /@ \
keys];
  Print[TableForm[{#, n[#], ev[#]} & /@ keys,
        TableHeadings -> {None, {\"Quadrant\", \"N\", \"events\"}}]];
  Print[q <> \" for the legend:  \" <> StringRiffle[
     (# <> \" n = \" <> ToString[n[#]] <> \" (\" <> ToString[ev[#]] <> \" \
events)\") & /@ keys,
     \", \"] <> \".\"];
  ListStepPlot[km, PlotRange -> prange, Frame -> True,
   FrameLabel -> {\"Years\", yLabel},
   PlotLabel -> Style[q <> \" Progression of Cognitive Decline\",
                      {Bold, FontSize -> 14}],
   ImageSize -> 560, PlotStyle -> colors,
   PlotLegends -> LineLegend[colors, keys, LegendMarkerSize -> 24]]];

(* APOE4-stratified counterpart. Two strata only, so the legend is not \
crowded
   and the counts stay on the panel alongside the log-rank p. *)
apoeKMn[q_, cog_] :=
 Module[{d, rids, data, km, n, ev, p, labels,
         cols = {GrayLevel[0.55], RGBColor[0.58, 0.09, 0.56]}},
  d = GetQuery[{\"Cog\" -> q, \"Omics\" -> \"PL\"}, coreData];
  rids = <|\"APOE4-\" -> (\"RID\" /. Select[d, NumberQ[#[\"APOE4\"]] && \
#[\"APOE4\"] == 0 &]),
           \"APOE4+\" -> (\"RID\" /. Select[d, NumberQ[#[\"APOE4\"]] && \
#[\"APOE4\"] >= 1 &])|>;
  data = Association[(# -> DCogKMprep[rids[#], cog, #]) & /@ Keys[rids]];
  km   = Association[(# -> KMStepData[data[#]]) & /@ Keys[rids]];
  n    = Association[(# -> Length[data[#]]) & /@ Keys[rids]];
  ev   = Association[(# -> Count[data[#], a_ /; a[\"status\"] == 1]) & /@ \
Keys[rids]];
  p    = LogRankTest2[Join @@ Values[data]][\"pValueTwoSided\"];
  Print[q <> \" APOE4:  \" <> StringRiffle[
     (# <> \" n = \" <> ToString[n[#]] <> \" (\" <> ToString[ev[#]] <> \" \
events)\") & /@ Keys[rids],
     \", \"] <> \", log-rank p = \" <> ToString[NumberForm[p, {2, 3}]] <> \".\
\"];
  labels = Style[# <> \"   n = \" <> ToString[n[#]] <> \", \" <>
                 ToString[ev[#]] <> \" events\", FontSize -> 11] & /@ \
Keys[rids];
  ListStepPlot[km, PlotRange -> {{0, 8}, {0.5, 1}}, Frame -> True,
   FrameLabel -> {\"Years\",
      \"Absence of \" <> ToString[cog] <> \" pt increase in ADAS13\"},
   PlotLabel -> Style[q <> \" APOE4 Progression of Cognitive Decline\",
                      {Bold, FontSize -> 14}],
   ImageSize -> 560, PlotStyle -> cols,
   Epilog -> {Inset[Style[\"log-rank p = \" <> ToString[NumberForm[p, {2, 3}]],
                          Italic, Black, FontSize -> 12],
                    Scaled[{0.95, 0.08}], {1, 0}]},
   PlotLegends -> LineLegend[cols, labels, LegendMarkerSize -> 24]]];\
\>", "Input",ExpressionUUID->"c7466e52-ffe6-47b8-9f3a-0ebb9eccb891"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["apoeKM", "Subsubsection",ExpressionUUID->"e865108f-0822-4d4b-af75-a1f60aa540e7"],

Cell[CellGroupData[{

Cell["\<\
APOE4-stratified Kaplan-Meier curves within a cognitive quartile, with \
log-rank p. Carriers vs non-carriers, endpoint = time to a sustained \
dCog-point ADAS13 rise, right-censored. Revision item #14. Thresholds: Q2 = 8 \
point, Q3 = 6 point (the Q3 figure was moved from 4 to 6 so the cut isolates \
subjects who actually transitioned within the observation window).\
\>", "Item",ExpressionUUID->"8d84f8fa-618f-40b4-8de5-5cb9f506bc41"],

Cell["\<\
apoeKM[cogQ_, dCog_] := Module[{rids, dNeg, dPos, lrt},
   rids = <|
     \"APOE4-\" -> (\"RID\" /. GetQuery[
         {\"Cog\" -> cogQ, \"Omics\" -> \"PL\", \"APOE4\" -> \"Neg\"}, \
coreData]),
     \"APOE4+\" -> (\"RID\" /. GetQuery[
         {\"Cog\" -> cogQ, \"Omics\" -> \"PL\", \"APOE4\" -> \"Pos\"}, \
coreData])|>;
   dNeg = DCogKMprep[rids[\"APOE4-\"], dCog, \"APOE4-\"];
   dPos = DCogKMprep[rids[\"APOE4+\"], dCog, \"APOE4+\"];
   lrt  = LogRankTest2[Join[dNeg, dPos]];
   Column[{
     RCKMmulti[cogQ <> \" APOE4\", rids, dCog, True,
       \"Absence of \" <> ToString[dCog] <> \" pt ADAS13 increase\",
       {GrayLevel[0.55], RGBColor[\"#942193\"]}],
     Style[\"N:  APOE4- = \" <> ToString[Length[rids[\"APOE4-\"]]] <>
           \",  APOE4+ = \" <> ToString[Length[rids[\"APOE4+\"]]], 12],
     Style[\"Log-rank p = \" <>
           ToString[NumberForm[lrt[\"pValueTwoSided\"], {4, 4}]], 12, \
Bold]}]];\
\>", "Input",ExpressionUUID->"ecb01078-76eb-43b6-ba84-979804472339"]
}, Open  ]]
}, Open  ]]
}, Closed]],

