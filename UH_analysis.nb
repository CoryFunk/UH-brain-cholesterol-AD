Cell[CellGroupData[{

Cell["Supplementary Figure 4 - CER.D19 genotype screen", "Subsection",ExpressionUUID->"5d8cb75a-fa30-49c7-a1f1-8a46a54589ad"],

Cell["\<\
(* Supplementary Figure 4 - CER.D19 genotype screen, pre-symptomatic Q2.
   Every SNP scored by the smallest of up to three pairwise KS comparisons \
between genotype groups. *)
SPTLC3SNPs = {\"rs686548\"};
LXRASNPs   = SNPsets[\"LXRA\"];
nonADGWAS  = Join[SPTLC3SNPs, LXRASNPs];
theseSNPs  = Complement[fulcrumGenKeys, nonADGWAS];
Print[\"SNPs screened = \", Length[theseSNPs]];

$SNPsigChart = False;
CERD19sigSNPs = {}; hits = {};
Do[
  thisThresh = 0.01;
  thisData = GetQuery[{\"Cog\" -> \"Q2\", \"Omics\" -> \"L\", \"Sex\" -> \
thisSex}, coreData];
  Do[
    snpSig = Quiet[SNPsig[snp, marker, thisData, Join[SomascanLookup, \
genesToProteins],
              thisSex /. {\"ALL\" -> \"M+F\", \"M\" -> \"M only\", \"F\" -> \
\"F only\"}]];
    If[NumericQ[snpSig[\"mpv\"]] && snpSig[\"mpv\"] < thisThresh,
       AppendTo[hits, {snp, Lookup[SNPgene, snp, \"?\"], thisSex, marker, \
snpSig[\"mpv\"],
                       snpSig[\"mpvN\"], snpSig[\"nGroups\"]}]],
    {marker, {\"CER.D19.1.18.0.\", \"CER.D19.1.16.0.\"}},
    {snp, theseSNPs}],
  {thisSex, {\"ALL\", \"F\", \"M\"}}];
$SNPsigChart = True;

hits = SortBy[hits, #[[5]] &];
Print[\"=== hits (p<0.01) : \", Length[hits], \" rows, \", \
Length[Union[hits[[All,1]]]], \" distinct SNPs ===\"];
Do[Print[Row[{h[[1]], \"  \", h[[2]], \"  \", h[[3]], \"  \", h[[4]], \"  \
p=\", NumberForm[h[[5]], 3],
              \"  n=\", h[[6]], \"  groups=\", h[[7]]}]], {h, hits}];
Print[\"distinct: \", Union[hits[[All,1]]]];\
\>", "Input",ExpressionUUID->"02960a19-7a9c-4c80-a70a-4c23b31550f4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Supplementary Figure 4A/4B panels and results table", "Subsection",ExpressionUUID->"04ee8021-1f40-4321-9cae-257d3b3360c5"],

Cell["\<\
(* Supplementary Figure 4A (AD GWAS lead variants, 10 panels) and 4B \
(variants at genes that are
   not AD GWAS loci, 9 panels), plus the data behind the Supp Fig 4A results \
table. *)
lr = Join[SomascanLookup, genesToProteins];
sexLab = {\"ALL\" -> \"M+F\", \"F\" -> \"F only\", \"M\" -> \"M only\"};
sf4q2  = Association[# -> GetQuery[{\"Cog\" -> \"Q2\",  \"Omics\" -> \"L\", \
\"Sex\" -> #}, coreData] & /@ {\"ALL\", \"F\", \"M\"}];
sf4q23 = Association[# -> GetQuery[{\"Cog\" -> \"Q23\", \"Omics\" -> \"L\", \
\"Sex\" -> #}, coreData] & /@ {\"ALL\", \"F\", \"M\"}];
sf4Run[{snp_, sp_, sx_, set_}] := Module[{r},
   r = SNPsig[snp, sp, If[set === \"Q23\", sf4q23, sf4q2][sx], lr,
         (sx /. sexLab) <> If[set === \"Q23\", \" Q2,3\", \"\"]];
   <|\"SNP\" -> snp, \"gene\" -> Lookup[SNPgene, snp, \"?\"], \"stratum\" -> \
(sx /. sexLab),
     \"species\" -> If[StringContainsQ[sp, \"18.0\"], \"18:0\", \"16:0\"], \
\"screen p\" -> r[\"mpv\"],
     \"groups compared\" -> r[\"mpvN\"], \"genotype groups (0/1/2)\" -> \
r[\"keyValN\"], \"chart\" -> r[\"chart\"]|>];
sf4SpecsA = {{\"rs10933431\",\"CER.D19.1.18.0.\",\"ALL\",\"Q2\"}, \
{\"rs2526377\",\"CER.D19.1.18.0.\",\"ALL\",\"Q2\"},
   {\"rs2154481\",\"CER.D19.1.16.0.\",\"ALL\",\"Q2\"}, \
{\"rs871269\",\"CER.D19.1.18.0.\",\"F\",\"Q2\"},
   {\"rs10933431\",\"CER.D19.1.18.0.\",\"F\",\"Q2\"}, \
{\"rs867611\",\"CER.D19.1.18.0.\",\"M\",\"Q2\"},
   {\"rs2632516\",\"CER.D19.1.18.0.\",\"M\",\"Q2\"}, \
{\"rs2526377\",\"CER.D19.1.18.0.\",\"M\",\"Q2\"},
   {\"rs10933431\",\"CER.D19.1.18.0.\",\"M\",\"Q2\"}, \
{\"rs561655\",\"CER.D19.1.18.0.\",\"M\",\"Q2\"}};
sf4SpecsB = {{\"rs686548\",\"CER.D19.1.18.0.\",\"ALL\",\"Q2\"}, {\"rs12692386\
\",\"CER.D19.1.16.0.\",\"ALL\",\"Q2\"},
   {\"rs3756963\",\"CER.D19.1.16.0.\",\"ALL\",\"Q2\"}, \
{\"rs12692386\",\"CER.D19.1.18.0.\",\"F\",\"Q2\"},
   {\"rs924135\",\"CER.D19.1.16.0.\",\"F\",\"Q2\"}, \
{\"rs438811\",\"CER.D19.1.18.0.\",\"M\",\"Q2\"},
   {\"rs686548\",\"CER.D19.1.18.0.\",\"M\",\"Q2\"},
   {\"rs7120118\",\"CER.D19.1.18.0.\",\"M\",\"Q23\"}, \
{\"rs3758673\",\"CER.D19.1.18.0.\",\"M\",\"Q23\"}};
sf4A = sf4Run /@ sf4SpecsA;
sf4B = sf4Run /@ sf4SpecsB;
uhExport[Grid[Partition[sf4A[[All, \"chart\"]], UpTo[5]], Spacings -> {2, 2}, \
Alignment -> Top], \"SuppFig4A\"];
uhExport[Grid[Partition[sf4B[[All, \"chart\"]], UpTo[3]], Spacings -> {2, 2}, \
Alignment -> Top], \"SuppFig4B\"];

(* GWAS source and smallest reported GWAS p per lead variant (Supplementary \
Table 8) *)
sf4Gwas = <|\"rs10933431\" -> {\"Bellenguez, Kunkle, Jansen\", 3.62*^-18}, \
\"rs2526377\" -> {\"Bellenguez\", 1.58*^-12},
   \"rs2154481\" -> {\"Bellenguez\", 9.998*^-13}, \"rs871269\" -> \
{\"Wightman, Bellenguez\", 1.37*^-9},
   \"rs867611\" -> {\"Jansen\", 1.48*^-18}, \"rs2632516\" -> {\"Wightman\", \
7.46*^-10}, \"rs561655\" -> {\"Wightman\", 1.24*^-26}|>;
sf4AResults = Dataset[MapIndexed[Join[<|\"panel\" -> \"A\" <> \
ToString[First[#2]]|>,
     KeyDrop[#1, \"chart\"], <|\"AD GWAS study\" -> \
sf4Gwas[#1[\"SNP\"]][[1]], \"GWAS P\" -> sf4Gwas[#1[\"SNP\"]][[2]]|>] &, \
sf4A]];
Export[FileNameJoin[{NotebookDirectory[], \"SuppFig4A_results.csv\"}], \
sf4AResults, \"CSV\"];
sf4BResults = Dataset[MapIndexed[Join[<|\"panel\" -> \"B\" <> \
ToString[First[#2]]|>, KeyDrop[#1, \"chart\"]] &, sf4B]];
Export[FileNameJoin[{NotebookDirectory[], \"SuppFig4B_results.csv\"}], \
sf4BResults, \"CSV\"];
{sf4AResults, sf4BResults}\
\>", "Input",ExpressionUUID->"f9239f3f-ab46-438f-a426-d86b2762839e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Supplementary Figure 4 - linkage disequilibrium between paired lead variants\
\>", "Subsection",ExpressionUUID->"46bab482-cc78-4a27-b65a-2deeca881269"],

Cell["\<\
(* Independence of the paired lead variants at PICALM and TSPOAP1: genotype \
correlation
   (allele-copy Pearson r) in all genotyped participants and in Q2. Reported \
positions for these
   pairs come from different studies on different genome builds, so base-pair \
distance cannot
   be used to judge independence. *)
sf4LD[a_, b_, dat_] := Module[{p = Select[{a, b} /. dat, VectorQ[#, NumberQ] \
&& Min[#] >= 0 &]},
   {Length[p], Correlation[N@p[[All, 1]], N@p[[All, 2]]]}];
Grid[Prepend[Table[{pr[[1]] <> \" / \" <> pr[[2]], pr[[3]],
     sf4LD[pr[[1]], pr[[2]], Select[coreData, NumberQ[#[pr[[1]]]] &]],
     sf4LD[pr[[1]], pr[[2]], GetQuery[{\"Cog\" -> \"Q2\", \"Omics\" -> \
\"L\"}, coreData]]},
   {pr, {{\"rs867611\", \"rs561655\", \"PICALM\"}, {\"rs2632516\", \
\"rs2526377\", \"TSPOAP1\"}}}],
  {\"pair\", \"gene\", \"all genotyped {n, r}\", \"Q2 {n, r}\"}], Frame -> \
All]\
\>", "Input",ExpressionUUID->"d0367397-6b53-4314-9f81-e04f03ea4464"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Supplementary Table 8 - AD GWAS statistics for the Supp Fig 4A lead variants\
\>", "Subsection",ExpressionUUID->"28795436-580e-4f3b-a978-67007e9848e4"],

Cell["\<\
(* Supplementary Table 8 - published AD GWAS statistics for the lead variants \
in Supp Fig 4A.
   Transcribed from the curated locus list (ad_loci_pathways.xlsx; Bellenguez \
2022, Kunkle 2019,
   Jansen 2019, Wightman 2021). BP as reported by each study; genome builds \
differ. *)
st8 = Dataset[AssociationThread[{\"locus\",\"cytoband\",\"SNP\",\"CHR\",\"BP\"\
,\"A1\",\"A2\",\"GENE\",\"FRQ\",\"global_maf\",\"OR\",\"P\",\"study\"} -> #] \
& /@ {
   {10, \"2q37.1\", \"rs10933431\", 2, 233117202, \"C\", \"G\", \"INPP5D\", \
0.2343, 0.372197, 0.93, 3.62*^-18, \"Bellenguez\"},
   {10, \"2q37.1\", \"rs10933431\", 2, 233981912, \"C\", \"G\", \"INPP5D\", \
0.223, 0.372197, 0.91, 3.4*^-9, \"Kunkle\"},
   {10, \"2q37.1\", \"rs10933431\", 2, 233981912, \"C\", \"G\", \"INPP5D\", \
0.244487, 0.372197, 0.984682, 7.62*^-10, \"Jansen\"},
   {20, \"5q33.1\", \"rs871269\", 5, 150432388, \"C\", \"T\", \"TNIP1\", \
0.32, 0.393324, 0.991951, 1.37*^-9, \"Wightman\"},
   {20, \"5q33.1\", \"rs871269\", 5, 151052827, \"C\", \"T\", \"TNIP1\", \
0.3264, 0.393324, 0.96, 8.67*^-9, \"Bellenguez\"},
   {52, \"11q14.2\", \"rs867611\", 11, 85776544, \"A\", \"G\", \"PICALM\", \
0.317416, 0.268237, 0.979778, 1.48*^-18, \"Jansen\"},
   {52, \"11q14.2\", \"rs561655\", 11, 85800279, \"G\", \"A\", \"PICALM\", \
0.65, 0.300744, 1.01441, 1.24*^-26, \"Wightman\"},
   {82, \"17q22\", \"rs2632516\", 17, 56409089, \"G\", \"C\", \
\"TSPOAP1-AS1\", 0.46, 0.495851, 0.993822, 7.46*^-10, \"Wightman\"},
   {82, \"17q23.2\", \"rs2526377\", 17, 58332680, \"A\", \"G\", \"TSPOAP1\", \
0.4449, 0.496494, 0.95, 1.58*^-12, \"Bellenguez\"},
   {100, \"21q21.2\", \"rs2154481\", 21, 26101558, \"T\", \"C\", \"APP\", \
0.4764, 0.377636, 0.95, 9.998*^-13, \"Bellenguez\"}}];
