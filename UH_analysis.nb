\>", "Input",ExpressionUUID->"8e202ceb-1522-4b96-a4a2-afdfd432c761"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Supplementary Figure 5 - Q2 quadrant composition and follow-up\
\>", "Subsection",ExpressionUUID->"2a0554dc-5b87-4de2-9cdd-920edbe4a1b0"],

Cell["\<\
(* Supplementary Figure 5 - composition and follow-up of the pre-symptomatic \
Q2 quadrants
   (LDHB x CER.D19.1.18.0, split at the Q2 medians as in Fig. 4A). \
Histograms: years from baseline
   to progression (ADAS13 increase of 8 points, as in Fig. 6A) or to the last \
visit (censored),
   2-year bins; darker = progressed, lighter = did not progress. Uses the \
same DCogKMprep
   records as the Fig. 6A Kaplan-Meier curves. *)
DiceConfig[{\"Cog\" -> \"Q2\", \"Omics\" -> \"PL\"}, {\"LDHB\", \
\"CER.D19.1.18.0.\"}];
sf5Scatter = DiceConfig[{\"Cog\" -> \"Q2\", \"Omics\" -> \"PL\"}, {\"LDHB\", \
\"CER.D19.1.18.0.\"}];
sf5Quads = {\"TL\", \"TR\", \"BL\", \"BR\"};
sf5Title = <|\"TL\" -> \"TL: \\[UpArrow] CER.D19, \\[DownArrow] LDHB\", \
\"TR\" -> \"TR: \\[UpArrow] CER.D19, \\[UpArrow] LDHB\",
   \"BL\" -> \"BL: \\[DownArrow] CER.D19, \\[DownArrow] LDHB\", \"BR\" -> \
\"BR: \\[DownArrow] CER.D19, \\[UpArrow] LDHB\"|>;
sf5Data = Association[# -> DCogKMprep[\"RID\" /. GetQuery[{\"Cog\" -> \"Q2\", \
\"Dice\" -> #}, coreData], 8, #] & /@ sf5Quads];
sf5Dark = <|\"TL\" -> Darker[quadColor[\"TL\"], 0.35], \"TR\" -> \
GrayLevel[0.35], \"BL\" -> GrayLevel[0.55],
   \"BR\" -> Darker[quadColor[\"BR\"], 0.35]|>;
sf5Hist[k_] := Module[{ev = Select[sf5Data[k], #[\"status\"] == 1 &][[All, \
\"time\"]],
    ce = Select[sf5Data[k], #[\"status\"] == 0 &][[All, \"time\"]]},
   Histogram[{ev, ce}, {0, 12, 2}, ChartLayout -> \"Stacked\",
    ChartStyle -> {Directive[sf5Dark[k], EdgeForm[GrayLevel[0.3]]],
                   Directive[Lighter[quadColor[k], 0.5], \
EdgeForm[GrayLevel[0.3]]]},
    Frame -> True, FrameLabel -> {\"Years post baseline\", \"Participants\"},
    PlotLabel -> Style[sf5Title[k] <> \"  (n = \" <> \
ToString[Length[sf5Data[k]]] <> \", \" <>
        ToString[Length[ev]] <> \" progressed)\", Bold, 13, GrayLevel[0.35]],
    PlotRange -> {{0, 12}, {0, 13}}, FrameTicks -> {{Automatic, None}, \
{Range[0, 12, 2], None}},
    LabelStyle -> {FontSize -> 13, GrayLevel[0.35]}, ImageSize -> 330, \
AspectRatio -> 0.6]];
sf5Fmt[x_, d_] := ToString[NumberForm[N[x], {5, d}, NumberPadding -> {\"\", \
\"0\"}]];
sf5Row[k_] := Module[{d = GetQuery[{\"Cog\" -> \"Q2\", \"Dice\" -> k}, \
coreData], ms},
   ms[key_, dg_] := With[{v = Select[#[key] & /@ d, NumberQ]},
      sf5Fmt[Mean[v], dg] <> \" (\" <> sf5Fmt[StandardDeviation[v], dg] <> \
\")\"];
   {k, Length[d], ms[\"AGE\", 1], ms[\"ADAS13\", 1], ms[\"APOE4\", 2],
    sf5Fmt[100. Count[d, x_ /; ToString[x[\"PTGENDER\"]] == \
\"Female\"]/Length[d], 1]}];
sf5Table = Grid[Prepend[sf5Row /@ sf5Quads,
    Style[#, Bold] & /@ {\"Quadrant\", \"n\", \"Age, y\", \"ADAS13\", \"APOE \
\\[Epsilon]4 alleles\", \"% female\"}],
   Dividers -> {None, {Directive[Thick], True, {False}, Directive[Thick]}},
   Spacings -> {2.5, 0.9}, Alignment -> {{Left, Right, Right, Right, Right, \
Right}},
   BaseStyle -> {FontFamily -> \"Helvetica\", FontSize -> 13}];
sf5Key = SwatchLegend[{GrayLevel[0.4], GrayLevel[0.85]}, {\"Progressed\", \
\"Did not progress (censored at last visit)\"},
   LegendLayout -> \"Row\", LabelStyle -> {FontFamily -> \"Helvetica\", 12}];
SuppFig5 = Column[{
    Grid[{{Magnify[sf5Scatter, 1.35],
       Column[{Grid[Partition[sf5Hist /@ sf5Quads, 2], Spacings -> {1.5, \
1.5}], sf5Key}, Center]}},
     Alignment -> {Center, Center}, Spacings -> 3],
    sf5Table}, Center, Spacings -> 2.5];
uhExport[SuppFig5, \"SuppFig5\"]\
\>", "Input",ExpressionUUID->"1e254225-b6b0-4530-bf3d-cb65b7d5719b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Supplementary Table 7 - APOE e4 and covariates by Fig. 6 quadrant\
\>", "Subsection",ExpressionUUID->"511cdb44-731f-4931-b49d-dd92c3d9afeb"],

Cell["\<\
(* Supplementary Table 7 - APOE e4 genotype and covariates by Fig. 6 \
quadrant.
   A: pre-symptomatic Q2, LDHB / CER.D19 quadrants. B: cognitively impaired \
Q3, astrogliosis PC1
   quadrants ({\"Q3\",\"3\",\"7\"}). Exported as CSV; the display table is \
rendered from these files. *)
meanOr[data_, key_] := Module[{v = Select[#[key] & /@ data, NumberQ]},
   If[Length[v] > 0, Round[Mean[v], 0.1], \"NA\"]];
quadBreakdown[cogQ_, axes_] := Module[{d, a, sex},
   DiceConfig[{\"Cog\" -> cogQ, \"Omics\" -> \"PL\"}, axes];
   DiceConfig[{\"Cog\" -> cogQ, \"Omics\" -> \"PL\"}, axes];
   Dataset[Table[
     d = GetQuery[{\"Cog\" -> cogQ, \"Dice\" -> quad}, coreData];
     a = Select[#[\"APOE4\"] & /@ d, NumberQ];
     sex = ToString /@ (#[\"PTGENDER\"] & /@ d);
     <|\"Quadrant\" -> quad, \"N\" -> Length[d], \"e4=0\" -> Count[a, 0], \
\"e4=1\" -> Count[a, 1], \"e4=2\" -> Count[a, 2],
       \"Carrier %\" -> Round[100. Count[a, x_ /; x > 0]/Length[a], 0.1],
       \"Female %\" -> Round[100. Count[sex, \"Female\"]/Length[d], 0.1],
       \"Age\" -> meanOr[d, \"AGE\"], \"TAU\" -> Round[Mean[Select[#[\"TAU\"] \
& /@ d, NumberQ]]],
       \"ABETA\" -> Round[Mean[Select[#[\"ABETA\"] & /@ d, NumberQ]]]|>,
     {quad, {\"TL\", \"TR\", \"BR\", \"BL\"}}]]];
st7A = quadBreakdown[\"Q2\", {\"LDHB\", \"CER.D19.1.18.0.\"}];
st7B = quadBreakdown[\"Q3\", {\"Q3\", \"3\", \"7\"}];
Export[FileNameJoin[{NotebookDirectory[], \"SuppTable7A.csv\"}], st7A, \
\"CSV\"];
Export[FileNameJoin[{NotebookDirectory[], \"SuppTable7B.csv\"}], st7B, \
\"CSV\"];
{st7A, st7B}\
\>", "Input",ExpressionUUID->"4daf85db-0dfe-4d89-aaaf-4f7f17c4e744"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Supplementary Table 2 - cluster membership", "Subsection",ExpressionUUID->"7b4be9b8-3aee-4cb7-8e7d-2e41a701e7d8"],

Cell["\<\
(* Supplementary Table 2 - cluster membership. A: plasma lipid clusters; B: \
the three CSF MS protein
   clusters; C: protein subclusters used for the PC1 analyses. CSF MS \
analytes are keyed by UniProt
   entry name; st2Gene gives the gene symbol used for display (THRB = \
prothrombin, F2; AATC = GOT1;
   MIME = mimecan, OGN). The APOE isoform peptides APOE2 and APOE4p are not \
clustered.
   Exported as CSV for the display table. *)
st2Gene = <|\"ALBU\" -> \"ALB\", \"APOA4\" -> \"APOA4\", \"APOC1\" -> \"APOC1\
\", \"APOC2\" -> \"APOC2\", \"CERU\" -> \"CP\",
   \"CO9\" -> \"C9\", \"KNG1\" -> \"KNG1\", \"PGRP2\" -> \"PGLYRP2\", \
\"PON1\" -> \"PON1\", \"THRB\" -> \"F2\",
   \"HBA\" -> \"HBA1\", \"HBB\" -> \"HBB\", \"1433B\" -> \"YWHAB\", \"1433Z\" \
-> \"YWHAZ\", \"CH3L1\" -> \"CHI3L1\",
   \"CD44\" -> \"CD44\", \"LDHB\" -> \"LDHB\", \"LDHC\" -> \"LDHC\", \
\"ALDOA\" -> \"ALDOA\", \"KPYM\" -> \"PKM\",
   \"PKM2\" -> \"PKM (M2 isoform)\", \"MDHC\" -> \"MDH1\", \"AATC\" -> \"GOT1\
\", \"ENOA\" -> \"ENO1\", \"PARK7\" -> \"PARK7\",
   \"PPIA\" -> \"PPIA\", \"NRX1B\" -> \"NRXN1\", \"NCAM1\" -> \"NCAM1\", \
\"NPTX2\" -> \"NPTX2\", \"NPTXR\" -> \"NPTXR\",
   \"GELS\" -> \"GSN\", \"OSTP\" -> \"SPP1\", \"PEBP1\" -> \"PEBP1\", \
\"APOE\" -> \"APOE\", \"CALM2\" -> \"CALM2\",
   \"DDAH1\" -> \"DDAH1\", \"DKK3\" -> \"DKK3\", \"G3P\" -> \"GAPDH\", \"GUAD\
\" -> \"GDA\", \"GMFB\" -> \"GMFB\",
   \"MIME\" -> \"OGN\", \"OMGP\" -> \"OMG\", \"PTPRZ\" -> \"PTPRZ1\", \
\"SCG2\" -> \"SCG2\", \"SMOC1\" -> \"SMOC1\",
   \"SODC\" -> \"SOD1\", \"TPIS\" -> \"TPI1\", \"VGF\" -> \"VGF\"|>;
st2MS = <|\"Cluster 1: glial and neuronal\" ->
     Complement[justProteins, Flatten[proteinClusters[[{1, 2}]]], {\"APOE2\", \
\"APOE4p\"}],
   \"Cluster 2: plasma-derived (complement/HDL)\" -> proteinClusters[[1]],
   \"Cluster 3: hemoglobin\" -> proteinClusters[[2]]|>;
st2A = Flatten[Table[<|\"panel\" -> \"A\", \"cluster\" -> \
lipidClusterLabels[[i]], \"member\" -> StringTrim[m, \".\"]|>,
    {i, Length[lipidClusters]}, {m, lipidClusters[[i]]}]];
st2B = Flatten[KeyValueMap[Function[{k, v}, <|\"panel\" -> \"B\", \"cluster\" \
-> k, \"member\" -> st2Gene[#]|> & /@ v], st2MS]];
st2C = Flatten[Table[<|\"panel\" -> \"C\", \"cluster\" -> \
proteinClusterLabels[[i]], \"member\" -> st2Gene[m]|>,
    {i, Length[proteinClusters]}, {m, proteinClusters[[i]]}]];
Export[FileNameJoin[{NotebookDirectory[], \"SuppTable2.csv\"}], \
Dataset[Join[st2A, st2B, st2C]], \"CSV\"];
{Length[st2A], Length[st2B], Length[st2C], Count[Join[st2B, st2C][[All, \
\"member\"]], _Missing]}\
\>", "Input",ExpressionUUID->"f65991cf-91f2-455f-97a1-6e086fc41e7f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Supplementary Table 5 - CSF proteins correlated with CER.D19 in Q2 (A) and \
their pathway enrichment (B)\
\>", "Subsection",ExpressionUUID->"25c0261c-54ab-4c02-96e9-378df45330d6"],

Cell["\<\
Requires fig4dP and fig4dHits from the Figure 4D - Revised cell. Exports \
SuppTable5A.csv and SuppTable5B.csv.\
\>", "Text",ExpressionUUID->"ecc2ec44-12e7-4043-963b-e741566aeb05"],

Cell["\<\
(* Supplementary Table 5 - A: CSF proteins correlated with plasma \
CER.D19.1.18.0 in Q2 at p < 0.003
   (Spearman, one reagent at a time; requires fig4dP and fig4dHits from the \
Figure 4D - Revised
   cell). B: BioPlanet 2019 enrichment of those proteins against the SomaScan \
panel background,
   reproducing Enrichr's background mode: gene sets restricted to the \
background, one-sided
   hypergeometric test, Benjamini-Hochberg across terms with at least one \
overlapping gene.
   Exported as CSV; the display tables are rendered from these files by \
render_supp_tables.py.
   The CER.D19 permutation p quoted in the 5B caption comes from \
EnrichR_lists/perm/perm_screen.py
   and local_enrich_perm.py. *)
st5Dir = FileNameJoin[{NotebookDirectory[], \"EnrichR_lists\"}];
st5A = Dataset[Table[<|\"rank\" -> i, \"SeqId\" -> fig4dHits[[i]], \"gene\" \
-> (fig4dHits[[i]] /. SomascanLookup),
      \"rho\" -> fig4dP[fig4dHits[[i]]][\"Q2\"][\"cc\"], \"p\" -> \
fig4dP[fig4dHits[[i]]][\"Q2\"][\"pval\"],
      \"n\" -> fig4dP[fig4dHits[[i]]][\"Q2\"][\"n\"]|>, {i, \
Length[fig4dHits]}]];
Export[FileNameJoin[{NotebookDirectory[], \"SuppTable5A.csv\"}], st5A, \
\"CSV\"];
st5Bg = Union[DeleteCases[StringTrim /@ ReadList[FileNameJoin[{st5Dir, \
\"enrichr_background_somascan_panel_split.txt\"}], String], \"\"]];
st5Sets = Association@Cases[StringSplit[#, \"\\t\", All] & /@ \
ReadList[FileNameJoin[{st5Dir, \"perm\", \"libraries\", \
\"BioPlanet_2019.gmt\"}], String],
     f_ /; Length[f] >= 3 :> (f[[1]] -> \
Intersection[StringTrim[First[StringSplit[#, \",\"]]] & /@ Select[Drop[f, 2], \
StringTrim[#] =!= \"\" &], st5Bg])];
st5Sets = Select[st5Sets, Length[#] > 0 &];
st5Genes = Intersection[StringTrim /@ Flatten[StringSplit[#, \"|\"] & /@ \
(fig4dHits /. SomascanLookup)], st5Bg];
st5Rows = SortBy[Cases[KeyValueMap[{#1, Intersection[st5Genes, #2], \
Length[#2]} &, st5Sets], {_, g_, _} /; Length[g] > 0], 
   SurvivalFunction[HypergeometricDistribution[Length[st5Genes], #[[3]], \
Length[st5Bg]], Length[#[[2]]] - 1] &];
st5Pv = N[SurvivalFunction[HypergeometricDistribution[Length[st5Genes], \
#[[3]], Length[st5Bg]], Length[#[[2]]] - 1]] & /@ st5Rows;
st5Adj = Reverse[FoldList[Min, Reverse[MapIndexed[Min[1., #1 \
Length[st5Pv]/First[#2]] &, st5Pv]]]];
st5B = Dataset[MapThread[<|\"term\" -> #1[[1]], \"overlap\" -> \
Length[#1[[2]]], \"term size in background\" -> #1[[3]],
       \"p\" -> #2, \"BH-adj p\" -> #3, \"proteins\" -> StringRiffle[#1[[2]], \
\" \"]|> &, {st5Rows, st5Pv, st5Adj}]];
Export[FileNameJoin[{NotebookDirectory[], \"SuppTable5B.csv\"}], st5B, \
\"CSV\"];
Print[\"5A: \", Length[st5A], \" reagents, \", Length[st5Genes], \" genes in \
background (N = \", Length[st5Bg], \")\"];
Print[\"5B: \", Length[st5Rows], \" terms tested, \", Count[st5Adj, x_ /; x < \
0.05], \" with BH-adj p < 0.05\"];
st5B[1 ;; 6]\
\>", "Input",ExpressionUUID->"6b61d114-0ea0-4f26-b065-1bdde99b948d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Supplementary Table 6 - APOE e4 by ADAS13 cognitive quartile", \
"Subsection",ExpressionUUID->"972057ed-72d9-46ab-bded-5791826a4962"],

Cell["Exports SuppTable6.csv.", "Text",ExpressionUUID->"1451c73d-cf36-45dc-b91b-15c8c57903b1"],

Cell["\<\
(* Supplementary Table 6 - APOE e4 genotype by ADAS13 cognitive quartile, \
plasma-lipidomics x
   CSF-proteomics cohort (n = 599). Quartile boundaries are those of Figure \
1B (quartileBounds).
   Exported as CSV; the display table is rendered from this file by \
render_supp_tables.py. *)
st6Counts = Table[
   With[{a = Select[#[\"APOE4\"] & /@ Select[coreData, #[\"PROTEIN\"] && \
#[\"LIPID\"] && NumberQ[#[\"ADAS13\"]] && Between[#[\"ADAS13\"], \
quartileBounds[[q]]] &], NumberQ]},
    {Count[a, 0], Count[a, 1], Count[a, 2]}], {q, 4}];
st6 = Dataset[Table[With[{c = st6Counts[[q]], n = Total[st6Counts[[q]]]},
     <|\"Quartile\" -> \"Q\" <> ToString[q], \"N\" -> n, \"e4=0\" -> c[[1]], \
\"e4=1\" -> c[[2]], \"e4=2\" -> c[[3]],
      \"Carrier %\" -> N[Round[1000. (c[[2]] + c[[3]])/n]/10], \"e4 allele \
freq %\" -> N[Round[1000. (c[[2]] + 2 c[[3]])/(2 n)]/10],
      \"e4/e4 %\" -> N[Round[1000. c[[3]]/n]/10]|>], {q, 4}]];
st6Exp = Outer[Times, Total /@ st6Counts, Total[st6Counts]]/Total[st6Counts, \
2];
st6Chi2 = N@Total[Flatten[(st6Counts - st6Exp)^2/st6Exp]];
Print[\"n = \", Total[st6Counts, 2], \";  chi-square = \", \
NumberForm[st6Chi2, {4, 1}], \", 6 df, p = \", \
ScientificForm[SurvivalFunction[ChiSquareDistribution[6], st6Chi2], 2]];
Export[FileNameJoin[{NotebookDirectory[], \"SuppTable6.csv\"}], st6, \
\"CSV\"];
st6\
\>", "Input",ExpressionUUID->"1a27af01-bdfc-4548-ba46-b11e6ba539bc"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Supplementary Table 1 - cholesterol mass balance from published inputs\
\>", "Subsection",ExpressionUUID->"ffba3fed-8a66-461d-8c07-2a0e58b5c490"],

Cell["\<\
(* Supplementary Table 1 - cholesterol mass balance, computed from published \
inputs (Results, mass balance; Supp Table 1F lists sources).
   Load = whole-brain cholesterol (23 mg/g wet x 1400 g) x whole-brain \
atrophy rate (Leung 2013, ADNI: 0.63 / 1.01 / 1.41 %/yr).
   24S-OHC route = BBB flux 6.4 mg/day (Bjorkhem 1998) x 0.96 \
cholesterol:24S-OHC mass ratio x stage change in circulating 24S-OHC
   (MCI no change: 44.55 vs 44.69 ng/mL, p = 0.69, Liu 2016; AD 32.93/47.14, \
Roy 2019). Lipoprotein route = CSF cholesterol 4.0 mg/L (Turri 2023) x CSF \
production
   0.40 / 0.40 / 0.20 mL/min (Silverberg 2001). *)
mbPool = 23*1400;
mbAtrophy = {0.63, 1.01, 1.41}/100;
mbLoadC = mbPool mbAtrophy/365;
mbOHC = 6.4*0.96*{1, 1, 32.93/47.14};
mbLip = 4.0*{0.40, 0.40, 0.20}*1440/1000;
mbTot = mbOHC + mbLip;
mbShare = mbLoadC/mbTot;
mbTable = Dataset[Table[<|\"stage\" -> {\"CN\", \"MCI\", \"AD\"}[[i]], \"load\
\" -> mbLoadC[[i]], \"24S-OHC route\" -> mbOHC[[i]],
     \"lipoprotein route\" -> mbLip[[i]], \"total export\" -> mbTot[[i]], \
\"load / export\" -> mbShare[[i]]|>, {i, 3}]];
Print[\"load fold CN->MCI \", NumberForm[mbLoadC[[2]]/mbLoadC[[1]], 3], \", \
CN->AD \", NumberForm[mbLoadC[[3]]/mbLoadC[[1]], 3],
  \";  export fold CN->AD \", NumberForm[mbTot[[3]]/mbTot[[1]], 3], \";  \
load/export ratio fold \", NumberForm[mbShare[[3]]/mbShare[[1]], 3],
  \";  lipoprotein share of CN export \", NumberForm[mbLip[[1]]/mbTot[[1]], \
2]];
mbTable\
\>", "Input",ExpressionUUID->"50844a2d-974d-4cde-947f-2cb9e5d646c7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Supplementary Figure 1A/1B - Q1 quadrant composition and WMH by sex\
\>", "Subsection",ExpressionUUID->"9dbc5b0f-fbe7-4ae3-a3d9-e8f376d542a3"],

Cell["\<\
(* Supplementary Figure 1A/1B - composition of the Q1 quadrants and marginals \
defined by the Fig. 2B axes (A), and Q1 WMH by sex (B).
   Panel C is the \"Supp Fig 1C - CSF Analytes vs WMH Burden\" subsection \
under Figure 2. *)
sf1Fem[l_] := Count[l, x_ /; ToString[x] === \"Female\"];
sf1Half[x_, dp_] := Floor[x 10^dp + 0.5]/10^dp;
Quiet@DiceConfig[{\"Cog\" -> \"Q1\", \"Omics\" -> \"PL\"}, {\"Q1\", \"1\", \
\"2\"}];
sf1Rows = {\"TL\", \"TR\", \"BR\", \"BL\", \"L\", \"R\", \"T\", \"B\"};
sf1Dat = Table[Module[{dd = GetQuery[{\"Cog\" -> \"Q1\", \"Dice\" -> q}, \
coreData], g, sx, ag},
    g = Select[#[\"APOE4\"] & /@ dd, NumberQ]; sx = #[\"PTGENDER\"] & /@ dd; \
ag = Select[#[\"AGE\"] & /@ dd, NumberQ];
    {q, Length[dd], sf1Half[Mean[N@g], 2], sf1Half[100. \
sf1Fem[sx]/Length[sx], 1], sf1Half[Round[Median[N@ag], 0.01], 1]}], {q, \
sf1Rows}];
sf1Col = <|\"TL\" -> RGBColor[\"#EDBD64\"], \"TR\" -> GrayLevel[0.67], \"BR\" \
-> RGBColor[\"#828DCF\"], \"BL\" -> GrayLevel[0.85],
   \"L\" -> Lighter[Purple], \"R\" -> Purple, \"T\" -> Lighter[Green], \"B\" \
-> Darker[Green]|>;
sf1A = Grid[Prepend[Table[{Style[r[[1]], Bold], r[[2]], NumberForm[N@r[[3]], \
{3, 2}], NumberForm[N@r[[4]], {4, 1}], NumberForm[N@r[[5]], {4, 1}]}, {r, \
sf1Dat}],
    Style[#, Bold, FontSize -> 12] & /@ {\"Quadrant\", \"Subjects\", \"Mean \
APOE \\[Epsilon]4\\nallele copies\", \"Female %\", \"Median age\"}],
   Background -> {None, Prepend[Lighter[sf1Col[#[[1]]], 0.55] & /@ sf1Dat, \
GrayLevel[0.88]]},
   Dividers -> {{{GrayLevel[0.78]}}, {{GrayLevel[0.85]}}}, Alignment -> \
{{Left, Right, Right, Right, Right}, Center},
   Spacings -> {1.6, 1.0}, BaseStyle -> {FontFamily -> \"Helvetica Neue\", \
FontSize -> 12}];
sf1D = GetQuery[{\"Cog\" -> \"Q1\"}, coreData];
sf1P = Select[Transpose[{#[\"PTGENDER\"] & /@ sf1D, #[\"TOTAL_WMH\"] & /@ \
sf1D}], NumberQ[#[[2]]] &];
sf1F = N[#[[2]] & /@ Select[sf1P, ToString[#[[1]]] === \"Female\" &]];
sf1M = N[#[[2]] & /@ Select[sf1P, ToString[#[[1]]] === \"Male\" &]];
sf1KS = KolmogorovSmirnovTest[sf1F, sf1M];
Print[\"Q1 WMH by sex: F n = \", Length[sf1F], \", M n = \", Length[sf1M], \
\";  KS p = \", NumberForm[sf1KS, 3]];
sf1B = BoxWhiskerChart[{sf1F, sf1M}, \"Basic\",
   ChartStyle -> Directive[RGBColor[\"#EDBD64\"], \
EdgeForm[Directive[Darker[RGBColor[\"#EDBD64\"], 0.45], \
AbsoluteThickness[1.1]]]], BarSpacing -> 1.1,
   ChartLabels -> {Style[\"F (n=\" <> ToString[Length[sf1F]] <> \")\", \
FontSize -> 13], Style[\"M (n=\" <> ToString[Length[sf1M]] <> \")\", FontSize \
-> 13]},
   Frame -> True, FrameStyle -> GrayLevel[0.35], FrameLabel -> {None, \
Style[\"WMH\", FontSize -> 14]},
   FrameTicks -> {{Table[{v, Style[v, 12]}, {v, 0, 70, 10}], None}, \
{Automatic, None}},
   PlotLabel -> Style[\"ADNI ADAS13 Q1 WMH by Sex\", FontSize -> 14, \
GrayLevel[0.3]], PlotRange -> {{0.4, 2.6}, {-2, 72}},
   Epilog -> {{GrayLevel[0.35], AbsoluteThickness[1], Line[{{1, 62}, {2, \
62}}]}, Text[Style[ToString[Round[sf1KS, 0.01]], Italic, FontSize -> 13, \
Black], {1.5, 62}, {0, -1.2}]},
   ImageSize -> 420, AspectRatio -> 1.05];
Export[FileNameJoin[{NotebookDirectory[], \
\"SuppFig1A_Q1_quadrant_composition.png\"}], sf1A, ImageResolution -> 300];
Export[FileNameJoin[{NotebookDirectory[], \"SuppFig1B_Q1_WMH_by_sex.png\"}], \
sf1B, ImageResolution -> 300];
Row[{sf1A, Spacer[30], sf1B}]\
\>", "Input",ExpressionUUID->"5a5f4c7b-8b87-4deb-a788-295eeec2a6e7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Supplementary Figure 2 - matrix-level reorganization across quartiles\
\>", "Subsection",ExpressionUUID->"a1eeba10-13cc-480e-8235-676e338b7224"],

Cell["\<\
(* Supplementary Figure 2 - matrix-level reorganization of the lipid x \
CSF-protein correlation matrices across quartiles.
   Spearman correlation matrices (50 CSF MS proteins x 778 plasma lipids, \
tie-aware average ranks) within each ADAS13 quartile;
   Frobenius distance and matrix correlation for each quartile pair. The \
permutation test (1,000 label shuffles per pair, two-sided
   about the null mean) runs in R, which is ~3,400x faster here; the R source \
is held in this cell, written beside the notebook and
   run with Rscript. The observed metrics are computed natively first and \
checked against R's. Writes participant-level
   Tier_1_4_PL_data.csv locally for R (ADNI data: not for redistribution). *)
sf2Dir = NotebookDirectory[];
sf2QS = {\"Q1\", \"Q2\", \"Q3\", \"Q4\"};
sf2Recs = Association[# -> GetQuery[{\"Cog\" -> #, \"Omics\" -> \"PL\"}, \
coreData] & /@ sf2QS];
sf2Rank[x_List] := Module[{o = Ordering[x], k = 0, r},
   r = Flatten[(k += Length[#]; ConstantArray[N[k - (Length[#] - 1)/2], \
Length[#]]) & /@ Split[x[[o]]]];
   Normal@SparseArray[Thread[o -> r], Length[x]]];
sf2Spear[p_, l_] := Correlation[Transpose[sf2Rank /@ Transpose[p]], \
Transpose[sf2Rank /@ Transpose[l]]];
sf2R = Association[# -> sf2Spear[justProteins /. sf2Recs[#], justLipids /. \
sf2Recs[#]] & /@ sf2QS];
sf2Obs = Association[Table[StringRiffle[p, \"-\"] -> {Norm[sf2R[p[[1]]] - \
sf2R[p[[2]]], \"Frobenius\"], Correlation[Flatten[sf2R[p[[1]]]], \
Flatten[sf2R[p[[2]]]]]}, {p, Subsets[sf2QS, {2}]}]];
Print[\"observed (native): \", Round[sf2Obs, 0.001]];
Export[FileNameJoin[{sf2Dir, \"Tier_1_4_PL_data.csv\"}],
  Prepend[Flatten[Table[Join[{r[\"RID\"], q}, Lookup[r, justProteins], \
Lookup[r, justLipids]], {q, sf2QS}, {r, sf2Recs[q]}], 1], Join[{\"RID\", \
\"Cog\"}, justProteins, justLipids]], \"CSV\"];
Export[FileNameJoin[{sf2Dir, \"Tier_1_4_proteins.csv\"}], List /@ \
justProteins, \"CSV\"];
Export[FileNameJoin[{sf2Dir, \"Tier_1_4_lipids.csv\"}], List /@ justLipids, \
\"CSV\"];
sf2RScript = \"# \
=============================================================================
# Tier 1.4 - Composite Quartile-Reorganization Score: Permutation Test
#
# Reads per-subject PL data exported from the Mathematica notebook, \
recomputes
# observed Frobenius distance and matrix correlation for each of the 6 quartile
# pairs as a sanity check against Mathematica's values, then runs a pairwise
# label-shuffling permutation test (1000 reps per pair) to assign p-values.
#
# Writes a long-format results CSV that the Mathematica notebook reads back
# in the final cell.
# =============================================================================

set.seed(20260527)
N_PERM <- 1000

# -- Load data ----------------------------------------------------------------

data_dir <- \\\".\\\"  # script assumes it's run from the UH_Mathematica \
directory
plData    <- read.csv(file.path(data_dir, \\\"Tier_1_4_PL_data.csv\\\"),
                      check.names = FALSE, stringsAsFactors = FALSE)
proteins  <- read.csv(file.path(data_dir, \\\"Tier_1_4_proteins.csv\\\"),
                      header = FALSE, stringsAsFactors = FALSE)[, 1]
lipids    <- read.csv(file.path(data_dir, \\\"Tier_1_4_lipids.csv\\\"),
                      header = FALSE, stringsAsFactors = FALSE)[, 1]

cat(\\\"Loaded\\\", nrow(plData), \\\"subjects,\\\", length(proteins), \
\\\"proteins,\\\",
    length(lipids), \\\"lipids\\\\n\\\")

# Split into matrices for fast access
prot_mat   <- as.matrix(plData[, proteins])
lipid_mat  <- as.matrix(plData[, lipids])
quartile   <- plData$Cog

# -- Core metric functions ----------------------------------------------------

# Spearman correlation matrix between proteins (rows) and lipids (cols)
# for a given subject subset. Returns a length(proteins) x length(lipids) \
matrix.
make_cor_matrix <- function(rows) {
  cor(prot_mat[rows, , drop = FALSE],
      lipid_mat[rows, , drop = FALSE],
      method = \\\"spearman\\\")
}

frobenius <- function(rA, rB) sqrt(sum((rA - rB)^2))
matrix_corr <- function(rA, rB) cor(as.vector(rA), as.vector(rB))

# -- Observed metrics (sanity check against Mathematica) ----------------------

quartile_labels <- c(\\\"Q1\\\", \\\"Q2\\\", \\\"Q3\\\", \\\"Q4\\\")
quartile_pairs  <- list(c(\\\"Q1\\\",\\\"Q2\\\"), c(\\\"Q1\\\",\\\"Q3\\\"), \
c(\\\"Q1\\\",\\\"Q4\\\"),
                        c(\\\"Q2\\\",\\\"Q3\\\"), c(\\\"Q2\\\",\\\"Q4\\\"), \
c(\\\"Q3\\\",\\\"Q4\\\"))

# Precompute observed r-matrices for each quartile
obs_R <- lapply(quartile_labels, function(q) make_cor_matrix(which(quartile \
== q)))
names(obs_R) <- quartile_labels

cat(\\\"\\\\nObserved metrics (R reproduction of Mathematica values):\\\\n\\\")
for (pair in quartile_pairs) {
  fr  <- frobenius(obs_R[[pair[1]]], obs_R[[pair[2]]])
  mc  <- matrix_corr(obs_R[[pair[1]]], obs_R[[pair[2]]])
  cat(sprintf(\\\"  %s-%s: Frobenius = %.4f, MatrixCorr = %.4f\\\\n\\\",
              pair[1], pair[2], fr, mc))
}

# -- Permutation test ---------------------------------------------------------

# For each pair, pool subjects, shuffle labels N_PERM times, recompute metrics.
# Track null distribution and compute two-sided p-values.

results <- data.frame()

for (pair in quartile_pairs) {
  q1 <- pair[1]; q2 <- pair[2]
  cat(sprintf(\\\"\\\\nPermuting %s vs %s...\\\\n\\\", q1, q2))

  pool_idx <- which(quartile %in% c(q1, q2))
  n1       <- sum(quartile == q1)

  obs_fr <- frobenius(obs_R[[q1]], obs_R[[q2]])
  obs_mc <- matrix_corr(obs_R[[q1]], obs_R[[q2]])

  null_fr <- numeric(N_PERM)
  null_mc <- numeric(N_PERM)

  t0 <- Sys.time()
  for (i in seq_len(N_PERM)) {
    shuffled <- sample(pool_idx)
    g1 <- shuffled[seq_len(n1)]
    g2 <- shuffled[(n1 + 1):length(shuffled)]

    rA <- make_cor_matrix(g1)
    rB <- make_cor_matrix(g2)

    null_fr[i] <- frobenius(rA, rB)
    null_mc[i] <- matrix_corr(rA, rB)
  }
  elapsed <- as.numeric(difftime(Sys.time(), t0, units = \\\"secs\\\"))
  cat(sprintf(\\\"  done (%.1f sec, %.3f sec/iter)\\\\n\\\", elapsed, elapsed \
/ N_PERM))

  # Two-sided p-values: fraction of null values at least as extreme as observed
  p_fr <- mean(abs(null_fr - mean(null_fr)) >= abs(obs_fr - mean(null_fr)))
  p_mc <- mean(abs(null_mc - mean(null_mc)) >= abs(obs_mc - mean(null_mc)))

  results <- rbind(results, data.frame(
    pair        = paste(q1, q2, sep = \\\"-\\\"),
    metric      = c(\\\"frobenius\\\", \\\"matrixCorr\\\"),
    observed    = c(obs_fr, obs_mc),
    null_mean   = c(mean(null_fr), mean(null_mc)),
    null_sd     = c(sd(null_fr), sd(null_mc)),
    p_value     = c(p_fr, p_mc),
    n_perm      = N_PERM,
    stringsAsFactors = FALSE
  ))
}

# -- Write results ------------------------------------------------------------

out_file <- file.path(data_dir, \\\"Tier_1_4_permutation_results.csv\\\")
write.csv(results, out_file, row.names = FALSE)
cat(sprintf(\\\"\\\\nResults written to %s\\\\n\\\", out_file))
print(results, digits = 4)
\";
Export[FileNameJoin[{sf2Dir, \"Tier_1_4_permutation.R\"}], sf2RScript, \"Text\
\"];
sf2Rbin = SelectFirst[{\"/usr/local/bin/Rscript\", \
\"/opt/homebrew/bin/Rscript\", \
\"/Library/Frameworks/R.framework/Resources/bin/Rscript\", \"/usr/bin/Rscript\
\"}, FileExistsQ, \"Rscript\"];
sf2Run = RunProcess[{sf2Rbin, \"Tier_1_4_permutation.R\"}, ProcessDirectory \
-> sf2Dir];
Print[\"Rscript exit code: \", sf2Run[\"ExitCode\"]];
sf2Res = Import[FileNameJoin[{sf2Dir, \"Tier_1_4_permutation_results.csv\"}], \
\"Dataset\", HeaderLines -> 1];
sf2Get[i_, j_, metric_, col_] := Module[{pr = If[i < j, sf2QS[[i]] <> \"-\" \
<> sf2QS[[j]], sf2QS[[j]] <> \"-\" <> sf2QS[[i]]]},
   First[Normal[sf2Res[Select[#pair == pr && #metric == metric &], col]], \
Missing[]]];
sf2Frob = Table[If[i == j, 0., sf2Get[i, j, \"frobenius\", \"observed\"]], \
{i, 4}, {j, 4}];
sf2FrobP = Table[If[i == j, Missing[], sf2Get[i, j, \"frobenius\", \
\"p_value\"]], {i, 4}, {j, 4}];
sf2MC = Table[If[i == j, 1., sf2Get[i, j, \"matrixCorr\", \"observed\"]], {i, \
4}, {j, 4}];
Print[\"R vs native agree: \", And @@ Table[Abs[sf2Frob[[i, j]] - \
sf2Obs[sf2QS[[i]] <> \"-\" <> sf2QS[[j]]][[1]]] < 10^-3, {i, 4}, {j, i + 1, \
4}]];
Print[\"Q2-Q3 Frobenius \", NumberForm[sf2Frob[[2, 3]], 4], \", permutation p \
= \", sf2FrobP[[2, 3]], \";  matrix correlations of Q2 with Q1, Q3, Q4: \", \
Round[sf2MC[[2, {1, 3, 4}]], 0.01]];
sf2Ticks = {{Table[{i, sf2QS[[i]]}, {i, 4}], None}, {Table[{i, sf2QS[[i]]}, \
{i, 4}], None}};
sf2FrobPlot = MatrixPlot[sf2Frob, ColorFunction -> (Blend[{{0, \
GrayLevel[0.95]}, {0.5, RGBColor[\"#E7D297\"]}, {1.0, \
RGBColor[\"#DD6D00\"]}}, #] &),
   ColorFunctionScaling -> True, FrameTicks -> sf2Ticks, Mesh -> All, \
MeshStyle -> GrayLevel[0.7],
   Epilog -> Flatten[Table[Text[Style[If[i == j, \"NS\", \
Column[{NumberForm[sf2Frob[[i, j]], {4, 2}], Style[\"p=\" <> \
ToString[NumberForm[sf2FrobP[[i, j]], {3, 3}]], FontSize -> 9]}, Alignment -> \
Center]],
        FontSize -> 10, If[i == j, GrayLevel[0.5], Black]], {j, 5 - i}], {i, \
4}, {j, 4}], 1],
   PlotLabel -> Style[\"Frobenius distance ||R_i - R_j||_F\", FontSize -> 12, \
Bold], ImageSize -> 380];
sf2MCPlot = MatrixPlot[sf2MC, ColorFunction -> (Blend[{{0, RGBColor[\"#2155D5\
\"]}, {0.3, RGBColor[\"#9CBFDA\"]}, {1.0, GrayLevel[0.95]}}, #] &),
   ColorFunctionScaling -> True, FrameTicks -> sf2Ticks, Mesh -> All, \
MeshStyle -> GrayLevel[0.7],
   Epilog -> Flatten[Table[Text[Style[If[i == j, \"NS\", NumberForm[sf2MC[[i, \
j]], {3, 2}]], FontSize -> 11, If[i == j, GrayLevel[0.5], Black]], {j, 5 - \
i}], {i, 4}, {j, 4}], 1],
   PlotLabel -> Style[\"Matrix correlation between R_i and R_j\", FontSize -> \
12, Bold], ImageSize -> 380];
sf2Fig = GraphicsRow[{sf2FrobPlot, sf2MCPlot}, ImageSize -> 800, Spacings -> \
40];
Export[FileNameJoin[{sf2Dir, \"SuppFig2.png\"}], sf2Fig, ImageResolution -> \
300];
sf2Fig\
\>", "Input",ExpressionUUID->"676c2b79-0cb8-493f-b0d3-5d513469f8ba"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Statistical tests cited in the Results", "Section",ExpressionUUID->"8f2199c3-c135-44d4-89e2-dae4dbf8a01e"],

Cell["\<\
Requires Setup and the Somascan Support cells. Run the screen-helper cell \
first; the other three use it. The permutation test takes about 4 minutes, \
the lipid-anchored null about 3. Each writes a CSV to the notebook folder; \
Supplementary Table 5B's caption reads PermTest_CERD19_Q2.csv.\
\>", "Text",ExpressionUUID->"9f715f61-2e10-4f53-8168-1b2c629cab1b"],

Cell[CellGroupData[{

Cell["Screen and enrichment helpers", "Subsection",ExpressionUUID->"bd748ad5-8c7e-482f-8aa1-b7a35fb99ba4"],

Cell["\<\
(* Helpers for the plasma-lipid x CSF SomaScan screen and its \
panel-background enrichment, used by the
   permutation test, the lipid-anchored null and the Supplementary Table 5 \
numbers.
   Screen: Spearman correlation of one plasma lipid with every SOMAmer \
reagent, within an ADAS13 quartile,
   each reagent on the participants who have it (reagents with the same \
missingness pattern are
   processed together). Spearman p uses the t approximation, as CCPraw does; \
p < 0.003 is applied as
   |rho| > uhRcrit[n], which is the same cut.
   Enrichment: Enrichr background mode reproduced locally - gene sets \
restricted to the SomaScan panel
   background, one-sided hypergeometric test, Benjamini-Hochberg across terms \
with >= 1 overlapping gene. *)
uhThr = 0.003;
uhRank[v_List] := Module[{o = Ordering[v], lens, r = ConstantArray[0., \
Length[v]]},
   lens = Length /@ Split[v[[o]]];
   r[[o]] = Flatten[MapThread[ConstantArray, {Accumulate[lens] - (lens - \
1)/2., lens}]]; r];
uhZ[v_List] := (v - Mean[v])/Sqrt[Mean[(v - Mean[v])^2]];
(* uhZRank: standardized mid-ranks of a vector (compiled; Listable, so a \
matrix is ranked row by row) *)
uhZRank = Compile[{{v, _Real, 1}}, Module[{n = Length[v], o = Ordering[v], r \
= Table[0., {Length[v]}], i = 1, j, k, avg, mu, sd},
     While[i <= n, j = i; While[j < n && v[[o[[j + 1]]]] == v[[o[[i]]]], \
j++]; avg = (i + j)/2.;
      For[k = i, k <= j, k++, r[[o[[k]]]] = avg]; i = j + 1];
     mu = Total[r]/n; sd = Sqrt[Total[(r - mu)^2]/n]; (r - mu)/sd],
   RuntimeAttributes -> {Listable}, Parallelization -> True];
uhRcrit[n_] := uhRcrit[n] = With[{t = InverseCDF[StudentTDistribution[n - 2], \
1 - uhThr/2]}, t/Sqrt[n - 2 + t^2]];
uhSpearmanP[r_, n_] := 2 SurvivalFunction[StudentTDistribution[n - 2], Abs[r] \
Sqrt[(n - 2)/(1 - r^2)]];
uhSomaKeys = Keys[SomascanLookup];
uhSomaGenes = AssociationMap[StringTrim /@ StringSplit[ToString[# /. \
SomascanLookup], \"|\"] &, uhSomaKeys];

(* uhScreenSetup[q]: participants in quartile q with plasma lipids, and the \
reagent groups.
   Returns <|\"recs\", \"groups\" -> {{rows, cols, Ry, n}, ...}|>; Ry = \
standardized ranks, n x reagents. *)
uhScreenSetup[q_] := Module[{recs, Y, M, byMask},
   recs = Select[GetQuery[{\"Cog\" -> q}, coreData], \
NumberQ[#[\"CER.D19.1.18.0.\"]] &];
   Y = Lookup[#, uhSomaKeys] & /@ recs;
   M = Map[Boole[NumberQ[#]] &, Y, {2}];
   byMask = GroupBy[Range[Length[uhSomaKeys]], M[[All, #]] &];
   <|\"recs\" -> recs, \"groups\" -> DeleteCases[KeyValueMap[Function[{mask, \
cols},
        With[{rows = Flatten@Position[mask, 1]},
         If[Length[rows] < 10, Nothing,
          {rows, cols, Transpose[uhZRank[N[Transpose[Y[[rows, cols]]]]]], \
Length[rows]}]]], byMask], Nothing]|>];

(* uhScreen[setup, X]: X = B x participants matrix (one lipid vector per row, \
values for setup[\"recs\"]).
   Returns, for each row of X, the list of reagent SeqIds with p < 0.003. *)
uhScreen[setup_, X_] := Module[{hits = ConstantArray[{}, Length[X]], R, hit},
   Do[With[{rows = g[[1]], keys = uhSomaKeys[[g[[2]]]], Ry = g[[3]], n = \
g[[4]]},
     R = uhZRank[N[X[[All, rows]]]];
     hit = UnitStep[Abs[(R . Ry)/n] - uhRcrit[n]];
     hits = MapThread[Join, {hits, Pick[keys, #, 1] & /@ hit}]],
    {g, setup[\"groups\"]}];
   hits];

(* enrichment library *)
uhEnrichSetup[lib_: \"BioPlanet_2019\"] := Module[{dir = \
FileNameJoin[{NotebookDirectory[], \"EnrichR_lists\"}], bg, idx, sets},
   bg = Union[DeleteCases[StringTrim /@ ReadList[FileNameJoin[{dir, \
\"enrichr_background_somascan_panel_split.txt\"}], String], \"\"]];
   idx = AssociationThread[bg -> Range[Length[bg]]];
   sets = Association@Cases[StringSplit[#, \"\\t\", All] & /@ \
ReadList[FileNameJoin[{dir, \"perm\", \"libraries\", lib <> \".gmt\"}], \
String],
      f_ /; Length[f] >= 3 :> (f[[1]] -> DeleteMissing[Lookup[idx, \
Union[StringTrim[First[StringSplit[#, \",\"]]] & /@ Select[Drop[f, 2], \
StringTrim[#] =!= \"\" &]]]])];
   sets = Select[sets, Length[#] > 0 &];
   <|\"lib\" -> lib, \"bg\" -> bg, \"idx\" -> idx, \"terms\" -> Keys[sets], \
\"size\" -> Length /@ Values[sets],
     \"S\" -> SparseArray[Flatten[MapIndexed[Thread[Thread[{#1, First[#2]}] \
-> 1] &, Values[sets]]], {Length[bg], Length[sets]}]|>];
uhHG[n_, K_, k_, NN_] := uhHG[n, K, k, NN] = \
N[SurvivalFunction[HypergeometricDistribution[n, K, NN], k - 1]];
(* uhEnrich[lib, genes]: rows {term, overlap, size, p, BH-adj p} for terms \
with >= 1 overlapping gene, sorted by p *)
uhEnrich[lib_, genes_] := Module[{g = \
Union@DeleteMissing[Lookup[lib[\"idx\"], genes]], k, pos, n, NN = Length[lib[\
\"bg\"]], rows, pv, adj},
   n = Length[g]; If[n == 0, Return[{}]];
   k = Normal[SparseArray[Thread[g -> 1], NN] . lib[\"S\"]];
   pos = Flatten@Position[k, _?Positive];
   rows = SortBy[Table[{lib[\"terms\"][[t]], k[[t]], lib[\"size\"][[t]], \
uhHG[n, lib[\"size\"][[t]], k[[t]], NN]}, {t, pos}], Last];
   pv = rows[[All, 4]];
   adj = Reverse[FoldList[Min, Reverse[MapIndexed[Min[1., #1 \
Length[pv]/First[#2]] &, pv]]]];
   MapThread[Append, {rows, adj}]];
uhSterolQ[term_] := StringContainsQ[term, \
RegularExpression[\"(?i)bile|cholesterol|sterol|steroid|lipoprotein|oxysterol\
\"]];
uhBileBiosynQ[term_] := StringContainsQ[term, RegularExpression[\"(?i)bile \
acid\"]] && StringContainsQ[term, RegularExpression[\"(?i)biosynthesis\"]];
uhGenes[seqs_] := Union[Flatten[uhSomaGenes /@ seqs]];\
\>", "Input",ExpressionUUID->"f495c64f-35a1-440d-a841-ea027007b875"]
}, Open  ]],

Cell[CellGroupData[{

Cell["CER.D19 permutation test (Q2, 10,000 shuffles)", "Subsection",ExpressionUUID->"5545438e-ee4a-442a-9e35-a12a5e4fffcf"],

Cell["\<\
(* CER.D19 permutation test (Results: \"k of N permutations\"; Methods).
   CER.D19.1.18.0 is shuffled across Q2 participants, leaving the SomaScan \
matrix intact (so protein-protein
   correlation and missingness are preserved); the p < 0.003 reagent screen \
and the BioPlanet panel-background
   enrichment are rerun for each shuffle. The statistic is the strongest \
cholesterol, bile, sterol, steroid,
   lipoprotein or oxysterol term (BH-adjusted p); the permutation p is (1 + \
shuffles at least as strong)/(1 + 10,000).
   10,000 shuffles keep the Monte Carlo error small (about 4 minutes). \
Requires the screen-helper cell. Exports PermTest_CERD19_Q2.csv (one row per \
shuffle). *)
permSetup = uhScreenSetup[\"Q2\"];
permLib = uhEnrichSetup[\"BioPlanet_2019\"];
permX = #[\"CER.D19.1.18.0.\"] & /@ permSetup[\"recs\"];
permStat[seqs_] := Module[{e = uhEnrich[permLib, uhGenes[seqs]], st},
   st = Select[e, uhSterolQ[First[#]] &];
   <|\"reagents\" -> Length[seqs], \"min adj p\" -> If[e === {}, 1., e[[1, \
5]]], \"n sig terms\" -> Count[e[[All, 5]], x_ /; x < 0.05],
     \"sterol min adj p\" -> If[st === {}, 1., Min[st[[All, 5]]]]|>];
permObsHits = First[uhScreen[permSetup, {permX}]];
permObs = permStat[permObsHits];
Print[\"observed: \", permObs];
SeedRandom[20260930];
permB = 10000;
permNull = Join @@ Table[permStat /@ uhScreen[permSetup, \
Table[RandomSample[permX], {250}]], {permB/250}];
permK = Count[permNull, s_ /; s[\"sterol min adj p\"] <= permObs[\"sterol min \
adj p\"]];
Print[\"cholesterol/bile-acid term at least as strong in \", permK, \" of \", \
permB, \" shuffles; p = \", N[(1 + permK)/(1 + permB)]];
Print[\"count null: observed \", permObs[\"reagents\"], \" reagents; shuffle \
median \", Median[permNull[[All, \"reagents\"]]],
  \"; p = \", N[(1 + Count[permNull[[All, \"reagents\"]], c_ /; c >= permObs[\
\"reagents\"]])/(1 + permB)]];
Export[FileNameJoin[{NotebookDirectory[], \"PermTest_CERD19_Q2.csv\"}], \
Dataset[permNull], \"CSV\"];
<|\"observed\" -> permObs, \"k\" -> permK, \"p\" -> N[(1 + permK)/(1 + \
permB)]|>\
\>", "Input",ExpressionUUID->"085c416c-0dea-4408-a209-218077a983bf"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Lipid-anchored null (778 plasma lipids x 4 quartiles)", "Subsection",ExpressionUUID->"52cd8b94-ab51-4751-ae2b-404a9f4d18cf"],

Cell["\<\
(* Lipid-anchored null (Results: specificity of the bile-acid enrichment \
among the 778 plasma lipids; Methods).
   For each of the 778 plasma lipids (justLipids), within each ADAS13 \
quartile, the same p < 0.003 SomaScan screen
   and BioPlanet panel-background enrichment as for CER.D19. A bile-acid \
biosynthesis term is any term naming both
   \"bile acid\" and \"biosynthesis\"; significance is BH-adjusted p < 0.05. \
Requires the screen-helper cell.
   \"overlap\" in the printed tables is the number of screen proteins in the \
term; CER.D19 is the only lipid whose
   bile-acid term is carried by two proteins (AKR1D1, SLC27A2) rather than \
one. Exports LipidNull_byQuartile.csv (one row per lipid and quartile). *)
lnLib = uhEnrichSetup[\"BioPlanet_2019\"];
lnRows = Flatten[Table[
    Module[{setup = uhScreenSetup[q], X, hits},
     X = N@Table[r[lip], {lip, justLipids}, {r, setup[\"recs\"]}];
     hits = uhScreen[setup, X];
     MapThread[Function[{lip, h}, Module[{e = uhEnrich[lnLib, uhGenes[h]], \
st, ba, oh},
        st = Select[e, uhSterolQ[First[#]] &]; ba = Select[e, \
uhBileBiosynQ[First[#]] &];
        oh = Select[e, First[#] == \"Bile acid and bile salt biosynthesis via \
24-hydroxycholesterol\" &];
        <|\"quartile\" -> q, \"lipid\" -> lip, \"reagents\" -> Length[h],
         \"top term\" -> If[e === {}, \"\", e[[1, 1]]], \"top adj p\" -> If[e \
=== {}, 1., e[[1, 5]]],
         \"sterol class min adj p\" -> If[st === {}, 1., Min[st[[All, 5]]]],
         \"bile-acid biosynthesis min adj p\" -> If[ba === {}, 1., \
Min[ba[[All, 5]]]],
         \"bile-acid biosynthesis term\" -> If[ba === {}, \"\", \
First[MinimalBy[ba, Last]][[1]]],
         \"24-hydroxycholesterol term adj p\" -> If[oh === {}, 1., oh[[1, \
5]]]|>]], {justLipids, hits}]],
    {q, {\"Q1\", \"Q2\", \"Q3\", \"Q4\"}}], 1];
Export[FileNameJoin[{NotebookDirectory[], \"LipidNull_byQuartile.csv\"}], \
Dataset[lnRows], \"CSV\"];
lnSig[q_, key_] := SortBy[Select[lnRows, #[\"quartile\"] == q && #[key] < \
0.05 &], #[key] &];
Do[Print[q, \": lipids with a bile-acid biosynthesis term = \", \
{#[\"lipid\"], #[\"bile-acid biosynthesis min adj p\"]} & /@ lnSig[q, \
\"bile-acid biosynthesis min adj p\"],
   \";  via 24-hydroxycholesterol = \", #[\"lipid\"] & /@ lnSig[q, \
\"24-hydroxycholesterol term adj p\"]], {q, {\"Q1\", \"Q2\", \"Q3\", \"Q4\"}}];
lnQ2 = Select[lnRows, #[\"quartile\"] == \"Q2\" &];
Print[\"CER.D19.1.18.0 in Q2: reagents rank \", Count[lnQ2, r_ /; \
r[\"reagents\"] > 27] + 1, \" of \", Length[lnQ2],
  \"; sterol-class rank \", 1 + Count[lnQ2, r_ /; r[\"sterol class min adj \
p\"] < First[Select[lnQ2, #[\"lipid\"] == \"CER.D19.1.18.0.\" &]][\"sterol \
class min adj p\"]]];
Dataset[lnSig[\"Q2\", \"bile-acid biosynthesis min adj p\"]]\
\>", "Input",ExpressionUUID->"ca9c9f58-fea0-45b0-9d7a-50f603ce5d6f"],

Cell[CellGroupData[{

Cell["Odd-chain specificity of the CER.D19 bile-acid result", "Subsubsection",ExpressionUUID->"7fbec822-277a-4624-9da2-2fbf6074262b"],

Cell["\<\
Requires the lipid-anchored null cell above (LipidNull_byQuartile.csv). \
Exports OddChain_Q2.csv.\
\>", "Text",ExpressionUUID->"7b4df69b-b2ae-4279-9fbd-fa5df50da6a4"],

Cell["\<\
(* Odd-chain specificity of the CER.D19 bile-acid result (Results, screen \
paragraph). Reads the lipid-anchored null
   (LipidNull_byQuartile.csv, from the cell above). A species is odd-chain if \
any sphingoid base or acyl chain
   (13-25 carbons) or any summed composition (27-69 carbons) has an odd \
carbon number. Question: in Q2, does any
   odd-chain species other than CER.D19.1.18.0 reach a bile-acid biosynthesis \
term (adjusted p <= 0.05)?
   Exports OddChain_Q2.csv. *)
oddChainQ[name_String] := AnyTrue[FromDigits /@ StringCases[name,
     RegularExpression[\"(?<![0-9])([0-9]{1,2})\\\\.[0-9](?![0-9])\"] -> \"$1\
\"],
   OddQ[#] && (13 <= # <= 25 || 27 <= # <= 69) &];
ocTab = Import[FileNameJoin[{NotebookDirectory[], \
\"LipidNull_byQuartile.csv\"}], \"CSV\"];
ocHead = First[ocTab];
ocCol[name_] := First[Flatten[Position[ocHead, name]]];
ocQ2 = Select[Rest[ocTab], #[[ocCol[\"quartile\"]]] === \"Q2\" && \
oddChainQ[#[[ocCol[\"lipid\"]]]] &];
ocRows = SortBy[{#[[ocCol[\"lipid\"]]], #[[ocCol[\"reagents\"]]], N[#[[ocCol[\
\"bile-acid biosynthesis min adj p\"]]]]} & /@ ocQ2, Last];
ocOthers = Select[ocRows, #[[1]] =!= \"CER.D19.1.18.0.\" &];
Print[\"odd-chain species in Q2: \", Length[ocRows], \";  CER.D19.1.18.0 \
bile-acid adj p = \",
  ScientificForm[SelectFirst[ocRows, #[[1]] === \"CER.D19.1.18.0.\" &][[3]], \
2],
  \";  other odd-chain species: \", Length[ocOthers], \", reaching adj p <= \
0.05: \", Count[ocOthers, r_ /; r[[3]] <= 0.05],
  \";  smallest adj p among them: \", NumberForm[Min[ocOthers[[All, 3]]], 2], \
\" (\", First[ocOthers][[1]], \")\"];
Export[FileNameJoin[{NotebookDirectory[], \"OddChain_Q2.csv\"}], \
Prepend[ocRows, {\"lipid\", \"reagents\", \"bile-acid biosynthesis min adj \
p\"}]];
TableForm[Take[ocRows, 10], TableHeadings -> {None, {\"lipid\", \"reagents\", \
\"bile-acid min adj p\"}}]\
\>", "Input",ExpressionUUID->"426bc923-b89e-425f-8433-34a6449a1b22"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
SPTLC3 rs686548: CER.D19 regression and CSF protein correlations\
\>", "Subsection",ExpressionUUID->"c5b9d80b-36b4-4a94-bbf4-5453408a4ed4"],

Cell["\<\
(* SPTLC3 rs686548 (Results: \"rs686548, which raises plasma CER.D19 (beta = \
0.19 per allele on the log scale,
   p = 4 x 10^-15; n = 1,007), was associated with none of the 33 CSF \
proteins in the CNS-derived and blood-derived
   clusters in Q2\"; Methods, ADNI Genetics).
   (1) Natural-log CER.D19.1.18.0 regressed on rs686548 allele dosage in all \
genotyped participants with plasma
   lipids and an ADAS13 quartile, with quartile as a categorical covariate.
   (2) Within Q2, Spearman correlation (CCPraw) of genotype with each of the \
33 CSF MS proteins in the
   blood-derived clusters (Complement/HDL, Hemoglobin) and CNS-derived \
clusters (the other five).
   Exports SPTLC3_rs686548_CSF.csv. *)
spRecs = Flatten[Table[Map[Append[#, \"Cog\" -> q] &, \
Select[GetQuery[{\"Cog\" -> q}, coreData],
       NumberQ[#[\"CER.D19.1.18.0.\"]] && NumberQ[#[\"rs686548\"]] && \
#[\"rs686548\"] >= 0 &]], {q, {\"Q1\", \"Q2\", \"Q3\", \"Q4\"}}]];
spData = {#[\"rs686548\"], Boole[#[\"Cog\"] == \"Q2\"], Boole[#[\"Cog\"] == \
\"Q3\"], Boole[#[\"Cog\"] == \"Q4\"], Log[#[\"CER.D19.1.18.0.\"]]} & /@ spRecs;
spFit = Module[{dose, isQ2, isQ3, isQ4}, LinearModelFit[spData, {dose, isQ2, \
isQ3, isQ4}, {dose, isQ2, isQ3, isQ4}]];  (* intercept, dosage, Q2, Q3, Q4 *)
spBeta = spFit[\"ParameterTableEntries\"][[2]];
Print[\"n = \", Length[spData], \";  beta = \", NumberForm[spBeta[[1]], 3], \
\" per allele (SE \", NumberForm[spBeta[[2]], 2],
  \"), p = \", ScientificForm[spBeta[[4]], 2], \";  +\", NumberForm[100 \
(Exp[spBeta[[1]]] - 1), 2], \"% per allele\"];
spClass = Join[Thread[Flatten[proteinClusters[[1 ;; 2]]] -> \
\"blood-derived\"], Thread[Flatten[proteinClusters[[3 ;;]]] -> \
\"CNS-derived\"]];
spQ2 = GetQuery[{\"Cog\" -> \"Q2\", \"Omics\" -> \"PL\"}, coreData];
spCSF = Dataset[Table[With[{pd = Select[{\"rs686548\", First[pc]} /. spQ2, \
VectorQ[#, NumberQ] && #[[1]] >= 0 &]},
     With[{c = CCPraw[pd]}, <|\"protein\" -> First[pc], \"cluster\" -> \
Last[pc], \"n\" -> Length[pd], \"rho\" -> c[\"cc\"], \"p\" -> \
c[\"pval\"]|>]], {pc, spClass}]];
Print[\"Q2 genotyped with CSF MS proteins: n = \", MinMax[Normal[spCSF[All, \
\"n\"]]]];
Do[With[{s = Normal[spCSF[Select[#cluster == cl &]]]},
   Print[cl, \": \", Count[s, r_ /; r[\"p\"] < 0.05], \" of \", Length[s], \" \
at p < 0.05; median |rho| = \", NumberForm[Median[Abs[s[[All, \"rho\"]]]], \
2]]], {cl, {\"CNS-derived\", \"blood-derived\"}}];
Export[FileNameJoin[{NotebookDirectory[], \"SPTLC3_rs686548_CSF.csv\"}], \
spCSF, \"CSV\"];
spCSF\
\>", "Input",ExpressionUUID->"055bab37-ddad-4705-ac33-40df229147ef"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Bile-acid proteins (AKR1D1, SLC27A2): CSF albumin and SPTLC3 checks\
\>", "Subsection",ExpressionUUID->"748757e6-ca9c-49b6-a80d-010ebe037831"],

Cell["\<\
(* Bile-acid proteins: CSF albumin and SPTLC3 checks (Supplemental Methods: \
\"The two proteins carrying the bile-acid
   enrichment did not track CSF albumin in Q2, and their associations with \
CER.D19.1.18.0 were unchanged with CSF
   albumin held fixed. rs686548, which raises plasma CER.D19.1.18.0, was not \
associated with AKR1D1\").
   For the two SOMAmer reagents carrying the Q2 bile-acid term (AKR1D1 \
X18398.1, SLC27A2 X9045.3), in each quartile:
   (1) Spearman correlation with CER.D19.1.18.0 (CCPraw);
   (2) the same correlation with CSF albumin (SomaScan X18380.78) held fixed: \
partial Spearman from mid-rank residuals, t with n - 3 df;
   (3) each protein against CSF albumin (CCPraw);
   (4) each protein against rs686548 dosage (CCPraw).
   Exports BileAcid_Albumin_SPTLC3.csv. *)
baSeq = <|\"AKR1D1\" -> \"X18398.1\", \"SLC27A2\" -> \"X9045.3\"|>;
baAlb = \"X18380.78\";
baQd = AssociationMap[GetQuery[{\"Cog\" -> #}, coreData] &, {\"Q1\", \"Q2\", \
\"Q3\", \"Q4\"}];
baSel[keys_, d_] := Select[keys /. d, VectorQ[#, NumberQ] &];
baMid[v_] := With[{s = Sort[v]}, Mean[Flatten[Position[s, #]]] & /@ v];
baRes[a_, z_] := (a - Mean[a]) - Covariance[a, z]/Variance[z] (z - Mean[z]);
baPartial[t_] := Module[{rk = N[baMid /@ Transpose[t]], n = Length[t], r},
   r = Correlation[baRes[rk[[1]], rk[[3]]], baRes[rk[[2]], rk[[3]]]];
   <|\"cc\" -> r, \"pval\" -> 2 (1 - CDF[StudentTDistribution[n - 3], Abs[r \
Sqrt[(n - 3)/(1 - r^2)]]])|>];
baRow[q_, g_] := Module[{d = baQd[q], s = baSeq[g], raw, par, alb, gen},
   raw = baSel[{\"CER.D19.1.18.0.\", s}, d];
   par = baSel[{\"CER.D19.1.18.0.\", s, baAlb}, d];
   alb = baSel[{s, baAlb}, d];
   gen = Select[baSel[{\"rs686548\", s}, d], #[[1]] >= 0 &];
   <|\"quartile\" -> q, \"protein\" -> g, \"n\" -> Length[raw], \"rho\" -> \
CCPraw[raw][\"cc\"], \"p\" -> CCPraw[raw][\"pval\"],
     \"rhoAlbFixed\" -> baPartial[par][\"cc\"], \"pAlbFixed\" -> \
baPartial[par][\"pval\"],
     \"rhoVsAlb\" -> CCPraw[alb][\"cc\"], \"pVsAlb\" -> \
CCPraw[alb][\"pval\"],
     \"nGenotype\" -> Length[gen], \"rhoVsGenotype\" -> CCPraw[gen][\"cc\"], \
\"pVsGenotype\" -> CCPraw[gen][\"pval\"]|>];
baCheck = Dataset[Flatten[Table[baRow[q, g], {q, Keys[baQd]}, {g, \
Keys[baSeq]}]]];
Export[FileNameJoin[{NotebookDirectory[], \"BileAcid_Albumin_SPTLC3.csv\"}], \
baCheck, \"CSV\"];
baCheck\
\>", "Input",ExpressionUUID->"a1c98975-7fbc-4423-98bb-f8dc63e6a09b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Figure 6 progression models (Cox; predictions stated in the cell header)\
\>", "Subsection",ExpressionUUID->"cbeacb87-85ec-4cad-83b1-102e89352a84"],

Cell["\<\
Requires the KM Functions (DCogKMprep). Exports Fig6_Cox_models.csv.\
\>", "Text",ExpressionUUID->"9e1e099b-6706-476b-aa0b-3cb35b7d877e"],

Cell["\<\
(* Progression models for Figure 6 (review points 1 and 8). Written 1 Oct \
2026, before any model was run.

   Predictions stated in advance:
   - The protein axis measures current state; the lipid axis measures \
reserve. With the protein axis held
     fixed, the lipid axis should change progression.
   - Q2 (LDHB x CER.D19.1.18.0, +8 ADAS13 points): higher LDHB -> faster \
progression (HR > 1); higher CER.D19,
     at fixed LDHB, -> slower progression (HR < 1, or a protective LDHB x \
CER.D19 interaction).
   - Q3 (astrogliosis PC1 x phospholipid/plasmalogen 22:6 PC1, +6 points): \
higher astrogliosis -> faster
     progression; higher plasmalogen PC1, at fixed astrogliosis, -> slower \
progression.
   - Agreed fallback: if the Q3 plasmalogen term runs the wrong way (Fig. 6B: \
TR progresses fastest), the Q3
     lipid claim rests on the XL-HDL, cholesteryl-ester and compartment \
lines, not on survival.

   Amyloid is not modeled: CSF Abeta does not track cognitive score, and the \
model does not tie progression to it.
   Design (events are the limit: about 26 in Q2, 59 in Q3; covariates are \
complete):
   - Events: the Fig. 6 definition (DCogKMprep; baseline ADAS13 + 8 in Q2, + \
6 in Q3). Thresholds were chosen
     because single-visit ADAS13 changes are noisy.
   - Model A: protein axis + lipid axis + interaction, both axes z-scored \
within quartile (CER.D19 and LDHB
     log-transformed first). Three terms.
   - Model B: A + one prognostic score (age, sex, education, APOE e4 alleles, \
baseline ADAS13), with weights
     estimated by Cox regression in the same quartile's participants who have \
plasma lipids but no CSF MS
     proteomics. It costs one degree of freedom and is not fitted to the \
analysis sample.
   - Threshold sensitivity: Model A at +/- 2 ADAS13 points.
   - Quadrants: HR versus BR from a Cox model with quadrant indicators (score \
test = log-rank).
   Exports Fig6_Cox_models.csv. *)
coxQ = <|\"Q2\" -> <|\"x\" -> \"LDHB\", \"y\" -> \"CER.D19.1.18.0.\", \
\"dCog\" -> 8, \"log\" -> True, \"axes\" -> {\"LDHB\", \
\"CER.D19.1.18.0.\"}|>,
   \"Q3\" -> <|\"x\" -> \"Q3P3L7_P\", \"y\" -> \"Q3P3L7_L\", \"dCog\" -> 6, \
\"log\" -> False, \"axes\" -> {\"Q3\", \"3\", \"7\"}|>|>;
coxZ[v_] := (v - Mean[v])/StandardDeviation[v];
coxEvents[recs_, dCog_] := Association[#[\"RID\"] -> {#[\"time\"], 1 - \
#[\"status\"]} & /@ DCogKMprep[#[\"RID\"] & /@ recs, dCog, \"x\"]];
coxBase[r_] := {r[\"AGE\"], Boole[ToString[r[\"PTGENDER\"]] == \"Female\"], \
r[\"PTEDUCAT\"], r[\"APOE4\"], r[\"ADAS13\"]};
coxRow[name_, m_, labels_] := MapThread[<|\"model\" -> name, \"term\" -> #1, \
\"HR\" -> Exp[#2[[1]]],
     \"CI low\" -> Exp[#2[[1]] - 1.96 #2[[2]]], \"CI high\" -> Exp[#2[[1]] + \
1.96 #2[[2]]], \"p\" -> #2[[6]]|> &, {labels, m[\"ParameterTableEntries\"]}];
coxFit[X_, ev_, labels_] := Module[{v = Array[Unique[\"c\"] &, \
Length[First[X]]]}, CoxModelFit[{X, EventData @@ Transpose[ev]}, v, v]];
coxOut = {};
Do[Module[{s = coxQ[q], recs, ext, ev, evExt, xs, ys, base, wExt, ps, mA, mB, \
quad},
   recs = GetQuery[{\"Cog\" -> q, \"Omics\" -> \"PL\"}, coreData];
   If[q == \"Q3\", DiceConfig[{\"Cog\" -> q, \"Omics\" -> \"PL\"}, \
s[\"axes\"]]; DiceConfig[{\"Cog\" -> q, \"Omics\" -> \"PL\"}, s[\"axes\"]]];
   ext = Select[GetQuery[{\"Cog\" -> q, \"Omics\" -> \"L\"}, coreData], ! \
MemberQ[#[\"RID\"] & /@ recs, #[\"RID\"]] &];
   ext = Select[ext, VectorQ[coxBase[#], NumberQ] &];
   ev = Lookup[coxEvents[recs, s[\"dCog\"]], #[\"RID\"] & /@ recs];
   evExt = Lookup[coxEvents[ext, s[\"dCog\"]], #[\"RID\"] & /@ ext];
   xs = coxZ[If[s[\"log\"], Log[#], #] &[N[#[s[\"x\"]] & /@ recs]]];
   ys = coxZ[If[s[\"log\"], Log[#], #] &[N[#[s[\"y\"]] & /@ recs]]];
   (* prognostic score: weights from the participants without CSF proteomics *)
   wExt = coxFit[N[coxBase /@ ext], evExt, {}][\"BestFitParameters\"];
   ps = coxZ[N[coxBase /@ recs] . wExt];
   Print[q, \": n = \", Length[recs], \", events = \", Count[ev[[All, 2]], \
0], \"; prognostic score from n = \", Length[ext], \" (\", Count[evExt[[All, \
2]], 0], \" events)\"];
   mA = coxFit[Transpose[{xs, ys, xs ys}], ev, {}];
   mB = coxFit[Transpose[{xs, ys, xs ys, ps}], ev, {}];
   coxOut = Join[coxOut,
     Append[#, \"quartile\" -> q] & /@ Join[
       coxRow[\"A\", mA, {\"protein axis\", \"lipid axis\", \"protein x lipid\
\"}],
       coxRow[\"B\", mB, {\"protein axis\", \"lipid axis\", \"protein x lipid\
\", \"prognostic score\"}],
       Flatten@Table[With[{evd = Lookup[coxEvents[recs, s[\"dCog\"] + d], \
#[\"RID\"] & /@ recs]},
          coxRow[\"A, +\" <> ToString[s[\"dCog\"] + d] <> \" points\", \
coxFit[Transpose[{xs, ys, xs ys}], evd, {}], {\"protein axis\", \"lipid \
axis\", \"protein x lipid\"}]], {d, {-2, 2}}]]];
   (* quadrants versus BR *)
   quad = Table[Which[ys[[i]] >= Median[ys] && xs[[i]] < Median[xs], \"TL\", \
ys[[i]] >= Median[ys], \"TR\", xs[[i]] < Median[xs], \"BL\", True, \"BR\"], \
{i, Length[recs]}];
   If[q == \"Q3\", quad = Table[Which[recs[[i]][s[\"y\"]] >= 0 && \
recs[[i]][s[\"x\"]] < 0, \"TL\", recs[[i]][s[\"y\"]] >= 0, \"TR\", \
recs[[i]][s[\"x\"]] < 0, \"BL\", True, \"BR\"], {i, Length[recs]}]];
   Print[\"   quadrant n (events): \", Table[k -> {Count[quad, k], \
Count[Pick[ev[[All, 2]], quad, k], 0]}, {k, {\"TL\", \"TR\", \"BR\", \
\"BL\"}}]];
   coxOut = Join[coxOut, Append[#, \"quartile\" -> q] & /@ coxRow[\"quadrants \
vs BR\", coxFit[Table[Boole[quad[[i]] == k], {i, Length[quad]}, {k, {\"TL\", \
\"TR\", \"BL\"}}], ev, {}], {\"TL\", \"TR\", \"BL\"}]];
   ], {q, {\"Q2\", \"Q3\"}}];
Export[FileNameJoin[{NotebookDirectory[], \"Fig6_Cox_models.csv\"}], \
Dataset[coxOut], \"CSV\"];
Dataset[coxOut]\
\>", "Input",ExpressionUUID->"aae5ceaf-fe2b-4a16-ac54-daba3db57952"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Compartment control: permutation test of the Q1-to-Q3 switch", \
"Subsection",ExpressionUUID->"c84db613-c3ab-4829-bafe-97b3cac60637"],

Cell["\<\
Requires the screen-helper cell (uhZRank, uhSpearmanP). Exports \
CompartmentControl.csv.\
\>", "Text",ExpressionUUID->"e3a489ab-8867-4101-9c58-dfce32cbd3cd"],

Cell["\<\
(* Compartment control, formal test (Results: the Q1 lipid axis couples to \
the blood-derived CSF clusters and
   the Q3 axis to the CNS-derived clusters).
   Cluster coupling is the Spearman correlation of the lipid-cluster PC1 with \
each protein-cluster PC1 within
   the quartile (the clusterPvals of Figure 2A). Compartment preference for a \
lipid axis l:
     C(l) = mean |z| over the two blood-derived clusters (Complement/HDL, \
Hemoglobin)
          - mean |z| over the five CNS-derived clusters,  z = ArcTanh[rho].
   The switch is Delta = C_Q1(L2) - C_Q3(L7); prediction Delta > 0 \
(blood-weighted at Q1, CNS-weighted at Q3).
   Null: the 10 lipid-cluster PC1s are shuffled together across participants \
within each quartile (protein PC1s
   untouched, so lipid-lipid and protein-protein structure are kept), 10,000 \
times. Because the Q1 and Q3 axes
   were chosen as the strongest couplings, each shuffle takes the most \
extreme axis in each quartile:
   max_l C_Q1(l) - min_l C_Q3(l). p = (1 + shuffles >= observed)/(1 + \
10,000).
   Also: the Q3 axis couplings to the CNS-derived clusters with CSF albumin \
(ALBU) partialled out.
   Exports CompartmentControl.csv. *)
ccBlood = {1, 2}; ccCNS = {3, 4, 5, 6, 7};
ccData[q_] := Module[{d = Select[GetQuery[{\"Cog\" -> q, \"Omics\" -> \
\"PL\"}, coreData],
      VectorQ[Join[Table[#[q <> \"P\" <> ToString[p] <> \"L1_P\"], {p, 7}], \
Table[#[q <> \"P1L\" <> ToString[l] <> \"_L\"], {l, 10}]], NumberQ] &]},
   <|\"P\" -> N@Table[r[q <> \"P\" <> ToString[p] <> \"L1_P\"], {r, d}, {p, \
7}], \"L\" -> N@Table[r[q <> \"P1L\" <> ToString[l] <> \"_L\"], {r, d}, {l, \
10}],
     \"ALB\" -> N[#[\"ALBU\"] & /@ d], \"n\" -> Length[d]|>];
ccRankZ[m_] := Transpose[uhZRank[Transpose[m]]];
ccRho[L_, P_] := (Transpose[ccRankZ[L]] . ccRankZ[P])/Length[L];      (* 10 x \
7 Spearman matrix *)
ccC[rho_] := With[{z = Abs[ArcTanh[Clip[rho, {-0.999999, 0.999999}]]]}, Mean \
/@ Transpose[Transpose[z][[ccBlood]]] - Mean /@ \
Transpose[Transpose[z][[ccCNS]]]];
cc1 = ccData[\"Q1\"]; cc3 = ccData[\"Q3\"];
ccObs1 = ccC[ccRho[cc1[\"L\"], cc1[\"P\"]]]; ccObs3 = ccC[ccRho[cc3[\"L\"], \
cc3[\"P\"]]];
ccDelta = ccObs1[[2]] - ccObs3[[7]];
SeedRandom[20261001];
ccB = 10000;
ccP1 = ccRankZ[cc1[\"P\"]]; ccP3 = ccRankZ[cc3[\"P\"]]; ccL1 = \
ccRankZ[cc1[\"L\"]]; ccL3 = ccRankZ[cc3[\"L\"]];
ccNull = Table[
   Max[ccC[(Transpose[ccL1[[RandomSample[Range[cc1[\"n\"]]]]]] . \
ccP1)/cc1[\"n\"]]] -
    Min[ccC[(Transpose[ccL3[[RandomSample[Range[cc3[\"n\"]]]]]] . \
ccP3)/cc3[\"n\"]]], {ccB}];
ccPval = N[(1 + Count[ccNull, x_ /; x >= ccDelta])/(1 + ccB)];
Print[\"Q1 axis (L2): C = \", NumberForm[ccObs1[[2]], 3], \";  Q3 axis (L7): \
C = \", NumberForm[ccObs3[[7]], 3], \";  Delta = \", NumberForm[ccDelta, 3]];
Print[\"selection-corrected null: median \", NumberForm[Median[ccNull], 3], \
\", 95th percentile \", NumberForm[Quantile[ccNull, 0.95], 3], \";  p = \", \
ccPval];
(* albumin partialled: Q3 axis vs CNS-derived clusters *)
ccPartial[x_, y_, z_] := Module[{rx = uhZRank[x], ry = uhZRank[y], rz = \
uhZRank[z], ex, ey, r, n = Length[x]},
   ex = rx - (rx . rz/n) rz; ey = ry - (ry . rz/n) rz; r = Correlation[ex, ey];
   {r, 2 SurvivalFunction[StudentTDistribution[n - 3], Abs[r] Sqrt[(n - 3)/(1 \
- r^2)]]}];
ccAlb = Table[With[{raw = ccRho[cc3[\"L\"][[All, {7}]], cc3[\"P\"][[All, \
{p}]]][[1, 1]], part = ccPartial[cc3[\"L\"][[All, 7]], cc3[\"P\"][[All, p]], \
cc3[\"ALB\"]]},
    <|\"cluster\" -> proteinClusterLabels[[p]], \"rho\" -> raw, \"p\" -> \
uhSpearmanP[raw, cc3[\"n\"]], \"rho | albumin\" -> part[[1]], \"p | albumin\" \
-> part[[2]]|>], {p, 7}];
Print[\"Q3 axis, albumin partialled: \", Column[{#[\"cluster\"], \
NumberForm[#[\"rho\"], 2], NumberForm[#[\"p\"], 2], NumberForm[#[\"rho | \
albumin\"], 2], NumberForm[#[\"p | albumin\"], 2]} & /@ ccAlb]];
Export[FileNameJoin[{NotebookDirectory[], \"CompartmentControl.csv\"}],
  Dataset[Join[{<|\"item\" -> \"Delta (Q1 L2 minus Q3 L7)\", \"value\" -> \
ccDelta, \"p\" -> ccPval|>},
    Table[<|\"item\" -> \"Q3 L7 vs \" <> a[\"cluster\"], \"value\" -> a[\"rho\
\"], \"p\" -> a[\"p\"], \"rho | albumin\" -> a[\"rho | albumin\"], \"p | \
albumin\" -> a[\"p | albumin\"]|>, {a, ccAlb}]]], \"CSV\"];
<|\"Delta\" -> ccDelta, \"p\" -> ccPval|>\
\>", "Input",ExpressionUUID->"9f415ce3-fcff-419d-a661-dc10fada3e3c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Figure 1E sign change: collection-date check", "Subsection",ExpressionUUID->"80fb1d2b-5fa9-44e6-b0fa-e039be552b4c"],

Cell["\<\
Requires the screen-helper cell. Exports Fig1E_BatchCheck.csv.\
\>", "Text",ExpressionUUID->"61d9c0e4-bd90-441d-b945-2cb1b31e4d44"],

Cell["\<\
(* Figure 1E sign change: technical check. Across the 778 x 50 plasma-lipid x \
CSF-protein matrix, Q2 correlations
   are mostly positive and Q3 mostly negative. A sign change across the whole \
matrix could come from a global
   technical factor. Plate and batch identifiers are not part of the merged \
dataset; sample collection date
   (baseline EXAMDATE, which sets storage time before assay) is, so this cell \
tests it.
   (1) Fraction of positive correlations and median rho per quartile (Fig. 1E).
   (2) Collection date by quartile (Kolmogorov-Smirnov, Q2 vs Q3) and its \
correlation with the global lipid and
       protein levels (mean of rank z-scores per participant).
   (3) The matrix recomputed after regressing collection date (linear and \
quadratic) out of every lipid and
       protein rank within quartile; if date drives the sign change, it \
disappears.
   Exports Fig1E_BatchCheck.csv. *)
bcQs = {\"Q1\", \"Q2\", \"Q3\", \"Q4\"};
bcYears[r_] := N[DayCount[DateObject[{2010, 1, 1}], r[\"EXAMDATE\"]]/365.25];
bcRows = Table[Module[{d = GetQuery[{\"Cog\" -> q, \"Omics\" -> \"PL\"}, \
coreData], L, P, t, Lz, Pz, rho, G, Xt, resid, rhoR},
    L = N@Table[If[NumberQ[r[k]], r[k], Median[Select[#[k] & /@ d, \
NumberQ]]], {r, d}, {k, justLipids}];
    P = N@Table[If[NumberQ[r[k]], r[k], Median[Select[#[k] & /@ d, \
NumberQ]]], {r, d}, {k, justProteins}];
    t = bcYears /@ d;
    Lz = Transpose[uhZRank[Transpose[L]]]; Pz = \
Transpose[uhZRank[Transpose[P]]];
    rho = Flatten[(Transpose[Lz] . Pz)/Length[d]];
    G = {Mean /@ Lz, Mean /@ Pz};
    Xt = Transpose[{ConstantArray[1., Length[t]], t - Mean[t], (t - \
Mean[t])^2}];
    resid[m_] := m - Xt . LeastSquares[Xt, m];
    rhoR = Flatten[((uhZRank /@ Transpose[resid[Lz]]) . Transpose[uhZRank /@ \
Transpose[resid[Pz]]])/Length[d]];
    <|\"quartile\" -> q, \"n\" -> Length[d], \"median collection year\" -> \
2010 + Median[t],
     \"fraction positive\" -> N@Mean[UnitStep[rho]], \"median rho\" -> \
Median[rho],
     \"global lipid vs global protein rho\" -> CCPraw[Transpose[G]][\"cc\"],
     \"date vs global lipid rho\" -> CCPraw[Transpose[{t, G[[1]]}]][\"cc\"], \
\"date vs global protein rho\" -> CCPraw[Transpose[{t, G[[2]]}]][\"cc\"],
     \"fraction positive, date removed\" -> N@Mean[UnitStep[rhoR]], \"median \
rho, date removed\" -> Median[rhoR], \"years\" -> t|>], {q, bcQs}];
bcKS = KolmogorovSmirnovTest[bcRows[[2, \"years\"]], bcRows[[3, \"years\"]]];
Print[\"collection date Q2 vs Q3: KS p = \", NumberForm[bcKS, 2]];
Export[FileNameJoin[{NotebookDirectory[], \"Fig1E_BatchCheck.csv\"}], \
Dataset[KeyDrop[#, \"years\"] & /@ bcRows], \"CSV\"];
Dataset[KeyDrop[#, \"years\"] & /@ bcRows]\
\>", "Input",ExpressionUUID->"d0f4c4b5-bd58-49a4-ace8-f8724464f002"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Li and Ji effective number of tests for the genotype screen", \
"Subsection",ExpressionUUID->"e83f8241-55ea-49fe-8e3b-f2ff8eed22cb"],

Cell["\<\
(* Effective number of independent tests for the CER.D19 genotype screen \
(Methods, ADNI Genetics), Li & Ji 2005 (Heredity).
   Q2 participants with plasma lipids and genotypes; the screen's lead-SNP \
panel (fulcrumGenKeys); no-call (-1) treated as missing;
   pairwise-complete Pearson correlation of allele-copy counts; Meff = sum \
over eigenvalues of I(|l| >= 1) + (|l| - Floor[|l|]). *)
ljRecs = Select[GetQuery[{\"Cog\" -> \"Q2\", \"Omics\" -> \"L\"}, coreData], \
AnyTrue[Lookup[#, fulcrumGenKeys, Missing[]], NumberQ] &];
ljG = Table[With[{v = Lookup[r, s, Missing[]]}, If[NumberQ[v] && v >= 0, \
N[v], Missing[]]], {s, fulcrumGenKeys}, {r, ljRecs}];
ljKeep = Select[Range[Length[fulcrumGenKeys]], \
Length[Union[DeleteMissing[ljG[[#]]]]] > 1 &];
ljCor[a_, b_] := Module[{ok = Select[Range[Length[a]], NumberQ[a[[#]]] && \
NumberQ[b[[#]]] &]},
   If[Length[ok] < 3 || Variance[a[[ok]]] == 0 || Variance[b[[ok]]] == 0, 0., \
Correlation[a[[ok]], b[[ok]]]]];
ljR = Table[If[i == j, 1., ljCor[ljG[[i]], ljG[[j]]]], {i, ljKeep}, {j, \
ljKeep}];
ljEig = Abs[Eigenvalues[(ljR + Transpose[ljR])/2]];
ljMeff = Total[Boole[# >= 1] + (# - Floor[#]) & /@ ljEig];
Print[\"Q2 genotyped: \", Length[ljRecs], \";  lead SNPs: \", \
Length[fulcrumGenKeys], \" (\", Length[ljKeep], \" polymorphic);  Li & Ji \
Meff = \", NumberForm[ljMeff, {5, 1}]];\
\>", "Input",ExpressionUUID->"46c67a36-9b33-4786-abe7-c2eeaa727c10"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Supplementary Tables 3 and 4 - Q1 quadrant SomaScan differential abundance \
and enrichment\
\>", "Subsection",ExpressionUUID->"e3007b7c-b356-41fb-9af0-3a460e7e3354"],

Cell["\<\
(* Supplementary Tables 3 and 4 - Q1 quadrant SomaScan differential abundance \
(Fig. 2D, 2E) and pathway enrichment.
   Groups are the marginals of the Fig. 2B quadrants: right vs left on the \
protein PC1 (Supp Table 3), top vs bottom on the lipid PC1 (Supp Table 4).
   Per reagent: two-sample Kolmogorov-Smirnov test across the 7,007 annotated \
SOMAmer reagents (X17802.4 has no gene annotation),
   with Benjamini-Hochberg q across reagents. 3A lists reagents at BH q < \
0.05; 4A lists reagents at uncorrected p < 10^-3 (only 3 pass BH).
   3B/4B: BioPlanet 2019 enrichment against the SomaScan panel background \
(Enrichr background mode reproduced locally by uhEnrich;
   requires the screen-and-enrichment helper cell). *)
st34Keys = Select[Keys[SomascanLookup], With[{g = # /. SomascanLookup}, \
StringQ[g] && g =!= # && StringTrim[g] =!= \"\"] &];
Print[\"reagents tested: \", Length[st34Keys]];
DiceConfig[{\"Cog\" -> \"Q1\", \"Omics\" -> \"PL\"}, {\"Q1\", \"1\", \"2\"}];
st34Grp = Association[(# -> GetQuery[{\"Dice\" -> #}, coreData]) & /@ {\"L\", \
\"R\", \"T\", \"B\"}];
Print[\"group n: \", Length /@ st34Grp];
st34Raw[col_, g_] := Select[ToExpression /@ (col /. st34Grp[g]), NumberQ[#] \
&& # > 0 &];
st34Row[col_, refG_, compG_] := Module[{d1 = st34Raw[col, refG], d2 = \
st34Raw[col, compG]},
   If[Length[d1] < 3 || Length[d2] < 3, Nothing,
    {col, col /. SomascanLookup, N@KolmogorovSmirnovTest[d1, d2], \
N@KolmogorovSmirnovTest[d1, d2, \"TestStatistic\"],
     N@Log2[Mean[d2]/Mean[d1]], N[Mean[Log2[d2]] - Mean[Log2[d1]]], \
Length[d1], Length[d2]}]];
st34Run[refG_, compG_, file_] := Module[{rows, ord, ps, m, q, out},
   rows = st34Row[#, refG, compG] & /@ st34Keys; m = Length[rows];
   ord = Ordering[rows[[All, 3]]]; ps = rows[[ord, 3]];
   q = Reverse[FoldList[Min, Reverse[MapIndexed[Min[1., #1 m/First[#2]] &, \
ps]]]];
   out = MapThread[Append, {rows[[ord]], q}];
   Export[FileNameJoin[{NotebookDirectory[], file}],
    Prepend[out, {\"SeqId\", \"Target\", \"KS_p\", \"KS_D\", \
\"log2_mean_ratio\", \"delta_mean_log2\", \"n_ref\", \"n_comp\", \"BH_q\"}], \
\"CSV\"];
   Print[file, \": \", m, \" reagents;  BH q < 0.05: \", Count[out, r_ /; \
r[[9]] < 0.05], \";  uncorrected p < 10^-3: \", Count[out, r_ /; r[[3]] < \
10^-3]];
   out];
st3 = st34Run[\"L\", \"R\", \"SuppTable3A_allSeqId.csv\"];
st4 = st34Run[\"B\", \"T\", \"SuppTable4A_allSeqId.csv\"];
st34Lib = uhEnrichSetup[\"BioPlanet_2019\"];
st34Enr[rows_, file_] := Module[{e = uhEnrich[st34Lib, uhGenes[rows[[All, \
1]]]]},
   Export[FileNameJoin[{NotebookDirectory[], file}], Prepend[e, {\"term\", \
\"overlap\", \"term size in background\", \"p\", \"BH adj p\"}], \"CSV\"];
   Print[file, \": \", Length[uhGenes[rows[[All, 1]]]], \" genes;  terms with \
BH adj p < 0.05: \", Count[e, r_ /; r[[5]] < 0.05]];
   e];
st3B = st34Enr[Select[st3, #[[9]] < 0.05 &], \"SuppTable3B.csv\"];
st4B = st34Enr[Select[st4, #[[3]] < 10^-3 &], \"SuppTable4B.csv\"];\
\>", "Input",ExpressionUUID->"c0c16e51-67fd-4552-a128-b6e43934a1e4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["APOE e4 trend across Q1-Q3", "Subsection",ExpressionUUID->"ba6baa9b-2aeb-4a44-8745-395d20a78c29"],

Cell["\<\
(* APOE e4 across Q1-Q3 (Results, cohort paragraph; Supp Table 6): \
Cochran-Armitage trend tests across the three lower quartiles,
   for carrier frequency (reported, p = 0.17), and for allele dosage and \
homozygosity. *)
caTrend[x_List, n_List, t_List : {1, 2, 3}] := Module[{p = Total[x]/Total[n], \
T, V},
   T = Total[t (x - n p)]; V = p (1 - p) (Total[n t^2] - Total[n \
t]^2/Total[n]); N[2 SurvivalFunction[NormalDistribution[], Abs[T]/Sqrt[V]]]];
apoeQ = Table[With[{g = Select[#[\"APOE4\"] & /@ GetQuery[{\"Cog\" -> q, \
\"Omics\" -> \"PL\"}, coreData], NumberQ]},
    {q, Length[g], Count[g, 0], Count[g, 1], Count[g, 2]}], {q, {\"Q1\", \"Q2\
\", \"Q3\"}}];
Print[TableForm[apoeQ, TableHeadings -> {None, {\"Quartile\", \"N\", \
\"e4=0\", \"e4=1\", \"e4=2\"}}]];
Print[\"carrier trend p = \", NumberForm[caTrend[apoeQ[[All, 4]] + \
apoeQ[[All, 5]], apoeQ[[All, 2]]], 2],
  \";  allele-dosage trend p = \", NumberForm[caTrend[apoeQ[[All, 4]] + 2 \
apoeQ[[All, 5]], 2 apoeQ[[All, 2]]], 2],
  \";  e4/e4 trend p = \", NumberForm[caTrend[apoeQ[[All, 5]], apoeQ[[All, \
2]]], 2]];\
\>", "Input",ExpressionUUID->"cc2c4e24-5b34-4066-b1e1-5285954c72aa"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Quadrant median differences cited in the Results", "Subsection",ExpressionUUID->"3d995ac7-859c-49e8-9da2-53e9db3ee53d"],

Cell["\<\
(* Quadrant median differences cited in the Results: median(BR) / median(TL) \
for the measures shown in Figs. 2C, 3B, 4B and Supp Fig. 3.
   Quadrants as in the figures (PC1 axes split at zero; Q2 LDHB / \
CER.D19.1.18.0 split at the Q2 medians). *)
qmRatio[cfg_, axes_, cog_, measure_] := Module[{tl, br},
   Quiet@DiceConfig[cfg, axes];
   tl = Select[measure /. GetQuery[{\"Cog\" -> cog, \"Dice\" -> \"TL\"}, \
coreData], NumberQ];
   br = Select[measure /. GetQuery[{\"Cog\" -> cog, \"Dice\" -> \"BR\"}, \
coreData], NumberQ];
   {cog, measure, Length[tl], Length[br], NumberForm[Median[br]/Median[tl], \
3], ToString[Round[100 (Median[br]/Median[tl] - 1)]] <> \"%\"}];
qmRows = {
   qmRatio[{\"Cog\" -> \"Q1\", \"Omics\" -> \"PL\"}, {\"Q1\", \"1\", \"2\"}, \
\"Q1\", \"TOTAL_WMH\"],
   qmRatio[{\"Cog\" -> \"Q3\", \"Omics\" -> \"PL\"}, {\"Q3\", \"3\", \"7\"}, \
\"Q3\", \"TAU\"],
   qmRatio[{\"Cog\" -> \"Q3\", \"Omics\" -> \"PL\"}, {\"Q3\", \"3\", \"7\"}, \
\"Q3\", \"HIP\"],
   qmRatio[{\"Cog\" -> \"Q3\", \"Omics\" -> \"PL\"}, {\"Q3\", \"4\", \"7\"}, \
\"Q3\", \"TAU\"],
   qmRatio[{\"Cog\" -> \"Q2\", \"Omics\" -> \"PL\"}, {\"LDHB\", \
\"CER.D19.1.18.0.\"}, \"Q2\", \"TAU\"]};
TableForm[qmRows, TableHeadings -> {{\"Fig 2C\", \"Fig 3B\", \"Fig 3B\", \
\"Supp Fig 3\", \"Fig 4B\"}, {\"quartile\", \"measure\", \"n TL\", \"n BR\", \
\"BR/TL\", \"difference\"}}]\
\>", "Input",ExpressionUUID->"18534e4e-fb22-4b5c-8bfd-5ef7d60643a2"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Main figure panels", "Section",ExpressionUUID->"802d1d24-4891-491a-ac6a-c6b2387afe7c"],

Cell[CellGroupData[{

Cell["\<\
Figure 1A - cholesterol load versus export flux (mass balance)\
\>", "Subsection",ExpressionUUID->"02967e65-9fd0-4e20-9aaa-a8ccc90eb560"],

Cell["\<\
Self-contained: values are the stage-specific mg/day figures from \
Supplementary Table 1. Exports Fig1A_MassBalance.png (300 dpi) and \
Fig1A_MassBalance.pdf to the notebook folder.\
\>", "Text",ExpressionUUID->"85333876-6b00-4d75-a46c-b61cc8491d63"],

Cell["\<\
(* Figure 1A - cholesterol load versus export flux across stages, as fold \
change from CN.
   Values in mg per day, from Supplementary Table 1 (Results, mass-balance \
paragraph):
   load = brain cholesterol content x whole-brain atrophy rate; export flux = \
24S-OHC route + lipoprotein route. *)
mbStages = {\"CN\", \"MCI\", \"AD\"};
mbLoad = {0.56, 0.89, 1.24};
mb24OHC = {6.14, 6.14, 4.29};
mbLipo = {2.30, 2.30, 1.15};
mbExport = {8.45, 8.45, 5.44};  (* Supplementary Table 1 totals, summed from \
unrounded route values; the rounded routes above sum to 8.44 *)
mbLoadF = mbLoad/First[mbLoad];
mbExpF = mbExport/First[mbExport];
mbCLoad = RGBColor[\"#B07A00\"]; mbCExp = RGBColor[\"#1F5FA8\"];
mbFmt[v_] := ToString[NumberForm[v, {3, 2}]];
mbPts[f_] := Transpose[{Range[3], f}];
mbFont = {FontFamily -> \"Helvetica\", FontSize -> 11, FontColor -> \
GrayLevel[0.15]};
fig1A = Graphics[{
    {GrayLevel[0.8], AbsoluteThickness[0.8], Line[{{0.7, 1}, {3.9, 1}}]},
    {mbCLoad, AbsoluteThickness[2.2], Line[mbPts[mbLoadF]]},
    {mbCExp, AbsoluteThickness[2.2], Line[mbPts[mbExpF]]},
    {White, AbsolutePointSize[11], Point[mbPts[mbLoadF]], \
Point[mbPts[mbExpF]]},
    {mbCLoad, AbsolutePointSize[8], Point[mbPts[mbLoadF]]},
    {mbCExp, AbsolutePointSize[8], Point[mbPts[mbExpF]]},
    Table[Text[Style[mbFmt[mbLoad[[i]]], FontSize -> 10, Sequence @@ mbFont], \
Offset[{0, 11}, {i, mbLoadF[[i]]}]], {i, 3}],
    Table[Text[Style[mbFmt[mbExport[[i]]], FontSize -> 10, Sequence @@ \
mbFont], Offset[{0, -12}, {i, mbExpF[[i]]}]], {i, 3}],
    Text[Style[\"Load\\n(\\[Times]\" <> ToString[NumberForm[mbLoadF[[3]], {2, \
1}]] <> \")\", Sequence @@ mbFont, Bold], Offset[{14, 0}, {3, mbLoadF[[3]]}], \
{-1, 0}],
    Text[Style[\"Export flux\\n(\\[Times]\" <> \
ToString[NumberForm[mbExpF[[3]], {3, 2}]] <> \")\", Sequence @@ mbFont, \
Bold], Offset[{14, 0}, {3, mbExpF[[3]]}], {-1, 0}],
    Text[Style[\"Labels, mg per day\", FontSize -> 9, FontColor -> \
GrayLevel[0.45], Sequence @@ mbFont], {0.85, 0.12}, {-1, 0}]
    },
   Frame -> {{True, False}, {True, False}},
   FrameStyle -> Directive[GrayLevel[0.35], AbsoluteThickness[0.8]],
   FrameTicks -> {{Table[{y, ToString[NumberForm[y, {2, 1}]]}, {y, 0, 2.5, \
0.5}], None}, {Table[{i, mbStages[[i]]}, {i, 3}], None}},
   FrameTicksStyle -> Directive[Sequence @@ mbFont],
   FrameLabel -> {{Style[\"Fold change from CN\", FontSize -> 12, Sequence @@ \
mbFont], None}, {None, None}},
   PlotRange -> {{0.7, 3.95}, {0, 2.5}}, AspectRatio -> 0.85, ImageSize -> 380,
   PlotRangePadding -> {{0, 0}, {0, 0.05}}, ImagePadding -> {{55, 10}, {30, \
10}}];
Export[FileNameJoin[{$dir, \"Fig1A_MassBalance.png\"}], fig1A, \
ImageResolution -> 300];
Export[FileNameJoin[{$dir, \"Fig1A_MassBalance.pdf\"}], fig1A];
fig1A\
\>", "Input",ExpressionUUID->"de258b4b-6d08-4d93-9034-070fb261b9f3"]
}, Open  ]]
}, Open  ]]
}, Open  ]]
},
