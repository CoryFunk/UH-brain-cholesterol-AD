Cell[CellGroupData[{

Cell["\<\
Figure 5B - Revised (CSF total tau, single legend, trend lines)\
\>", "Subsection",ExpressionUUID->"a724447d-953f-4bfa-8c1b-47db61c4e58b"],

Cell[CellGroupData[{

Cell["\<\
Same treatment as revised 3E, on the 3x2 grid. Was passing SomascanLookup, so \
the legend read TAU. p-values PLA2G7 against LDHB 9.3e-5, TNR 2.6e-5, ALDOA \
4.5e-4; LPCAT2 0.00275, 6.0e-5, 0.00410.\
\>", "Item",ExpressionUUID->"e52e3359-ddfb-4bd7-a17e-8b6f5f188635"],

Cell["\<\
thisData = GetQuery[{\"Cog\" -> \"Q2\", \"Omics\" -> \"PL\"}, coreData];
cols = {\"PLA2G7\", \"LPCAT2\"} /. SomascanRevLookup;
rows = {\"LDHB\", \"TNR\" /. SomascanRevLookup, \"ALDOA\"};
pad = {{62, 3}, {45, 10}}; imw = 302;
Legended[
 Grid[Table[
   UHpanel[{col, row}, \"TAU\", thisData, \"ADAS13 Quartile 2\", brainLabels,
    pad, imw], {row, rows}, {col, cols}], Spacings -> {0, 0}],
 UHlegOf[PubScatter[{Last[cols], Last[rows]}, \"TAU\", thisData,
   {Cyan, Darker[Blue]}, <||>, Automatic, \"ADAS13 Quartile 2\", \
brainLabels]]]\
\>", "Input",ExpressionUUID->"7dc68ecc-ff21-4d09-b298-4f389707d380"]
}, Open  ]]
}, Open  ]]
}, Closed]]
}, Open  ]],

