Cell[CellGroupData[{

Cell["Figure 4B - Revised (annotated, CSF total tau)", "Subsection",ExpressionUUID->"ccd86fb4-9b1a-408e-af0d-047e52ed9cd0"],

Cell[CellGroupData[{

Cell["\<\
Four quadrants, HIP and CSF total tau, normalised to Median[TL], range 0-5 \
(was 0-6). Bracket spans TL to BR only. Cohort-composition line is generated: \
HIP 23,29 and TAU 24,29. The published slide reads 21,25 and 23,25 -- but the \
p-values reproduce to three significant figures (0.0478 displayed as 0.047, \
and 2.4e-6 exactly), so quadrant membership is almost certainly identical and \
the slide's n text is stale hand-typed Keynote text. Worth settling before \
submission.\
\>", "Item",ExpressionUUID->"c8c431e9-eb7b-4efc-92ac-67428b37748f"],

Cell["\<\
DiceConfig[{\"Cog\" -> \"Q2\", \"Omics\" -> \"PL\"},
  {\"LDHB\", \"CER.D19.1.18.0.\"}];
showKspQ = False;
cc4b = Quiet[CohortComp[KeyTake[quadColorExp, {\"TL\", \"TR\", \"BR\", \
\"BL\"}],
   GetQuery[{\"Cog\" -> \"Q2\"}, coreData],
   <|\"norm\" -> \"TL\", \"ref\" -> \"TL\", \"comp\" -> \"BR\",
     \"prefix\" -> \"ADAS13 Q2 Markers:  LDHB / CER.D19.1.18.0.\"|>,
   {\"HIP\", \"TAU\"}, 1, False, brainLabels, {0, 5}, True, False, {\"HIP\"}]];
cc4b = Join[cc4b, <|\"normRef\" -> \"TL\", \"showN\" -> True|>];
UHchart[cc4b, {\"TL\", \"TR\", \"BR\", \"BL\"}, brainLabels, {0, 5},
  \"ADAS13 Q2 Markers:  LDHB / CER.D19.1.18.0.\",
  {{\"TL\", \"BR\"}}, {\"TL\", \"BR\"}, 0.375, 1.0, <|\"HIP_1\" -> 4|>]\
\>", "Input",ExpressionUUID->"c04be2b4-5701-4d6e-a5eb-5976b1fd9da8"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Figure 4C - Revised (CSF total tau, single legend, trend lines)\
\>", "Subsection",ExpressionUUID->"178c8bad-931e-4965-981c-012386549ba0"],

Cell[CellGroupData[{

Cell["\<\
Same treatment as revised 3E. p-values 0.00457, 0.00187, 0.00461. 62pt left \
pad; frames measured at 991/988/987px. Row wrapped this figure into 1-over-2 \
before the change, because the CER.D19.1.18.0. axis labels make the panels \
wider.\
\>", "Item",ExpressionUUID->"527f8df4-7996-4ff8-9d69-e08340a8564e"],

Cell["\<\
thisData = GetQuery[{\"Cog\" -> \"Q2\", \"Omics\" -> \"PL\"}, coreData];
thesePairs = {\"CER.D19.1.18.0.\", #} & /@ {\"LDHB\", \"ALDOA\", \"KPYM\"};
pad = {{62, 3}, {45, 10}}; imw = 302;
Legended[
 Grid[{UHpanel[#, \"TAU\", thisData, \"ADAS13 Quartile 2\", brainLabels, pad,
      imw] & /@ thesePairs}, Spacings -> {0, 0},
   Alignment -> {Center, Center}],
 UHlegOf[PubScatter[Last[thesePairs], \"TAU\", thisData, {Cyan, \
Darker[Blue]},
    <||>, Automatic, \"ADAS13 Quartile 2\", brainLabels]]]\
\>", "Input",ExpressionUUID->"0549eb9b-255c-43fc-a3cf-e266c84620a5"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Figure 4D - Revised (reagent level, p < 0.003 in Q2)", "Subsection",ExpressionUUID->"367f67b7-b9f6-4446-8571-38081db29fbe"],

Cell["\<\
Supersedes the original Figure 4D cell above. Exports Fig4D.png (300 dpi) and \
Fig4D.pdf to the notebook folder.\
\>", "Text",ExpressionUUID->"2baa90dd-b447-4770-90f1-8e4749bfab1c"],

Cell["\<\
(* Figure 4D - reagent level. Each SOMAmer reagent is keyed by its SeqId and \
labelled by gene,
   so reagents that share a gene symbol are no longer merged (the original \
cell above keyed
   p-values by gene label, which let one reagent overwrite another). Q2 \
threshold p < 0.003,
   the screen threshold of Supplementary Table 5A. fig4dP is reused by the \
Supplementary
   Table 5 cell. *)
fig4dQs = {\"Q1\", \"Q2\", \"Q3\", \"Q4\"};
fig4dData = AssociationMap[GetQuery[{\"Cog\" -> #}, coreData] &, fig4dQs];
fig4dP = Association@Table[
    seq -> Association@Table[
       With[{pd = Select[{\"CER.D19.1.18.0.\", seq} /. fig4dData[q], And @@ \
Map[NumberQ, #] &]},
        q -> If[Length[pd] >= 10, Append[CCPraw[pd], \"n\" -> Length[pd]], <|\
\"cc\" -> 0., \"pval\" -> 1., \"n\" -> Length[pd]|>]],
       {q, fig4dQs}],
    {seq, Keys[SomascanLookup]}];
fig4dHits = SortBy[Select[Keys[fig4dP], fig4dP[#][\"Q2\"][\"pval\"] < 0.003 \
&], fig4dP[#][\"Q2\"][\"pval\"] &];
Print[Length[fig4dHits], \" reagents with p < 0.003 in Q2; Q2 n = \", \
MinMax[fig4dP[#][\"Q2\"][\"n\"] & /@ fig4dHits]];
fig4D = ListPlot[
   Table[Transpose[{Range[4], -Log10[fig4dP[seq][#][\"pval\"]] & /@ \
fig4dQs}], {seq, fig4dHits}],
   Joined -> True, PlotMarkers -> Automatic, Frame -> True,
   PlotLegends -> LineLegend[Automatic, Style[#, Gray] & /@ (fig4dHits /. \
SomascanLookup), LegendLayout -> {\"Column\", 3}],
   PlotLabel -> Style[\"SomaScan/CER.D19.1.18.0. Correlations by \
Quartile\\nwith p < 0.003 in Q2\", FontSize -> 14, Bold],
   PlotRange -> {{1, 4}, {0, 5}}, FrameTicks -> {{Range[0, 5], None}, \
{Range[1, 4], None}},
   FrameLabel -> {\"Quartile\", \"\\[Minus]Log10[pval]\"}, ImageSize -> 720];
uhExport[fig4D, \"Fig4D\"];
fig4D\
\>", "Input",ExpressionUUID->"dce7fd24-d9e9-4efd-92ba-c476ea0f0827"]
}, Open  ]]
}, Closed]],

