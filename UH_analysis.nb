Cell["MakeDateObj", "Subsubsection",ExpressionUUID->"c1df885c-d843-46af-9396-5f7a8ded2007"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeDateObj", "[", "date_", "]"}], ":=", 
   RowBox[{"Which", "[", "\[IndentingNewLine]", "\t\t\t\t\t\t", 
    RowBox[{
     RowBox[{"DateObjectQ", "[", "date", "]"}], ",", "date", ",", 
     "\[IndentingNewLine]", "\t\t\t\t\t\t", 
     RowBox[{"StringContainsQ", "[", 
      RowBox[{"date", ",", "\"\</\>\""}], "]"}], ",", 
     RowBox[{"DateObject", "[", 
      RowBox[{
       RowBox[{"Map", "[", 
        RowBox[{"ToExpression", ",", 
         RowBox[{"StringSplit", "[", 
          RowBox[{"date", ",", "\"\</\>\""}], "]"}]}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"{", 
         RowBox[{"3", ",", "1", ",", "2"}], "}"}], "]"}], "]"}], "]"}], ",", 
     " ", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"MM", "/", "DD"}], "/", "YYYY"}], " ", "*)"}], 
     "\[IndentingNewLine]", "\t\t\t\t\t\t", "True", ",", 
     RowBox[{"DateObject", "[", 
      RowBox[{"Map", "[", 
       RowBox[{"ToExpression", ",", 
        RowBox[{"StringSplit", "[", 
         RowBox[{"date", ",", "\"\<-\>\""}], "]"}]}], "]"}], "]"}]}], "  ", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{"YYYY", "/", "MM"}], "/", "DD"}], " ", "*)"}], 
    "\[IndentingNewLine]", "\t\t\t\t\t\t", "]"}]}], ";"}]], "Input",
 CellLabel->"In[47]:=",ExpressionUUID->"32656b3f-860f-436a-8c91-a2fa5b88b794"]
}, Closed]],

