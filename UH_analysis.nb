         RowBox[{
          RowBox[{"{", "baseQuery", "}"}], ",", 
          RowBox[{"Values", "[", "pair", "]"}]}], "]"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\t", 
     RowBox[{"theseData", "=", 
      RowBox[{"GetQuery", "[", 
       RowBox[{"totalQuery", ",", "coreData"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\t", 
     RowBox[{"thisEdge", "=", 
      RowBox[{
       RowBox[{"UndirectedEdge", "@@", 
        RowBox[{"Keys", "[", "pair", "]"}]}], "/.", "SomascanLookup"}]}], ";",
      "\[IndentingNewLine]", "\t", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"Equal", "@@", 
         RowBox[{"Keys", "[", "pair", "]"}]}]}], ",", "\[IndentingNewLine]", 
       "\t\t", 
       RowBox[{
        RowBox[{"thisCCP", "=", 
         RowBox[{"CCPraw", "[", 
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Keys", "[", "pair", "]"}], "/.", "theseData"}], ",", 
            RowBox[{
             RowBox[{"And", "@@", 
              RowBox[{"Map", "[", 
               RowBox[{"NumberQ", ",", "#"}], "]"}]}], "&"}]}], "]"}], 
          "]"}]}], ";", "\[IndentingNewLine]", "\t\t", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"thisCCP", "[", "\"\<pval\>\"", "]"}], "<", "thisThresh"}],
           ",", "\[IndentingNewLine]", "\t\t\t", 
