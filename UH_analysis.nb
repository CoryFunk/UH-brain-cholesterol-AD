Cell[CellGroupData[{

Cell[TextData[StyleBox["InitLoop, Loop", "Subsubsection"]], "Subsubsection",ExpressionUUID->"4f595a70-43eb-48f5-b858-9dcae38ca0c9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"InitLoop", "[", 
    RowBox[{"n_", ",", "mod_"}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "\t", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "\t", "}"}], ",", 
     "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{"loopFirstQ", "=", "True"}], ";", "\[IndentingNewLine]", "\t", 
      RowBox[{"loopStart", "=", 
       RowBox[{"AbsoluteTime", "[", "]"}]}], ";", "\[IndentingNewLine]", "\t", 
      RowBox[{"loopN", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"ListQ", "[", "n", "]"}], ",", 
         RowBox[{"Length", "[", "n", "]"}], ",", "n"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"loopMod", "=", "mod"}], ";", "\[IndentingNewLine]", "\t", 
      RowBox[{"loopCount", "=", "0"}], ";"}]}], "\[IndentingNewLine]", "\t", 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Loop", "[", "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "\t", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "\t", 
      RowBox[{"timeRemaining", ",", "timeUnits"}], "\[IndentingNewLine]", 
      "\t", "}"}], ",", "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
       "loopFirstQ", ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        "\t\t", 
        RowBox[{
         RowBox[{"loopFirstQ", "=", "False"}], ";", "\[IndentingNewLine]", 
         "\t\t", 
         RowBox[{"loopCount", "++"}]}], ",", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", "\t\t", 
        RowBox[{
         RowBox[{"loopCount", "++"}], ";", "\[IndentingNewLine]", "\t\t", 
         RowBox[{"timeRemaining", "=", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"loopN", "-", "loopCount"}], ")"}], 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"AbsoluteTime", "[", "]"}], "-", "loopStart"}], ")"}], 
             "/", "loopCount"}]}], ")"}]}], ";", "\[IndentingNewLine]", 
         "\t\t", 
         RowBox[{"timeUnits", "=", 
          RowBox[{"Which", "[", "\[IndentingNewLine]", "\t\t\t\t\t\t", 
           RowBox[{
            RowBox[{"timeRemaining", ">", "3600"}], ",", 
            RowBox[{
             RowBox[{"timeRemaining", "/=", "3600"}], ";", 
             "\"\< hours remaining\>\""}], ",", "\[IndentingNewLine]", 
            "\t\t\t\t\t\t", 
            RowBox[{"timeRemaining", ">", "60"}], ",", 
            RowBox[{
             RowBox[{"timeRemaining", "/=", "60"}], ";", 
             "\"\< minutes remaining\>\""}], ",", "\[IndentingNewLine]", 
            "\t\t\t\t\t\t", "True", ",", "\"\< seconds remaining\>\""}], 
           "\[IndentingNewLine]", "\t\t\t\t\t\t", "]"}]}], ";", 
         "\[IndentingNewLine]", "\t\t", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Mod", "[", 
             RowBox[{"loopCount", ",", "loopMod"}], "]"}], "==", "0"}], ",", 
           "\[IndentingNewLine]", "\t\t\t", 
           RowBox[{"PrintTemporary", "[", 
            RowBox[{
             RowBox[{"ToString", "[", "loopCount", "]"}], "<>", 
             "\"\< of \>\"", "<>", 
             RowBox[{"ToString", "[", "loopN", "]"}], "<>", "\"\< (\>\"", "<>", 
             RowBox[{"ToString", "[", 
              RowBox[{"Round", "[", 
               RowBox[{
                RowBox[{"100.", " ", 
                 RowBox[{"loopCount", "/", "loopN"}]}], ",", "0.1"}], "]"}], 
              "]"}], "<>", "\"\<%) \>\"", "<>", 
             RowBox[{"ToString", "[", 
              RowBox[{"Round", "[", 
               RowBox[{"timeRemaining", ",", "0.1"}], "]"}], "]"}], "<>", 
             "timeUnits"}], "]"}]}], "\[IndentingNewLine]", "\t\t\t", 
          "]"}]}]}], "\[IndentingNewLine]", "\t\t", "]"}], ";"}]}], 
    "\[IndentingNewLine]", "\t", "]"}]}], ";"}]}], "Input",
 CellLabel->"In[64]:=",ExpressionUUID->"c0a610c2-0a93-443f-8bb7-0755c9afd202"]
}, Closed]],

Cell[CellGroupData[{

Cell["CogRate", "Subsubsection",ExpressionUUID->"242c2b26-adf8-4cde-8d8b-11bf4b5ca02f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CogRate", "[", 
    RowBox[{"RID_", ",", "minPts_"}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{"cogTraj", ",", "trajPts", ",", "m", ",", "b", ",", "x"}], 
      "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"cogTraj", "=", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<EXAMDATE\>\"", ",", "\"\<ADAS13\>\""}], "}"}], "/.", 
        RowBox[{
         RowBox[{"Normal", "[", 
          RowBox[{"cohorts", "[", "\"\<ADNImerge\>\"", "]"}], "]"}], "[", 
         "RID", "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"trajPts", "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"DayCount", "[", 
               RowBox[{
                RowBox[{"cogTraj", "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "/", "365."}], ",", 
             
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "&"}], "/@", 
          "cogTraj"}], ",", 
         RowBox[{
          RowBox[{"And", "@@", 
           RowBox[{"Map", "[", 
            RowBox[{"NumberQ", ",", "#"}], "]"}]}], "&"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "trajPts", "]"}], ">=", "minPts"}], ",", 
        "\[IndentingNewLine]", "\t", 
        RowBox[{"m", "/.", 
         RowBox[{"FindFit", "[", 
          RowBox[{"trajPts", ",", 
           RowBox[{
            RowBox[{"m", " ", "x"}], "+", "b"}], ",", 
           RowBox[{"{", 
            RowBox[{"m", ",", "b"}], "}"}], ",", "x"}], "]"}]}], ",", 
        "\[IndentingNewLine]", "\t", "\"\<\>\""}], "\[IndentingNewLine]", 
       "\t", "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellLabel->"In[66]:=",ExpressionUUID->"8923ec5a-4fe6-4b96-9a29-13860be3fc9c"]
}, Closed]],

Cell[CellGroupData[{

Cell["meanOr", "Subsubsection",ExpressionUUID->"5b5e8d37-6f94-40e0-b87e-32ad185f88b5"],

Cell[CellGroupData[{

Cell["\<\
Mean of a numeric key over a record list, rounded to 0.01, or \"NA\" if the \
key is absent or non-numeric everywhere. Helper for the quadrant covariate \
tables.\
\>", "Item",ExpressionUUID->"be12fb07-f8f8-474e-aa0c-428d2c06911a"],

Cell["\<\
meanOr[data_, key_] := Module[{v = Select[#[key] & /@ data, NumberQ]},
   If[Length[v] > 0, Round[Mean[v], 0.01], \"NA\"]];\
\>", "Input",ExpressionUUID->"1f30e44e-d77d-439d-8ee8-2624c39db1c2"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["quadBreakdown", "Subsubsection",ExpressionUUID->"1b5ca8dc-d9ea-4433-827a-23912b7d5a01"],

Cell[CellGroupData[{

Cell["\<\
Per-quadrant covariate and APOE table for a cognitive quartile: N, epsilon-4 \
genotype counts, carrier %, % female, and mean age / TAU / ABETA. Supports \
the Figure 6 supplementary table (revision item #5). Calls DiceConfig itself, \
so it is safe against the order dependence documented above.\
\>", "Item",ExpressionUUID->"f5583034-dc9f-4725-a707-0141395a5aef"],

Cell["\<\
quadBreakdown[cogQ_, axes_] := Module[
   {quads = {\"TL\", \"TR\", \"BR\", \"BL\"}, d, a, sex},
   DiceConfig[{\"Cog\" -> cogQ, \"Omics\" -> \"PL\"}, axes];
   Dataset[Table[
      d   = GetQuery[{\"Cog\" -> cogQ, \"Dice\" -> quad}, coreData];
      a   = Select[#[\"APOE4\"] & /@ d, NumberQ];
      sex = Select[#[\"PTGENDER\"] & /@ d, StringQ];
      <|\"Quadrant\" -> quad,
        \"N\" -> Length[d],
        \"e4=0\" -> Count[a, 0], \"e4=1\" -> Count[a, 1], \"e4=2\" -> \
Count[a, 2],
        \"%carrier\" -> If[Length[a] > 0,
            Round[100 Count[a, x_ /; x > 0]/Length[a], 0.1], \"NA\"],
        \"%female\" -> If[Length[sex] > 0,
            Round[100 Count[sex, \"Female\"]/Length[sex], 0.1], \"NA\"],
        \"meanAge\"   -> meanOr[d, \"AGE\"],
        \"meanTAU\"   -> meanOr[d, \"TAU\"],
        \"meanABETA\" -> meanOr[d, \"ABETA\"]|>,
      {quad, quads}]]];\
\>", "Input",ExpressionUUID->"f912755a-007f-4f8e-bc73-0e8517da573b"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Revision Helpers (2026)", "Subsubsection",ExpressionUUID->"22052c94-ad09-46db-839f-5ba68c22e0af"],

Cell[CellGroupData[{

Cell["\<\
Everything the 2026 revision needs that is not in Tom's original Setup. \
Evaluate this subsubsection after Setup and before any Figure section. The \
DiceConfig patch is applied here rather than by editing Tom's definition, so \
his original stays readable and the change is explicit.\
\>", "Item",ExpressionUUID->"18849de1-2049-4b3d-bc2b-cbc285bcc3f5"],

Cell["\<\
(* DiceConfig order-dependence fix. Two token substitutions in
   the definition above: diceData was fetched with diceSpec[\"query\"], i.e. \
the
   PREVIOUS call's cohort, before diceSpec is overwritten -- which printed Q1's
   164 into Figure 3d while plotting Q3, and made the 2-axis branch take its
   median thresholds from the wrong cohort. The 2-axis branch also hard-coded
   \"ADNI ADAS13 Q2\" into the title. Quadrant membership in the 3-axis \
branch
   is unaffected (thresholds are pinned at 0): verified byte-identical before
   and after, TL 48 / TR 15 / BR 44 / BL 49 = 156. Idempotent.
   2026-09-28: third substitution, \" FPC\" -> \" PC1\", so the cluster-axis \
labels
   of Figs 2B, 3A and 3D read PC1, matching the manuscript and legends. *)
DownValues[DiceConfig] = DownValues[DiceConfig] /.
  {HoldPattern[diceSpec[\"query\"]] :> query,
   \"ADNI ADAS13 Q2 (\" :> StringJoin[\"ADNI ADAS13 \", (\"Cog\" /. query), \
\" (\"],
   \" FPC\" -> \" PC1\"};
(* checks: all must print True *)
Length[Position[DownValues[DiceConfig], HoldPattern[diceSpec[\"query\"]]]] \
=== 0
Length[Position[DownValues[DiceConfig], \" FPC\"]] === 0
(DiceConfig[{\"Cog\" -> \"Q1\", \"Omics\" -> \"PL\"}, {\"Q1\", \"1\", \
\"2\"}];
 DiceConfig[{\"Cog\" -> \"Q3\", \"Omics\" -> \"PL\"}, {\"Q3\", \"4\", \
\"7\"}];
 Length[GetQuery[{\"Cog\" -> \"Q3\", \"Omics\" -> \"PL\"}, coreData]] === 156)

(* Figure export helper: PDF + 300 dpi PNG to the notebook folder root,
   named by figure, overwriting. *)
uhExport[g_, tag_] := Module[{base = FileNameJoin[{NotebookDirectory[], tag}]},
  Export[base <> \".pdf\", g]; Export[base <> \".png\", g, ImageResolution -> \
300]; g];\
\>", "Input",ExpressionUUID->"d71ab876-b8ce-4efb-b13c-63c0b0d0d9e3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
brainLabels / brainLabelsNL. Display-label lookups. TAU is CSF total tau in \
pg/mL, NOT tau PET: verified in the kernel, n = 1,203 across Q1-Q4, range \
81.54-851.8, median 258.6, and every value above 2.5, so none is compatible \
with a PET standardized uptake value ratio. The NL variant wraps two long \
labels so they do not collide at publication type sizes.\
\>", "Item",ExpressionUUID->"a62b1ae7-93f8-4810-88c1-ec122399c064"],

Cell["\<\
(* Single source of truth for chart labels. TAU is CSF total tau in pg/mL, \
not a
   PET measure. 1433Z and KPYM are the coreData column names for two Emory
   targeted-MS proteins; the manuscript and the figure legends use the gene
   symbols YWHAZ and PKM, so the display alias belongs here rather than in each
   panel cell. Fig 3E and Fig 4C pick this up with no change to their own \
code. *)
brainLabels = Fold[Append, SomascanLookup,
   {\"HIP\" -> \"HIP Atrophy Rate\", \"TAU\" -> \"CSF Total Tau\",
    \"1433Z\" -> \"YWHAZ\", \"KPYM\" -> \"PKM\"}];
brainLabelsNL = Fold[Append, SomascanLookup,
   {\"HIP\" -> \"HIP\\nAtrophy Rate\", \"TAU\" -> \"CSF Total\\nTau\",
    \"1433Z\" -> \"YWHAZ\", \"KPYM\" -> \"PKM\"}];\
\>", "Input",ExpressionUUID->"1e1b44c6-afa9-4817-ba58-1dd3330fd98e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
UHsci formats a p-value the way the figures do: 4 significant decimals above \
1e-4, otherwise mantissa to one decimal plus E and the exponent.\
\>", "Item",ExpressionUUID->"0fcfb3dc-139d-4b8d-972a-63cc237e5476"],

Cell["\<\
UHsci[p_] := Module[{e, m},
   If[p >= 0.0001,
     Return[ToString[NumberForm[N[p],
       {10, Max[4, Ceiling[-Log10[p]] + 1]}, NumberPoint -> \".\"]]]];
   e = Floor[Log10[N[p]]]; m = Round[N[p]/10^e, 0.1];
   ToString[NumberForm[m, {3, 1}]] <> \"E\" <> ToString[e]];\
\>", "Input",ExpressionUUID->"116e1969-0ddd-42e8-8244-96263da00d35"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
UHclipY clips drawn ink to the plot range. Needed because PlotRangeClipping \
does not clip BoxWhiskerChart whisker primitives: one Q2 BL subject has a \
normalised HIP ratio of 22.73 (HIP is sign-flipped and divided by a TL median \
of 0.0124), so the whisker ran four times past the top of the frame. \
Quartiles and every statistic are untouched -- only where the ink stops \
changes.\
\>", "Item",ExpressionUUID->"bcb53af3-11a5-40f7-8c12-cd2ec0562177"],

Cell["\<\
UHclipY[g_, {lo_, hi_}] := g /.
   {(h : Line | Polygon)[a_] :>
      h[a /. {x_?NumericQ, y_?NumericQ} :> {x, Clip[y, {lo, hi}]}],
    Point[a_] :> Point[Select[
       If[MatchQ[a, {_?NumericQ, _?NumericQ}], {a}, a],
       lo <= #[[2]] <= hi &]]};\
\>", "Input",ExpressionUUID->"cf8803f4-6715-4f7c-88e2-296ce593d200"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
UHsizes is the single place all seven text sizes are set, in reference units \
for a 1600pt-wide panel. UHchart multiplies both the width and every font by \
sc, so a panel can be built at its final physical size without the type \
changing appearance. Forking this association is what caused several rounds \
of mismatched panels.\
\>", "Item",ExpressionUUID->"7b135c27-3466-4ce2-9f50-f5a869e09a14"],

Cell["\<\
UHrefW = 1600;
UHsizes = <|\"title\" -> 60, \"axis\" -> 51, \"tick\" -> 45, \"name\" -> 39,
            \"n\" -> 48, \"pval\" -> 45, \"legend\" -> 52|>;\
\>", "Input",ExpressionUUID->"d87eacb5-6329-4544-a391-5ff6b79b2440"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
UHchart builds the annotated box-whisker panels: p-value brackets computed \
from a LIST of quadrant comparisons (so a panel can carry more than the \
single ref/comp pair CohortComp returns), an optional cohort-composition line \
coloured by quadrant, and optional purple sublabels that may span several \
columns. Expects cc to carry \"normRef\" and \"showN\", which CohortComp does \
not report -- append them at the call site.\
\>", "Item",ExpressionUUID->"a84c30a9-730e-4937-81d5-28b76f51d063"],

Cell["\<\
UHchart[cc_, cohortsUse_, lookup_, range_, title_, comps_,
         nPair_ : Automatic, sc_ : 0.375, ar_ : 1.0, yAt_ : <||>,
         subSpec_ : {}] :=
 Module[{s, imgW, cols, plotData, base, spans, groups, allY, tops, epi, pad,
         labels, nOf, ctrOf, np, stridePts, xSpan, purpleFor},
  s = Round[sc #] & /@ UHsizes;
  imgW = Round[sc UHrefW];
  cols = Keys[cc[\"data\"]];
  np = If[nPair === Automatic, First[comps], nPair];
  plotData = Table[Association[Table[
      Style[k, LightGray, s[\"name\"]] -> Select[cc[\"data\"][col][k], \
NumberQ],
      {k, cohortsUse}]], {col, cols}];
  base = {plotData, {{\"Whiskers\", LightGray}, {\"Fences\", 0.5, \
LightGray}},
    BarSpacing -> {0.1, 0.75}, PlotRange -> range};
  spans = SortBy[Cases[BoxWhiskerChart @@ base,
     Polygon[p_] :> {Min[p[[All, 1]]], Max[p[[All, 1]]]}, Infinity], First];
  groups = Partition[spans, Length[cohortsUse]];
  allY = Cases[BoxWhiskerChart @@ base,
    {x_?NumericQ, y_?NumericQ} :> {x, y}, Infinity];
  tops = Table[Module[{ys = Cases[allY,
       {x_, y_} /; Min[g[[All, 1]]] - 0.05 <= x <= Max[g[[All, 2]]] + 0.05 :> \
y]},
     If[ys === {}, 1., Min[Max[ys], range[[2]]]]], {g, groups}];
  pad = 0.02 (range[[2]] - range[[1]]);
  ctrOf[i_, q_] := Mean[groups[[i, First[Flatten[Position[cohortsUse, \
q]]]]]];
  epi = Flatten@Table[
    Module[{cmps = If[Depth[comps] == 3, comps, comps[[i]]]},
     Table[Module[{q1 = cmps[[j, 1]], q2 = cmps[[j, 2]], a, b, p, y, xa, xb},
        a = Select[cc[\"data\"][cols[[i]]][q1], NumberQ];
        b = Select[cc[\"data\"][cols[[i]]][q2], NumberQ];
        p = Quiet@KolmogorovSmirnovTest[a, b];
        y = Lookup[yAt, cols[[i]] <> \"_\" <> ToString[j],
              Min[tops[[i]] + (3.2 + 5.0 (j - 1)) pad, range[[2]] - 3.2 \
pad]];
        xa = ctrOf[i, q1]; xb = ctrOf[i, q2];
        {Black, AbsoluteThickness[1.1], Line[{{xa, y}, {xb, y}}],
         Text[Style[If[p < 0.05, \"* \", \"\"] <> UHsci[p], Italic, Bold,
                    s[\"pval\"]], {Mean[{xa, xb}], y + 2.0 pad}]}],
      {j, Length[cmps]}]],
    {i, Length[cols]}];
  xSpan = Max[#[[2]] & /@ Flatten[groups, 1]] -
          Min[#[[1]] & /@ Flatten[groups, 1]];
  stridePts = If[Length[cols] > 1,
    (Mean[Flatten[groups[[2]]]] - Mean[Flatten[groups[[1]]]])/xSpan (0.86 \
imgW),
    0];
  purpleFor[col_] := Module[{sp, k},
    sp = SelectFirst[subSpec, First[#][[1]] === col &, None];
    If[sp === None, Return[Nothing]];
    k = Length[sp[[1]]];
    Row[{Spacer[(k - 1) stridePts],
      Column[DeleteCases[{
         Style[sp[[2]], Italic, s[\"n\"], RGBColor[0.45, 0.11, 0.53]],
         If[sp[[3]] === \"\", Nothing,
          Style[sp[[3]], Italic, s[\"n\"], RGBColor[0.45, 0.11, 0.53]]]},
        Nothing], Alignment -> Center, Spacings -> 0.7]}]];
  nOf[col_, k_] := Length[Select[cc[\"data\"][col][k], NumberQ]];
  labels = Table[Module[{nm = ToString[cols[[i]] /. lookup], pp},
     pp = purpleFor[cols[[i]]];
     Column[DeleteCases[{Style[nm, Bold, s[\"name\"]],
       If[cc[\"showN\"] === False, Nothing,
        Row[{Style[\"n=\", Italic, s[\"n\"], Gray],
             Style[ToString[nOf[cols[[i]], np[[1]]]], Italic, s[\"n\"],
                   np[[1]] /. quadColorExp],
             Style[\",\", Italic, s[\"n\"], Gray],
             Style[ToString[nOf[cols[[i]], np[[2]]]], Italic, s[\"n\"],
                   np[[2]] /. quadColorExp]}]],
       pp}, Nothing], Alignment -> Center, Spacings -> 1.2]],
   {i, Length[cols]}];
  UHclipY[
   BoxWhiskerChart[plotData,
    {{\"Whiskers\", LightGray}, {\"Fences\", 0.5, LightGray}},
    ChartLabels -> {labels, Automatic},
    ChartStyle -> (cohortsUse /. quadColorExp),
    ChartLegends -> Placed[
      SwatchLegend[cohortsUse /. quadColorExp, cohortsUse,
        LabelStyle -> Directive[FontSize -> s[\"legend\"]],
        LegendMarkerSize -> s[\"legend\"],
        LegendMargins -> {{Round[60 sc], Round[10 sc]}, {0, 0}}], Right],
    BarSpacing -> {0.1, 0.75},
    PlotRange -> range,
    PlotRangePadding -> {{Scaled[0.02], Scaled[0.04]}, {0, 0}},
    PlotRangeClipping -> True,
    Ticks -> {None, Table[{y, Style[y, s[\"tick\"]]},
                          {y, range[[1]], range[[2]], 1}]},
    GridLines -> {None, {1.0}}, GridLinesStyle -> Directive[Dashed, Gray],
    FrameLabel -> {None,
      Style[\"Data Normalized to Median[\" <> cc[\"normRef\"] <> \"]\", \
s[\"axis\"]]},
    PlotLabel -> Style[title, FontSize -> s[\"title\"], Bold],
    BaseStyle -> {FontSize -> s[\"tick\"]},
    ImageSize -> {imgW, Automatic}, AspectRatio -> ar,
    Epilog -> epi],
   range]];\
\>", "Input",ExpressionUUID->"398a95ef-ad1c-49bc-8bc2-b65b782a5729"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
fig1bNumbers prints every count that appears in published panel 1b. That \
panel is drawn in Keynote, so these are transcription values, not plot \
inputs. 602 / 362 / 601 / 7,008 / 509 all verify; 781 does not (justLipids is \
778) and is an open question for Tom.\
\>", "Item",ExpressionUUID->"d9473ef0-383b-4c5a-b9ae-a4c89efdc825"],

Cell["\<\
fig1bNumbers[] := Module[{pl, byQ},
   pl = GetQuery[{\"Omics\" -> \"PL\"}, coreData];
   byQ = Association[# -> Length[GetQuery[{\"Cog\" -> #, \"Omics\" -> \
\"PL\"},
                                          coreData]] & /@
                     {\"Q1\", \"Q2\", \"Q3\", \"Q4\"}];
   Dataset[{
     <|\"item\" -> \"participants, paired plasma lipidomics + CSF MS \
proteomics\",
       \"n\" -> Length[pl]|>,
     <|\"item\" -> \"  ...assigned to an ADAS13 quartile\",
       \"n\" -> Total[Values[byQ]]|>,
     <|\"item\" -> \"  ...no baseline ADAS13, so no quartile\",
       \"n\" -> Length[pl] - Total[Values[byQ]]|>,
     <|\"item\" -> \"plasma lipid species\", \"n\" -> Length[justLipids]|>,
     <|\"item\" -> \"CSF MS protein measurements\", \"n\" -> \
Length[justProteins]|>,
     <|\"item\" -> \"also CSF SomaScan\",
       \"n\" -> Length[GetQuery[{\"Omics\" -> \"PL\", \"SOMA\" -> \"Yes\"}, \
coreData]]|>,
     <|\"item\" -> \"SomaScan panel, SOMAmer reagents\",
       \"n\" -> Length[SomascanLookup]|>,
     <|\"item\" -> \"also Nightingale NMR\",
       \"n\" -> Length[GetQuery[{\"Omics\" -> \"PL\", \"Night\" -> \"N1\"}, \
coreData]]|>,
     <|\"item\" -> \"Nightingale biomarkers (NMRkeys1 + NMRkeys2)\",
       \"n\" -> Length[NMRkeys1] + Length[NMRkeys2]|>,
     Sequence @@ (<|\"item\" -> \"quartile \" <> #, \"n\" -> byQ[#]|> & /@ \
Keys[byQ])
   }]];\
\>", "Input",ExpressionUUID->"2bfd8cdb-b573-4fca-9dfe-d39b951d9668"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
quadRatio reproduces the percentages the Results quote. CohortComp's charts \
plot each quadrant median over the reference median, so the paper's \"% \
increase\" is 100(Median[comp]/Median[ref] - 1). Fig 3b: TAU +55.0% (paper \
55%), hippocampal atrophy +89.2% (paper says 92% -- the paper is wrong). Supp \
Fig 3: TAU +64.9% (paper 65%). Fig 4b: TAU +59.4% (paper 59%).\
\>", "Item",ExpressionUUID->"f5115fd7-eadc-4e63-8e97-bb122481b8d4"],

Cell["\<\
quadRatio[cogQ_, axes_, cols_List, ref_ : \"TL\", comp_ : \"BR\"] :=
 Module[{},
  DiceConfig[{\"Cog\" -> cogQ, \"Omics\" -> \"PL\"}, axes];
  Dataset[Table[Module[{a, b},
    a = Select[col /. GetQuery[{\"Cog\" -> cogQ, \"Omics\" -> \"PL\",
                                \"Dice\" -> ref}, coreData], NumberQ];
    b = Select[col /. GetQuery[{\"Cog\" -> cogQ, \"Omics\" -> \"PL\",
                                \"Dice\" -> comp}, coreData], NumberQ];
    <|\"metric\" -> col, \"n_\" <> ref -> Length[a], \"n_\" <> comp -> \
Length[b],
      \"median_\" <> ref -> N@Median[a], \"median_\" <> comp -> N@Median[b],
      \"pctIncrease\" -> Round[100 (N[Median[b]/Median[a]] - 1), 0.1],
      \"KS p\" -> Round[Quiet@KolmogorovSmirnovTest[a, b], 0.00001]|>],
   {col, cols}]]];\
\>", "Input",ExpressionUUID->"dc838ac1-6a68-442f-a5ca-5bd6189f8e9a"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Scatter Panel Helpers (2026)", "Subsubsection",ExpressionUUID->"abf2a78d-6d65-4419-82cf-0423e80a17ee"],

Cell[CellGroupData[{

Cell["\<\
Everything the revised PubScatter panels need. PubScatter computes a \
GeneralizedLinearModelFit trend line and a p-value inset but returns plot2, \
in which (*Show[plot,line]*) is commented out and the Epilog is absent -- so \
every panel it produces has been rendering without both. UHpanel reattaches \
them by replicating the same two expressions externally, so Tom's definition \
is unchanged. UHpanel also overrides ImagePadding and ImageSize: PubScatter \
uses a fixed 60pt left pad, and because y-tick label widths differ between \
panels (300 000 versus 2.5) each frame came out a different width. A uniform \
pad fixes the plot area regardless of label width.\
\>", "Item",ExpressionUUID->"ff8f7aaf-e901-4aff-99f0-8dd87dca345f"],

Cell["\<\
UHbare[g_] := If[Head[g] === Legended, First[g], g];
UHlegOf[g_] := If[Head[g] === Legended, Last[g], None];

UHpairData[pair_, legend_, data_] := Transpose[Drop[Transpose[
    Select[Append[pair, legend] /. data, And @@ Map[NumberQ, #] &]], -1]];

UHpvalStr[pair_, legend_, data_] :=
 Module[{p = CCPraw[UHpairData[pair, legend, data]][\"pval\"]},
  If[p > 0.0001, ToString[SetPrecision[p, 3]],
                 ToString[Format[SetPrecision[p, 3], CForm]]]];

UHtrend[pair_, legend_, data_] :=
 Module[{pd = UHpairData[pair, legend, data], fit, xx},
  fit = GeneralizedLinearModelFit[pd, {1, xx}, xx];
  Plot[Normal[fit], {xx, Min[pd[[All, 1]]], Max[pd[[All, 1]]]},
   PlotStyle -> Gray]];

UHpanel[pair_, legend_, data_, title_, lookup_, pad_, imw_] := Show[
  UHbare[PubScatter[pair, legend, data, {Cyan, Darker[Blue]}, <||>, \
Automatic,
     title, lookup]],
  UHtrend[pair, legend, data],
  Epilog -> {Inset[Style[\"pval \" <> UHpvalStr[pair, legend, data], Italic,
      Black, FontSize -> 12], Scaled@{0.95, 0.90}, {1, 0}]},
  ImagePadding -> pad, ImageSize -> imw, AspectRatio -> 1];\
\>", "Input",ExpressionUUID->"89680b71-3f25-45c5-9907-308e181f115b"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

